{# Human-authored template. The rendered output is generated. #}
# Generated by Medusa. Do not edit manually.
http:
  routers:
{% if traefik.routes %}
{% for route in traefik.routes %}
    {{ route.name }}:
      rule: {{ route.rule | tojson }}
      entryPoints:
{% for entrypoint in route.entrypoints %}
        - {{ entrypoint | tojson }}
{% endfor %}
      service: {{ route.name | tojson }}
{% if route.tls and route.cert_resolver %}
      tls:
        certResolver: {{ route.cert_resolver | tojson }}
        domains:
          - main: {{ route.cert_main | tojson }}
            sans:
{% for san in route.cert_sans %}
              - {{ san | tojson }}
{% endfor %}
{% elif route.tls %}
      tls: {}
{% endif %}
{% if route.middlewares %}
      middlewares:
{% for middleware in route.middlewares %}
        - {{ middleware | tojson }}
{% endfor %}
{% endif %}
{% endfor %}
{% else %}
    {}
{% endif %}
{% set redirects = traefik.routes | selectattr("redirect_host") | list %}
{% if redirects %}
  middlewares:
{% for route in redirects %}
    {{ route.middlewares[0] }}:
      redirectRegex:
        regex: "^https?://[^/]+/(.*)"
        replacement: {{ ("https://" ~ route.redirect_host ~ "/${1}") | tojson }}
        permanent: true
{% endfor %}
{% endif %}
  services:
{% if traefik.routes %}
{% for route in traefik.routes %}
    {{ route.name }}:
      loadBalancer:
        servers:
          - url: {{ route.target_url | tojson }}
{% endfor %}
{% else %}
    {}
{% endif %}
