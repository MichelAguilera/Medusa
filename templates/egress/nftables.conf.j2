#!/usr/sbin/nft -f
# Generated by Medusa. Do not edit manually.
# Fail-closed kill-switch: forwarded traffic may ONLY leave via the tunnel --
# with the interface down nothing matches the accept rules and the drop policy
# holds, so a tunnel failure cannot fall back to the clear path.

# add-then-delete keeps re-apply idempotent (delete alone fails on a fresh host).
add table inet medusa_egress
delete table inet medusa_egress

table inet medusa_egress {
    chain forward {
        type filter hook forward priority 0; policy drop;
        oifname "{{ egress.interface }}" accept
        iifname "{{ egress.interface }}" ct state established,related accept
    }

    chain postrouting {
        type nat hook postrouting priority srcnat;
        oifname "{{ egress.interface }}" masquerade
    }
}
