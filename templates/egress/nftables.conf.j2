#!/usr/sbin/nft -f
# Generated by Medusa. Do not edit manually.
# NAT + fail-closed kill-switch for the shared WireGuard egress gateway.
# Forwarded traffic may ONLY leave via the tunnel; if the interface is down,
# nothing matches the accept rules and the chain's drop policy blocks it, so a
# tunnel failure cannot fall back to the clear path. A dedicated table keeps
# this isolated from any other firewall ruleset on the host.

# add-then-delete makes re-applying idempotent (delete never fails on a fresh
# host because the table is created first).
add table inet medusa_egress
delete table inet medusa_egress

table inet medusa_egress {
    chain forward {
        type filter hook forward priority 0; policy drop;
        oifname "{{ egress.interface }}" accept
        iifname "{{ egress.interface }}" ct state established,related accept
    }

    chain postrouting {
        type nat hook postrouting priority srcnat;
        oifname "{{ egress.interface }}" masquerade
    }
}
