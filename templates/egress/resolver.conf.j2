# Generated by Medusa. Do not edit manually.
# Split DNS for tunneled clients: managed zones resolve via CoreDNS (local),
# everything else via the in-tunnel upstream so external lookups do not leak.
no-resolv
{% for zone in egress.zones %}
server=/{{ zone }}/{{ egress.coredns_address }}
{% endfor %}
server={{ egress.dns_upstream }}
listen-address={{ egress.gateway_address }}
listen-address=127.0.0.1
bind-interfaces
