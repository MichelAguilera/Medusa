#!/bin/sh
# Generated by Medusa. Do not edit manually.
# Split routing for marked tunnel traffic; idempotent, safe to re-run.
# Fail-closed: the tunnel table's ONLY route is the default via the gateway,
# so a downed gateway drops traffic instead of leaking it to the ISP.
# Marked LAN-bound traffic stays on the main table (direct, symmetric).
set -e

TABLE={{ egress.table }}
MARK={{ egress.fwmark }}
GATEWAY={{ egress.gateway_address }}
PRIO_LAN=1000
PRIO_TUN=1001

ip route replace default via "$GATEWAY" table "$TABLE"

# Delete until gone: ip rules stack, so a single del would leave duplicates.
while ip rule del priority "$PRIO_LAN" 2>/dev/null; do :; done
while ip rule del priority "$PRIO_TUN" 2>/dev/null; do :; done

{% for subnet in egress.lan_subnets %}
ip rule add priority "$PRIO_LAN" fwmark "$MARK" to {{ subnet }} lookup main
{% endfor %}
ip rule add priority "$PRIO_TUN" fwmark "$MARK" lookup "$TABLE"
