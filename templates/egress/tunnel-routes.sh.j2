#!/bin/sh
# Generated by Medusa. Do not edit manually.
# Policy routing for marked tunnel traffic. Idempotent: safe to re-run.
#
# Split routing for tunneled containers:
#   - marked traffic to a LAN subnet  -> main table (stays DIRECT, symmetric)
#   - all other marked traffic        -> tunnel table (default via the gateway)
# Fail-closed: the tunnel table's only route is the default via the gateway, so
# if the gateway/WireGuard path is down the traffic is dropped, never leaked to
# the ISP. LAN traffic never depends on the gateway.
set -e

TABLE={{ egress.table }}
MARK={{ egress.fwmark }}
GATEWAY={{ egress.gateway_address }}
PRIO_LAN=1000
PRIO_TUN=1001

# Tunnel table: send marked traffic out the gateway (only route -> fail-closed).
ip route replace default via "$GATEWAY" table "$TABLE"

# Rebuild our ip rules idempotently.
while ip rule del priority "$PRIO_LAN" 2>/dev/null; do :; done
while ip rule del priority "$PRIO_TUN" 2>/dev/null; do :; done

# Marked LAN-bound traffic stays on the main table (direct).
{% for subnet in egress.lan_subnets %}
ip rule add priority "$PRIO_LAN" fwmark "$MARK" to {{ subnet }} lookup main
{% endfor %}
# Everything else marked -> tunnel table.
ip rule add priority "$PRIO_TUN" fwmark "$MARK" lookup "$TABLE"
