#
# Stack -> host manifest (T-087). generated/compose/ holds every platform's
# stacks (compose is the platform-neutral container layer), so the Debian
# compose role uses this to deploy each host ONLY its own stacks; NixOS hosts'
# stacks are delivered through the flake instead.
{% if stacks %}
stacks:
{% for entry in stacks %}
  - stack: {{ entry.stack }}
    host: {{ entry.host }}
{% endfor %}
{% else %}
stacks: []
{% endif %}
