{# Human-authored template. The rendered output is generated. #}
# Generated by Medusa. Do not edit manually.
#
# The Debian compose role deploys each host ONLY its own stacks from this map;
# NixOS hosts get theirs through the flake instead (T-087).
{% if stacks %}
stacks:
{% for entry in stacks %}
  - stack: {{ entry.stack }}
    host: {{ entry.host }}
{% endfor %}
{% else %}
stacks: []
{% endif %}
