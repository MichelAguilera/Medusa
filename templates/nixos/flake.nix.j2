{# Human-authored template. The rendered output is generated. #}
{
  # Generated by Medusa. Do not edit manually.
  description = "Medusa-managed NixOS hosts";

  inputs = {
    nixpkgs.url = "{{ nixos.nixpkgs_ref }}";
    # disko -- declarative partitioning consumed by nixos-anywhere on first
    # install (T-078). Wired into a host's module list only when it opts in via
    # nixos_disko.
    disko.url = "github:nix-community/disko";
    disko.inputs.nixpkgs.follows = "nixpkgs";
  };

  outputs = { self, nixpkgs, disko, ... }:
    let
      system = "x86_64-linux";
    in
    {
      nixosConfigurations = {
{% for host in nixos.hosts %}
        {{ host.name }} = nixpkgs.lib.nixosSystem {
          inherit system;
          modules = [ ./hosts/{{ host.name }}.nix{% if host.disko_module %} disko.nixosModules.disko{% endif %} ];
        };
{% endfor %}
      };
    };
}
