{# Human-authored template. The rendered output is generated. #}
{
  # Generated by Medusa. Do not edit manually.
  description = "Medusa-managed NixOS hosts";

  inputs = {
    nixpkgs.url = "{{ nixos.nixpkgs_ref }}";
    # Consumed by nixos-anywhere on first install; wired into a host's module
    # list only when it opts in via nixos_disko (T-078).
    disko.url = "github:nix-community/disko";
    disko.inputs.nixpkgs.follows = "nixpkgs";
  };

  outputs = { self, nixpkgs, disko, ... }:
    let
      system = "x86_64-linux";
    in
    {
      nixosConfigurations = {
{% for host in nixos.hosts %}
        {{ host.name }} = nixpkgs.lib.nixosSystem {
          inherit system;
          modules = [ ./hosts/{{ host.name }}.nix{% if host.disko_module %} disko.nixosModules.disko{% endif %} ];
        };
{% endfor %}
      };
{% if nixos.installer_keys %}

      # Installer ISO for `medusactl build-installer` (T-089); a separate
      # output namespace, invisible to nixosConfigurations resolution.
      packages.${system}.installer =
        (nixpkgs.lib.nixosSystem {
          inherit system;
          modules = [ ./installer.nix ];
        }).config.system.build.isoImage;
{% endif %}
    };
}
