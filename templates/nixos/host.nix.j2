{# Human-authored template. The rendered output is generated. #}
{ ... }:
{
  # Generated by Medusa. Do not edit manually.
{% if host.disko_module %}
  # Operator-authored disko layout, staged into the flake tree by render. disko
  # owns the root/boot filesystems; nixos-anywhere runs it to WIPE + partition
  # the target disk on first install (T-078).
  imports = [ {{ host.disko_module }} ];
{% endif %}
  networking.hostName = "{{ host.hostname }}";
{% if host.boot_loader %}

  # UEFI boot via systemd-boot; the ESP is the disko-managed /boot partition.
  # Omitted for lxc guests, which boot from the host kernel (T-078).
  boot.loader.systemd-boot.enable = true;
  boot.loader.efi.canTouchEfiVariables = true;
{% endif %}

  services.openssh = {
    enable = true;
    settings.PasswordAuthentication = false;
  };
{% if host.admin_keys %}

  # Admin/deploy SSH access for `nixos-rebuild --target-host` (T-078). Public
  # keys -- not secret -- carried as plain inventory data.
{% if host.admin_user == "root" %}
  users.users.root.openssh.authorizedKeys.keys = [{% for key in host.admin_keys %} "{{ key }}"{% endfor %} ];
{% else %}
  users.users."{{ host.admin_user }}" = {
    isNormalUser = true;
    extraGroups = [ "wheel" ];
    openssh.authorizedKeys.keys = [{% for key in host.admin_keys %} "{{ key }}"{% endfor %} ];
  };
  # Passwordless sudo so `nixos-rebuild --use-remote-sudo` activates without a
  # prompt.
  security.sudo.wheelNeedsPassword = false;
{% endif %}
{% endif %}
{% if host.qemu_guest_agent %}

  # VM guest: let the Proxmox/KVM host read the guest IP and shut it down
  # gracefully. Not emitted for lxc/physical guests (T-078).
  services.qemuGuest.enable = true;
{% endif %}
{% if host.network %}

  systemd.network.enable = true;
  systemd.network.networks."10-{{ host.network.interface }}" = {
    matchConfig.Name = "{{ host.network.interface }}";
    address = [ "{{ host.network.address }}" ];
    routes = [ { routeConfig.Gateway = "{{ host.network.gateway }}"; } ];
    networkConfig.DNS = [{% for ns in host.network.nameservers %} "{{ ns }}"{% endfor %} ];
  };
{% endif %}
{% for fs in host.file_systems %}

  fileSystems."{{ fs.mountpoint }}" = {
    device = "{{ fs.device }}";
    fsType = "{{ fs.fs_type }}";
    options = [{% for opt in fs.options %} "{{ opt }}"{% endfor %} ];
  };
{% endfor %}
{% if host.containers %}

  virtualisation.oci-containers.backend = "{{ host.container_backend }}";
{% for container in host.containers %}
  virtualisation.oci-containers.containers."{{ container.name }}" = {
    image = "{{ container.image }}";
{% if container.ports %}
    ports = [{% for port in container.ports %} "{{ port }}"{% endfor %} ];
{% endif %}
{% if container.volumes %}
    volumes = [{% for volume in container.volumes %} "{{ volume }}"{% endfor %} ];
{% endif %}
{% if container.environment %}
    environment = {
{% for key, value in container.environment %}
      "{{ key }}" = "{{ value }}";
{% endfor %}
    };
{% endif %}
  };
{% endfor %}
{% endif %}
{% if host.secrets %}

  # Secrets delivered by sops-nix at activation (T-077). The host decrypts with
  # its own ssh host key (sops.age default); each materializes at
  # /run/secrets/<name>. References only -- never plaintext (Secrets ADR).
  sops.secrets = {
{% for secret in host.secrets %}
    "{{ secret.name }}" = {
      sopsFile = {{ secret.sops_file }};
      owner = "{{ secret.owner }}";
      mode = "{{ secret.mode }}";
    };
{% endfor %}
  };
{% endif %}
{% if host.sftp_users %}

  users.groups.sftp = { };
  # Root-owned chroot dirs (OpenSSH requires ChrootDirectory to be root-owned and
  # not writable by the chrooted user); the writable area is the storage bind
  # mounted beneath each one.
  systemd.tmpfiles.rules = [
{% for user in host.sftp_users %}
    "d {{ user.chroot }} 0755 root root -"
{% endfor %}
  ];
  services.openssh.extraConfig = ''
    Match Group sftp
      ChrootDirectory {{ host.sftp_chroot_root }}/%u
      ForceCommand internal-sftp
      AllowTcpForwarding no
      X11Forwarding no
  '';
{% for user in host.sftp_users %}
  users.users."{{ user.name }}" = {
    isNormalUser = true;
    group = "sftp";
    extraGroups = [ "sftp" ];
{% if user.uid is not none %}
    uid = {{ user.uid }};
{% endif %}
    home = "{{ user.home }}";
    openssh.authorizedKeys.keyFiles = [{% for key_file in user.key_files %} "{{ key_file }}"{% endfor %} ];
  };
{% endfor %}
{% endif %}

  # Install-time release; pinned for life -- never bump on upgrade (T-078).
  system.stateVersion = "{{ host.state_version }}";
}
