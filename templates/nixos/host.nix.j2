{# Human-authored template. The rendered output is generated. #}
{ modulesPath, pkgs, ... }:
{
  # Generated by Medusa. Do not edit manually.
{% if host.qemu_guest_agent or host.disko_module %}
  # Without the qemu-guest profile's virtio initrd modules, stage 1 cannot see
  # the VM's disk; the disko import WIPES + partitions on first install (T-078).
  imports = [{% if host.qemu_guest_agent %} (modulesPath + "/profiles/qemu-guest.nix"){% endif %}{% if host.disko_module %} {{ host.disko_module }}{% endif %} ];
{% endif %}
  networking.hostName = "{{ host.hostname }}";
{% if host.timezone %}
  # Must materialize /etc/localtime: compose services bind-mount it, and docker
  # auto-creates a missing bind source as a directory, breaking the mount.
  time.timeZone = "{{ host.timezone }}";
{% endif %}
{% if host.boot_loader %}
{% if host.boot_bios_device %}

  # No UEFI on this firmware: GRUB on the raw disk, and the disko layout
  # carries an EF02 BIOS-boot partition instead of an ESP (T-094).
  boot.loader.grub.enable = true;
  boot.loader.grub.devices = [ "{{ host.boot_bios_device }}" ];
{% else %}

  # Omitted for lxc guests, which boot from the host kernel (T-078).
  boot.loader.systemd-boot.enable = true;
  boot.loader.efi.canTouchEfiVariables = true;
{% endif %}
{% endif %}

  services.openssh = {
    enable = true;
    settings.PasswordAuthentication = false;
  };
{% if host.admin_keys %}

  # Public keys -- not secret -- for `nixos-rebuild --target-host` (T-078).
{% if host.admin_user == "root" %}
  users.users.root.openssh.authorizedKeys.keys = [{% for key in host.admin_keys %} "{{ key }}"{% endfor %} ];
{% else %}
  users.users."{{ host.admin_user }}" = {
    isNormalUser = true;
    extraGroups = [ "wheel" ];
    openssh.authorizedKeys.keys = [{% for key in host.admin_keys %} "{{ key }}"{% endfor %} ];
  };
  # nixos-rebuild's remote-sudo elevation cannot answer a prompt (T-095).
  security.sudo.wheelNeedsPassword = false;
  # Without nix trust the daemon refuses the unsigned store paths
  # `nixos-rebuild --target-host` copies in.
  nix.settings.trusted-users = [ "{{ host.admin_user }}" ];
{% endif %}
{% endif %}
{% if host.qemu_guest_agent %}

  # Graceful shutdown + guest-IP reporting; vm guests only (T-078).
  services.qemuGuest.enable = true;
  # Without sd_mod, stage 1 times out on a virtio-scsi root disk (Proxmox's
  # default controller); sr_mod covers the installer CDROM.
  boot.initrd.availableKernelModules = [ "sd_mod" "sr_mod" ];
{% endif %}
{% if host.network %}

  # networkd exclusively: without useNetworkd, dhcpcd runs beside networkd on
  # the same interface and can drop networking on a headless static-IP host.
  networking.useNetworkd = true;
  networking.useDHCP = false;
  systemd.network.enable = true;
  systemd.network.networks."10-{{ host.network.interface }}" = {
    matchConfig.Name = "{{ host.network.interface }}";
    address = [ "{{ host.network.address }}" ];
    routes = [ { Gateway = "{{ host.network.gateway }}"; } ];
    networkConfig.DNS = [{% for ns in host.network.nameservers %} "{{ ns }}"{% endfor %} ];
  };
{% endif %}
{% for fs in host.file_systems %}

  fileSystems."{{ fs.mountpoint }}" = {
    device = "{{ fs.device }}";
    fsType = "{{ fs.fs_type }}";
    options = [{% for opt in fs.options %} "{{ opt }}"{% endfor %} ];
  };
{% endfor %}
{% if host.stacks %}

  # ---- Compose-on-NixOS (T-087) ---------------------------------------------
  # The SAME generated stacks a Debian host runs; the docker daemon supervises
  # containers (restart policies) -- the units below only reconcile.
  virtualisation.docker.enable = true;
{% if host.insecure_registries %}
  # In-fleet plain-HTTP registries; same trust Debian carries in daemon.json.
  virtualisation.docker.daemon.settings."insecure-registries" = [{% for reg in host.insecure_registries %} "{{ reg }}"{% endfor %} ];
{% endif %}
{% if host.tunnel %}

  # ---- Tunnel-routing client (T-087/D6, the T-066 mechanism) ----------------
  # Fail-closed split routing for `egress: tunnel` containers: gateway down =
  # drop, never a leak out the main default route. The asymmetric return path
  # needs loose reverse-path filtering -- both in the firewall's own check and
  # the sysctls -- or marked flows are dropped (Debian role parity).
  networking.firewall.checkReversePath = "loose";
  boot.kernel.sysctl = {
    "net.ipv4.conf.all.rp_filter" = 2;
    "net.ipv4.conf.default.rp_filter" = 2;
  };
{% endif %}

  # medusa owns the stacks tree and runs compose (Debian-fleet parity);
  # docker-group membership grants the socket.
  users.groups.medusa = { };
  users.users.medusa = {
    isNormalUser = true;
    group = "medusa";
    extraGroups = [ "docker" ];
    home = "/home/medusa";
    # Traversable (not listable) by others: the default 700 walls the
    # world-readable stacks tree beneath off from the non-root admin user.
    homeMode = "751";
  };
{% endif %}
{% if host.egress_gateway %}

  # ---- Shared WireGuard egress gateway (T-066, wireguard_gateway port) ------
  # Reverse-path checking off: return traffic arrives on
  # {{ host.egress_gateway.interface }} while the main table routes those
  # sources via the LAN uplink (Debian rp_filter=0 parity, not a loosening).
  boot.kernel.sysctl."net.ipv4.ip_forward" = 1;
  networking.firewall.checkReversePath = false;
{% endif %}
{% if host.coredns %}

  # ---- CoreDNS (T-056 port) --------------------------------------------------
  # The LIVE resolver for the whole LAN; a bad config = generation rollback.
  # systemd-resolved's stub listener (127.0.0.53:53) collides with CoreDNS's
  # wildcard :53 bind -- this host IS the resolver, so resolved is disabled.
  services.resolved.enable = false;
{% endif %}
{% if host.nfs %}

  # ---- NFS export server (T-096) --------------------------------------------
  # nfsd on the same generated exports file the Debian role ships to
  # /etc/exports, staged byte-identical (the CoreDNS precedent).
{% if host.nfs.zfs_pool %}
  boot.supportedFilesystems = [ "zfs" ];
  # Datasets carry their own mountpoints; the pool is not a fileSystems entry.
  boot.zfs.extraPools = [ "{{ host.nfs.zfs_pool }}" ];
  # ZFS module requires it; must be stable -- a changed hostid forces
  # `zpool import -f` (derived from the host name in normalize, T-096).
  networking.hostId = "{{ host.nfs.host_id }}";
{% endif %}
  services.nfs.server.enable = true;
  services.nfs.server.exports = builtins.readFile ../storage/{{ host.name }}/medusa.exports;
{% endif %}
{% if host.egress_gateway or host.coredns or host.nfs %}

{% if host.egress_gateway or host.coredns %}
  # DNS service ports (the gateway's split resolver / the fleet resolver).
{% else %}
  # NFSv4 service port (single fixed TCP port; the fleet mounts vers=4 only).
{% endif %}
  networking.firewall.allowedTCPPorts = [{% if host.egress_gateway or host.coredns %} 53{% endif %}{% if host.nfs %} 2049{% endif %} ];
{% if host.egress_gateway or host.coredns %}
  networking.firewall.allowedUDPPorts = [ 53 ];
{% endif %}
{% endif %}
{% if host.stacks or host.staged_secrets or host.deploy_configs or host.coredns %}

  # Staged in-generation: the sync unit materializes these into the writable
  # Debian-identical tree at /home/medusa/medusa-stacks, so a rollback re-syncs
  # the previous generation's config.
  environment.etc = {
{% if host.coredns %}
    # The generated Corefile references /etc/coredns/lan.hosts verbatim.
    "coredns/lan.hosts".source = ../coredns/lan.hosts;
{% endif %}
{% for stack in host.stacks %}
    "medusa-stacks-src/{{ stack.name }}".source = ../stacks/{{ host.name }}/{{ stack.name }};
{% endfor %}
{% for staged in host.staged_secrets %}
    "medusa-secrets-enc/{{ staged.staged }}".source = ../secrets-enc/{{ staged.staged }};
{% endfor %}
{% for cfg in host.deploy_configs %}
    "medusa-deploy-src/{{ cfg.dest }}".source = ../deploy/{{ host.name }}/{{ cfg.dest }};
{% endfor %}
  };
{% endif %}
{% if host.stacks or host.sftp_users %}

{% if host.sftp_users %}
  # OpenSSH requires ChrootDirectory root-owned and not user-writable; the
  # writable area is the storage bind mounted beneath each one.
{% endif %}
  systemd.tmpfiles.rules = [
{% for user in host.sftp_users %}
    "d {{ user.chroot }} 0755 root root -"
{% endfor %}
{% if host.stacks %}
    # Plugin lookup for interactive `docker compose` only (T-083 parity); the
    # units below call the compose binary directly.
    "L+ /usr/local/lib/docker/cli-plugins/docker-compose - - - - ${pkgs.docker-compose}/bin/docker-compose"
{% for d in host.data_dirs %}
    # z repairs ownership when a stack unit raced ahead of tmpfiles and docker
    # created the bind source root-owned -- a d line alone never fixes that.
    # Non-recursive: the container owns what it writes beneath (T-065).
    "d /home/medusa/medusa-stacks/{{ d.path }} 0755 {{ d.owner }} {{ d.group }} -"
    "z /home/medusa/medusa-stacks/{{ d.path }} 0755 {{ d.owner }} {{ d.group }} -"
{% endfor %}
{% endif %}
  ];
{% endif %}
{% if host.stacks or host.staged_secrets or host.coredns or host.nfs %}

  systemd.services = {
{% if host.nfs %}
    # Dataset ensure + dir ownership convergence (T-071/T-085). Create is
    # Medusa's only ZFS verb (ADR fence); the guard refuses to mount a fresh
    # dataset over existing data (shadowing, T-096).
    medusa-nfs-provision = {
      description = "Provision Medusa NFS export datasets and directories";
      wantedBy = [ "multi-user.target" ];
{% if host.nfs.zfs_pool %}
      # Pool imported + datasets mounted before we look.
      after = [ "zfs.target" ];
      path = [ pkgs.zfs ];
{% endif %}
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
      };
      script = ''
        set -eu
{% for export in host.nfs.exports %}
{% if export.dataset %}
        if ! zfs list -H -o name '{{ export.dataset }}' >/dev/null 2>&1; then
          if [ -d '{{ export.path }}' ] && [ -n "$(ls -A '{{ export.path }}')" ]; then
            echo "refusing to create dataset {{ export.dataset }}: {{ export.path }} already holds data outside a dataset -- migrate it by hand first" >&2
            exit 1
          fi
          zfs create '{{ export.dataset }}'
        fi
{% endif %}
{% for dir in export.directories %}
        mkdir -p '{{ dir.path }}'
        chown {{ dir.owner }}:{{ dir.group }} '{{ dir.path }}'
        chmod {{ dir.mode }} '{{ dir.path }}'
{% endfor %}
{% endfor %}
      '';
    };

    # exportfs aborts its whole reload on any missing export path -- nfsd
    # must not start before provisioning.
    nfs-server = {
      after = [ "medusa-nfs-provision.service" ];
      requires = [ "medusa-nfs-provision.service" ];
    };

{% endif %}
{% if host.coredns %}
    # No Corefile restartTrigger needed: its interpolated store path changes
    # the unit on switch; lan.hosts is re-read live, hence its trigger.
    medusa-coredns = {
      description = "Medusa CoreDNS resolver";
      wantedBy = [ "multi-user.target" ];
      after = [ "network-online.target" ];
      wants = [ "network-online.target" ];
      restartTriggers = [ ../coredns/lan.hosts ];
      serviceConfig = {
        ExecStart = "${pkgs.coredns}/bin/coredns -conf ${../coredns/Corefile}";
        Restart = "on-failure";
        RestartSec = 2;
      };
    };

{% endif %}
{% if host.egress_gateway %}
    # wg-quick derives the interface name from the config filename; openresolv
    # covers a DNS= line in the operator's config. Plaintext lives only on
    # tmpfs (T-080).
    medusa-wireguard = {
      description = "Medusa egress WireGuard interface ({{ host.egress_gateway.interface }})";
      wantedBy = [ "multi-user.target" ];
      after = [ "network-online.target" "medusa-secrets.service" ];
      requires = [ "medusa-secrets.service" ];
      wants = [ "network-online.target" ];
      path = [ pkgs.wireguard-tools pkgs.iproute2 pkgs.nftables pkgs.openresolv ];
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
        ExecStart = "${pkgs.wireguard-tools}/bin/wg-quick up /run/medusa-secrets/{{ host.name }}/wireguard/{{ host.egress_gateway.interface }}.conf";
        ExecStop = "${pkgs.wireguard-tools}/bin/wg-quick down /run/medusa-secrets/{{ host.name }}/wireguard/{{ host.egress_gateway.interface }}.conf";
      };
    };

    # Dedicated nft table via `nft -f` -- never the distro nftables service.
    # Fail-closed: tunnel down = drop, never a fallback to the clear path.
    medusa-egress-firewall = {
      description = "Medusa egress NAT + kill-switch";
      wantedBy = [ "multi-user.target" ];
      after = [ "network-pre.target" ];
      wants = [ "network-pre.target" ];
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
        ExecStart = "${pkgs.nftables}/bin/nft -f ${../egress/{{ host.name }}/nftables.conf}";
      };
    };

    # Managed zones -> CoreDNS, everything else in-tunnel (no DNS leak).
    medusa-egress-resolver = {
      description = "Medusa split-DNS resolver";
      wantedBy = [ "multi-user.target" ];
      after = [ "network-online.target" ];
      wants = [ "network-online.target" ];
      serviceConfig = {
        ExecStart = "${pkgs.dnsmasq}/bin/dnsmasq --keep-in-foreground --conf-file=${../egress/{{ host.name }}/resolver.conf}";
        Restart = "on-failure";
      };
    };

{% endif %}
{% if host.tunnel %}
    # Never the distro nftables service: its `flush ruleset` would wipe
    # docker's rules. The interpolated store path restarts the unit on switch.
    medusa-tunnel-firewall = {
      description = "Medusa tunnel packet marking";
      wantedBy = [ "multi-user.target" ];
      after = [ "network-pre.target" ];
      wants = [ "network-pre.target" ];
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
        ExecStart = "${pkgs.nftables}/bin/nft -f ${../egress/tunnel-routing.nft}";
      };
    };

    # The same generated script Debian installs at
    # /usr/local/sbin/medusa-tunnel-routes.sh (fail-closed by construction).
    medusa-tunnel-routes = {
      description = "Medusa tunnel policy routing";
      wantedBy = [ "multi-user.target" ];
      after = [ "network-online.target" ];
      wants = [ "network-online.target" ];
      path = [ pkgs.iproute2 ];
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
      };
      script = ''
        exec ${pkgs.bash}/bin/bash ${../egress/tunnel-routes.sh}
      '';
    };

{% endif %}
{% if host.stacks %}
    # Copies staged files only; data dirs beneath the tree are never touched.
    medusa-stacks-sync = {
      description = "Materialize Medusa compose stacks from the generation";
      wantedBy = [ "multi-user.target" ];
      restartTriggers = [{% for stack in host.stacks %} ../stacks/{{ host.name }}/{{ stack.name }}{% endfor %}{% if host.deploy_configs %} ../deploy/{{ host.name }}{% endif %} ];
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
      };
      script = ''
        set -eu
        install -d -o medusa -g medusa -m 2775 /home/medusa/medusa-stacks
{% for stack in host.stacks %}
        src=/etc/medusa-stacks-src/{{ stack.name }}
        dst=/home/medusa/medusa-stacks/{{ stack.name }}
        (cd "$src" && find . -type d -exec install -d -o medusa -g medusa -m 2775 "$dst/{}" \;)
        # No sh here: the unit's PATH has no shell, so a `find -exec sh` dies
        # with "find: 'sh': No such file or directory" and no file is copied.
        (cd "$src" && find . -type f -exec install -o medusa -g medusa -m 0664 {} "$dst/{}" \;)
        [ ! -d "$dst/env" ] || chmod 2770 "$dst/env"
{% endfor %}
{% if host.deploy_configs %}
        # Same tree + modes as the Debian monitoring role.
        install -d -o medusa -g medusa -m 2775 /home/medusa/medusa
{% for cfg in host.deploy_configs %}
        install -d -o medusa -g medusa -m 2775 "/home/medusa/medusa/{{ cfg.dest.rsplit('/', 1)[0] }}"
        install -o medusa -g medusa -m 0664 "/etc/medusa-deploy-src/{{ cfg.dest }}" "/home/medusa/medusa/{{ cfg.dest }}"
{% endfor %}
{% endif %}
      '';
    };
{% for stack in host.stacks %}

    "medusa-stack-{{ stack.unit_suffix }}" = {
      description = "Medusa compose stack {{ stack.name }}";
      wantedBy = [ "multi-user.target" ];
      after = [ "docker.service" "medusa-stacks-sync.service" "network-online.target" "remote-fs.target"{% if host.staged_secrets %} "medusa-secrets.service"{% endif %}{% if host.tunnel %} "medusa-tunnel-firewall.service" "medusa-tunnel-routes.service"{% endif %} ];
      requires = [ "docker.service" "medusa-stacks-sync.service"{% if host.staged_secrets %} "medusa-secrets.service"{% endif %}{% if host.tunnel %} "medusa-tunnel-firewall.service" "medusa-tunnel-routes.service"{% endif %} ];
      wants = [ "network-online.target" ];
      restartTriggers = [ ../stacks/{{ host.name }}/{{ stack.name }} ];
      # Deploy users never get docker-group (root-equivalent) access; only
      # medusa runs compose (Debian parity).
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
        User = "medusa";
        WorkingDirectory = "/home/medusa/medusa-stacks/{{ stack.name }}";
        # The systemd default (90s) would kill a first-deploy multi-GB image
        # pull mid-flight.
        TimeoutStartSec = "60min";
      };
      script = ''
        set -eu
{% for net in stack.external_networks %}
        # `compose up` refuses to create external resources. Stack units start
        # in PARALLEL, so a shared network races: if create loses, re-inspect
        # -- the resource existing is success regardless of who created it.
{% if host.tunnel and net == host.tunnel.network_name %}
        # Pinned subnet: the nft marking and policy routing key on it.
        ${pkgs.docker}/bin/docker network inspect {{ net }} >/dev/null 2>&1 || ${pkgs.docker}/bin/docker network create --subnet {{ host.tunnel.tunnel_subnet }} {{ net }} || ${pkgs.docker}/bin/docker network inspect {{ net }} >/dev/null
{% else %}
        ${pkgs.docker}/bin/docker network inspect {{ net }} >/dev/null 2>&1 || ${pkgs.docker}/bin/docker network create {{ net }} || ${pkgs.docker}/bin/docker network inspect {{ net }} >/dev/null
{% endif %}
{% endfor %}
{% for vol in stack.external_volumes %}
        ${pkgs.docker}/bin/docker volume inspect {{ vol }} >/dev/null 2>&1 || ${pkgs.docker}/bin/docker volume create {{ vol }} || ${pkgs.docker}/bin/docker volume inspect {{ vol }} >/dev/null
{% endfor %}
        exec ${pkgs.docker-compose}/bin/docker-compose up -d --remove-orphans
      '';
    };
{% endfor %}
{% endif %}
{% if host.staged_secrets %}

    # Decrypts with the host's own ssh host key (ssh-to-age): the controller
    # never sees plaintext; tmpfs is wiped on reboot and the unit re-runs.
    # Destinations match Debian so compose references one path (T-080/T-087).
    medusa-secrets = {
      description = "Decrypt Medusa secrets to tmpfs";
      wantedBy = [ "multi-user.target" ];
      restartTriggers = [{% for staged in host.staged_secrets %} ../secrets-enc/{{ staged.staged }}{% endfor %} ];
      path = [ pkgs.sops pkgs.ssh-to-age ];
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
      };
      script = ''
        set -eu
        umask 077
        SOPS_AGE_KEY="$(ssh-to-age -private-key -i /etc/ssh/ssh_host_ed25519_key)"
        export SOPS_AGE_KEY
        rm -rf /run/medusa-secrets
        install -d -o root -g root -m 0755 /run/medusa-secrets
{% for env_file in host.secret_env_files %}
        (umask 022 && mkdir -p "$(dirname '/run/medusa-secrets/{{ env_file.destination }}')")
        # Decrypt into a variable FIRST: under `set -e` a failing command
        # substitution inside printf's arguments is silently discarded (EMPTY
        # secret, not a failed unit); a plain assignment propagates it.
        {
{% for setting in env_file.settings %}
          value="$(sops --decrypt --extract '["value"]' '/etc/medusa-secrets-enc/{{ setting.staged }}')"
          printf '%s=%s\n' '{{ setting.setting }}' "$value"
{% endfor %}
        } > '/run/medusa-secrets/{{ env_file.destination }}'
        chown {{ env_file.owner_user }} '/run/medusa-secrets/{{ env_file.destination }}'
{% endfor %}
{% for file in host.secret_files %}
        (umask 022 && mkdir -p "$(dirname '/run/medusa-secrets/{{ file.destination }}')")
        sops --decrypt --extract '["value"]' '/etc/medusa-secrets-enc/{{ file.staged }}' > '/run/medusa-secrets/{{ file.destination }}'
        chown {{ file.owner_user }} '/run/medusa-secrets/{{ file.destination }}'
{% endfor %}
      '';
    };
{% endif %}
  };
{% endif %}
{% if host.sftp_users %}

  users.groups.sftp = { };
{% if host.sftp_shares %}
  # Pinned gids: NFS sec=sys checks numeric ids, so each gid must match the
  # server-side chgrp of the export dir (T-084).
{% for share in host.sftp_shares %}
  users.groups."{{ share.name }}".gid = {{ share.gid }};
{% endfor %}
{% endif %}
{% if host.sftp_shares %}
  # -u 0002 so uploads land group-writable in shares (private silos stay
  # 0700); emitted only when a share exists (T-084).
{% endif %}
  services.openssh.extraConfig = ''
    Match Group sftp
      ChrootDirectory {{ host.sftp_chroot_root }}/%u
      ForceCommand internal-sftp{% if host.sftp_shares %} -u 0002{% endif %}

      AllowTcpForwarding no
      X11Forwarding no
  '';
{% for user in host.sftp_users %}
  users.users."{{ user.name }}" = {
    isNormalUser = true;
    group = "sftp";
    extraGroups = [ "sftp"{% for share in host.sftp_shares %}{% if user.name in share.members %} "{{ share.name }}"{% endif %}{% endfor %} ];
{% if user.uid is not none %}
    uid = {{ user.uid }};
{% endif %}
    home = "{{ user.home }}";
    openssh.authorizedKeys.keys = [{% for key in user.authorized_keys %} "{{ key }}"{% endfor %} ];
  };
{% endfor %}
{% endif %}

  # Install-time release; pinned for life -- never bump on upgrade (T-078).
  system.stateVersion = "{{ host.state_version }}";
}
