{# Human-authored template. The rendered output is generated. #}
{ modulesPath, pkgs, ... }:
{
  # Generated by Medusa. Do not edit manually.
{% if host.qemu_guest_agent or host.disko_module %}
  # qemu-guest profile (vm guests): the virtio initrd modules, without which
  # stage 1 cannot see the VM's disk to mount the disko root (T-078). The disko
  # import is the operator-authored layout, staged into the flake tree by
  # render; nixos-anywhere runs it to WIPE + partition the disk on first
  # install.
  imports = [{% if host.qemu_guest_agent %} (modulesPath + "/profiles/qemu-guest.nix"){% endif %}{% if host.disko_module %} {{ host.disko_module }}{% endif %} ];
{% endif %}
  networking.hostName = "{{ host.hostname }}";
{% if host.timezone %}
  # Also materializes /etc/localtime, which compose services bind-mount;
  # without it docker auto-creates the missing source as a directory and the
  # mount over the container's file fails.
  time.timeZone = "{{ host.timezone }}";
{% endif %}
{% if host.boot_loader %}

  # UEFI boot via systemd-boot; the ESP is the disko-managed /boot partition.
  # Omitted for lxc guests, which boot from the host kernel (T-078).
  boot.loader.systemd-boot.enable = true;
  boot.loader.efi.canTouchEfiVariables = true;
{% endif %}

  services.openssh = {
    enable = true;
    settings.PasswordAuthentication = false;
  };
{% if host.admin_keys %}

  # Admin/deploy SSH access for `nixos-rebuild --target-host` (T-078). Public
  # keys -- not secret -- carried as plain inventory data.
{% if host.admin_user == "root" %}
  users.users.root.openssh.authorizedKeys.keys = [{% for key in host.admin_keys %} "{{ key }}"{% endfor %} ];
{% else %}
  users.users."{{ host.admin_user }}" = {
    isNormalUser = true;
    extraGroups = [ "wheel" ];
    openssh.authorizedKeys.keys = [{% for key in host.admin_keys %} "{{ key }}"{% endfor %} ];
  };
  # Passwordless sudo so `nixos-rebuild --use-remote-sudo` activates without a
  # prompt.
  security.sudo.wheelNeedsPassword = false;
{% endif %}
{% endif %}
{% if host.qemu_guest_agent %}

  # VM guest: let the Proxmox/KVM host read the guest IP and shut it down
  # gracefully. Not emitted for lxc/physical guests (T-078).
  services.qemuGuest.enable = true;
  # The qemu-guest profile covers virtio_{pci,blk,scsi}; sd_mod is what turns a
  # virtio-scsi disk into /dev/sdX (Proxmox's default SCSI controller), sr_mod
  # the installer CDROM. Without sd_mod stage 1 times out on the root disk.
  boot.initrd.availableKernelModules = [ "sd_mod" "sr_mod" ];
{% endif %}
{% if host.network %}

  # networkd exclusively: without useNetworkd, NixOS keeps dhcpcd running
  # beside networkd on the same interface (upstream warns this can lose
  # networking) -- fatal on a headless static-IP host.
  networking.useNetworkd = true;
  networking.useDHCP = false;
  systemd.network.enable = true;
  systemd.network.networks."10-{{ host.network.interface }}" = {
    matchConfig.Name = "{{ host.network.interface }}";
    address = [ "{{ host.network.address }}" ];
    routes = [ { Gateway = "{{ host.network.gateway }}"; } ];
    networkConfig.DNS = [{% for ns in host.network.nameservers %} "{{ ns }}"{% endfor %} ];
  };
{% endif %}
{% for fs in host.file_systems %}

  fileSystems."{{ fs.mountpoint }}" = {
    device = "{{ fs.device }}";
    fsType = "{{ fs.fs_type }}";
    options = [{% for opt in fs.options %} "{{ opt }}"{% endfor %} ];
  };
{% endfor %}
{% if host.stacks %}

  # ---- Compose-on-NixOS (T-087) ---------------------------------------------
  # This host runs the SAME generated compose stacks a Debian host would:
  # compose is the platform-neutral container layer; NixOS declares only the
  # substrate beneath it. Containers are supervised by the docker daemon
  # (restart policies), exactly as on Debian -- the units below only reconcile.
  virtualisation.docker.enable = true;
{% if host.insecure_registries %}
  # In-fleet registries served over plain HTTP behind the fleet proxy (the
  # image's registry component is a fleet route host). Debian hosts carry the
  # same trust in /etc/docker/daemon.json.
  virtualisation.docker.daemon.settings."insecure-registries" = [{% for reg in host.insecure_registries %} "{{ reg }}"{% endfor %} ];
{% endif %}
{% if host.tunnel %}

  # ---- Tunnel-routing client (T-087/D6, the T-066 mechanism) ----------------
  # Split policy routing for `egress: tunnel` containers: marked LAN-bound
  # traffic stays direct, everything else routes via a table whose ONLY route
  # is the default through the gateway -- fail-closed (gateway down = drop,
  # never a leak out the main default route).
  # Asymmetric policy routing needs loose reverse-path filtering (Debian role
  # parity), and the NixOS firewall's own reverse-path check shares the
  # nftables backend with docker's rules -- "loose" keeps it from dropping
  # marked flows whose return path differs from the main table's expectation.
  networking.firewall.checkReversePath = "loose";
  boot.kernel.sysctl = {
    "net.ipv4.conf.all.rp_filter" = 2;
    "net.ipv4.conf.default.rp_filter" = 2;
  };
{% endif %}

  # Service runtime identity (Debian-fleet parity): medusa owns the stacks tree
  # and runs compose; docker-group membership grants the socket.
  users.groups.medusa = { };
  users.users.medusa = {
    isNormalUser = true;
    group = "medusa";
    extraGroups = [ "docker" ];
    home = "/home/medusa";
  };
{% endif %}
{% if host.egress_gateway %}

  # ---- Shared WireGuard egress gateway (T-066, wireguard_gateway port) ------
  # This host routes tunneled client traffic into WireGuard behind a
  # fail-closed kill-switch (the staged nft ruleset: forwarded traffic may
  # ONLY leave via the tunnel) and answers client DNS on the split resolver.
  # ip_forward turns the host into a router; the host firewall must admit the
  # clients' DNS queries. Reverse-path checking is disabled outright: return
  # traffic arrives on {{ host.egress_gateway.interface }} while the main
  # table routes those sources via the LAN uplink (Debian gateways run with
  # the distro's rp_filter=0 default -- this is parity, not a loosening).
  boot.kernel.sysctl."net.ipv4.ip_forward" = 1;
  networking.firewall.checkReversePath = false;
{% endif %}
{% if host.coredns %}

  # ---- CoreDNS (T-056 port) --------------------------------------------------
  # The LIVE resolver for the whole LAN, on the same generated Corefile +
  # lan.hosts the Debian role deploys (staged in-generation, byte-identical).
  # The Debian role's backup/health-check/restore guard is NixOS-native here:
  # a bad config is a generation rollback.
  # systemd-resolved rides in with networkd and its stub listener
  # (127.0.0.53:53) collides with CoreDNS's wildcard :53 bind -- this host IS
  # the resolver, so resolved is disabled and the static resolv.conf points
  # at the network config's nameservers (this host itself).
  services.resolved.enable = false;
{% endif %}
{% if host.egress_gateway or host.coredns %}

  # DNS service ports (the gateway's split resolver / the fleet resolver).
  networking.firewall.allowedTCPPorts = [ 53 ];
  networking.firewall.allowedUDPPorts = [ 53 ];
{% endif %}
{% if host.stacks or host.staged_secrets or host.deploy_configs or host.coredns %}

  # Staged, in-generation sources: this host's stack trees and encrypted secret
  # files, copied into the store with the flake. The sync unit materializes the
  # stacks into the writable Debian-identical tree at /home/medusa/medusa-stacks
  # (relative binds and `medusactl compose` work byte-for-byte); a rollback
  # re-syncs the previous generation's config.
  environment.etc = {
{% if host.coredns %}
    # The generated Corefile references /etc/coredns/lan.hosts verbatim.
    "coredns/lan.hosts".source = ../coredns/lan.hosts;
{% endif %}
{% for stack in host.stacks %}
    "medusa-stacks-src/{{ stack.name }}".source = ../stacks/{{ stack.name }};
{% endfor %}
{% for staged in host.staged_secrets %}
    "medusa-secrets-enc/{{ staged.staged }}".source = ../secrets-enc/{{ staged.staged }};
{% endfor %}
{% for cfg in host.deploy_configs %}
    "medusa-deploy-src/{{ cfg.dest }}".source = ../deploy/{{ host.name }}/{{ cfg.dest }};
{% endfor %}
  };
{% endif %}
{% if host.stacks or host.sftp_users %}

{% if host.sftp_users %}
  # Root-owned chroot dirs (OpenSSH requires ChrootDirectory to be root-owned
  # and not writable by the chrooted user); the writable area is the storage
  # bind mounted beneath each one.
{% endif %}
  systemd.tmpfiles.rules = [
{% for user in host.sftp_users %}
    "d {{ user.chroot }} 0755 root root -"
{% endfor %}
{% if host.stacks %}
    # `docker compose` (space form) plugin lookup for interactive use (T-083
    # parity); the units below call the compose binary directly.
    "L+ /usr/local/lib/docker/cli-plugins/docker-compose - - - - ${pkgs.docker-compose}/bin/docker-compose"
{% for d in host.data_dirs %}
    # Bind-mount data dir owned before compose up (Debian role parity, T-065).
    "d /home/medusa/medusa-stacks/{{ d.path }} 0755 {{ d.owner }} {{ d.group }} -"
{% endfor %}
{% endif %}
  ];
{% endif %}
{% if host.stacks or host.staged_secrets or host.coredns %}

  systemd.services = {
{% if host.coredns %}
    # CoreDNS on the generated config. Restart=on-failure self-heals transient
    # crashes; the hosts plugin re-reads lan.hosts on change, and a Corefile
    # change changes the interpolated store path, so the unit restarts on
    # switch. A config CoreDNS rejects at startup = roll back the generation.
    medusa-coredns = {
      description = "Medusa CoreDNS resolver";
      wantedBy = [ "multi-user.target" ];
      after = [ "network-online.target" ];
      wants = [ "network-online.target" ];
      restartTriggers = [ ../coredns/lan.hosts ];
      serviceConfig = {
        ExecStart = "${pkgs.coredns}/bin/coredns -conf ${../coredns/Corefile}";
        Restart = "on-failure";
        RestartSec = 2;
      };
    };

{% endif %}
{% if host.egress_gateway %}
    # The WireGuard interface on the host-decrypted tmpfs config (T-080: the
    # plaintext never touches persistent disk or the controller). wg-quick
    # derives the interface name from the config filename. openresolv covers
    # a DNS= line in the operator's config.
    medusa-wireguard = {
      description = "Medusa egress WireGuard interface ({{ host.egress_gateway.interface }})";
      wantedBy = [ "multi-user.target" ];
      after = [ "network-online.target" "medusa-secrets.service" ];
      requires = [ "medusa-secrets.service" ];
      wants = [ "network-online.target" ];
      path = [ pkgs.wireguard-tools pkgs.iproute2 pkgs.nftables pkgs.openresolv ];
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
        ExecStart = "${pkgs.wireguard-tools}/bin/wg-quick up /run/medusa-secrets/{{ host.name }}/wireguard/{{ host.egress_gateway.interface }}.conf";
        ExecStop = "${pkgs.wireguard-tools}/bin/wg-quick down /run/medusa-secrets/{{ host.name }}/wireguard/{{ host.egress_gateway.interface }}.conf";
      };
    };

    # NAT + fail-closed kill-switch: our own oneshot loading a dedicated nft
    # table (same surgical `nft -f` pattern as the client side -- never the
    # distro nftables service). Forwarded traffic may only leave via the
    # tunnel; tunnel down = drop, never a fallback to the clear path.
    medusa-egress-firewall = {
      description = "Medusa egress NAT + kill-switch";
      wantedBy = [ "multi-user.target" ];
      after = [ "network-pre.target" ];
      wants = [ "network-pre.target" ];
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
        ExecStart = "${pkgs.nftables}/bin/nft -f ${../egress/{{ host.name }}/nftables.conf}";
      };
    };

    # Split-DNS resolver on the generated config (managed zones -> CoreDNS,
    # everything else -> the in-tunnel upstream; no DNS leak).
    medusa-egress-resolver = {
      description = "Medusa split-DNS resolver";
      wantedBy = [ "multi-user.target" ];
      after = [ "network-online.target" ];
      wants = [ "network-online.target" ];
      serviceConfig = {
        ExecStart = "${pkgs.dnsmasq}/bin/dnsmasq --keep-in-foreground --conf-file=${../egress/{{ host.name }}/resolver.conf}";
        Restart = "on-failure";
      };
    };

{% endif %}
{% if host.tunnel %}
    # Tunnel packet marking: our own oneshot loading a dedicated nft table
    # (never the distro nftables service, whose `flush ruleset` would wipe
    # docker's rules). The staged file is interpolated into the store, so a
    # content change changes the unit and NixOS restarts it on switch.
    medusa-tunnel-firewall = {
      description = "Medusa tunnel packet marking";
      wantedBy = [ "multi-user.target" ];
      after = [ "network-pre.target" ];
      wants = [ "network-pre.target" ];
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
        ExecStart = "${pkgs.nftables}/bin/nft -f ${../egress/tunnel-routing.nft}";
      };
    };

    # Fail-closed policy routing for marked traffic (same generated script the
    # Debian role installs at /usr/local/sbin/medusa-tunnel-routes.sh).
    medusa-tunnel-routes = {
      description = "Medusa tunnel policy routing";
      wantedBy = [ "multi-user.target" ];
      after = [ "network-online.target" ];
      wants = [ "network-online.target" ];
      path = [ pkgs.iproute2 ];
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
      };
      script = ''
        exec ${pkgs.bash}/bin/bash ${../egress/tunnel-routes.sh}
      '';
    };

{% endif %}
{% if host.stacks %}
    # Materialize the staged stack trees into the writable stacks root. Only
    # staged files are copied; data dirs beneath the tree are never touched.
    medusa-stacks-sync = {
      description = "Materialize Medusa compose stacks from the generation";
      wantedBy = [ "multi-user.target" ];
      restartTriggers = [{% for stack in host.stacks %} ../stacks/{{ stack.name }}{% endfor %}{% if host.deploy_configs %} ../deploy/{{ host.name }}{% endif %} ];
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
      };
      script = ''
        set -eu
        install -d -o medusa -g medusa -m 2775 /home/medusa/medusa-stacks
{% for stack in host.stacks %}
        src=/etc/medusa-stacks-src/{{ stack.name }}
        dst=/home/medusa/medusa-stacks/{{ stack.name }}
        (cd "$src" && find . -type d -exec install -d -o medusa -g medusa -m 2775 "$dst/{}" \;)
        # No sh here: the unit's PATH has no shell, so a `find -exec sh` dies
        # with "find: 'sh': No such file or directory" and no file is copied.
        (cd "$src" && find . -type f -exec install -o medusa -g medusa -m 0664 {} "$dst/{}" \;)
        [ ! -d "$dst/env" ] || chmod 2770 "$dst/env"
{% endfor %}
{% if host.deploy_configs %}
        # Deploy-root configs (Debian monitoring-role parity): materialize
        # under /home/medusa/medusa with the same dir/file modes as the role.
        install -d -o medusa -g medusa -m 2775 /home/medusa/medusa
{% for cfg in host.deploy_configs %}
        install -d -o medusa -g medusa -m 2775 "/home/medusa/medusa/{{ cfg.dest.rsplit('/', 1)[0] }}"
        install -o medusa -g medusa -m 0664 "/etc/medusa-deploy-src/{{ cfg.dest }}" "/home/medusa/medusa/{{ cfg.dest }}"
{% endfor %}
{% endif %}
      '';
    };
{% for stack in host.stacks %}

    "medusa-stack-{{ stack.unit_suffix }}" = {
      description = "Medusa compose stack {{ stack.name }}";
      wantedBy = [ "multi-user.target" ];
      after = [ "docker.service" "medusa-stacks-sync.service" "network-online.target" "remote-fs.target"{% if host.staged_secrets %} "medusa-secrets.service"{% endif %}{% if host.tunnel %} "medusa-tunnel-firewall.service" "medusa-tunnel-routes.service"{% endif %} ];
      requires = [ "docker.service" "medusa-stacks-sync.service"{% if host.staged_secrets %} "medusa-secrets.service"{% endif %}{% if host.tunnel %} "medusa-tunnel-firewall.service" "medusa-tunnel-routes.service"{% endif %} ];
      wants = [ "network-online.target" ];
      restartTriggers = [ ../stacks/{{ stack.name }} ];
      # Runs as medusa (docker group) -- the same identity that runs compose on
      # Debian; deploy users never get docker-group (root-equivalent) access.
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
        User = "medusa";
        WorkingDirectory = "/home/medusa/medusa-stacks/{{ stack.name }}";
        # First deploy pulls every image in the stack; the systemd default
        # (90s) would kill a multi-GB pull mid-flight. Matches the Debian
        # path, where ansible imposes no timeout on compose up.
        TimeoutStartSec = "60min";
      };
      script = ''
        set -eu
{% for net in stack.external_networks %}
        # `compose up` refuses to create external resources; pre-create them
        # (mirror of the Debian role's external-resources step). The tunnel
        # network carries its pinned subnet -- the nft marking and policy
        # routing key on it, so an unpinned subnet would break the tunnel.
        # Stack units start in PARALLEL (ansible ran this step serially), so
        # a shared network races: if create loses, re-inspect -- the resource
        # existing is success regardless of who created it.
{% if host.tunnel and net == host.tunnel.network_name %}
        ${pkgs.docker}/bin/docker network inspect {{ net }} >/dev/null 2>&1 || ${pkgs.docker}/bin/docker network create --subnet {{ host.tunnel.tunnel_subnet }} {{ net }} || ${pkgs.docker}/bin/docker network inspect {{ net }} >/dev/null
{% else %}
        ${pkgs.docker}/bin/docker network inspect {{ net }} >/dev/null 2>&1 || ${pkgs.docker}/bin/docker network create {{ net }} || ${pkgs.docker}/bin/docker network inspect {{ net }} >/dev/null
{% endif %}
{% endfor %}
{% for vol in stack.external_volumes %}
        ${pkgs.docker}/bin/docker volume inspect {{ vol }} >/dev/null 2>&1 || ${pkgs.docker}/bin/docker volume create {{ vol }} || ${pkgs.docker}/bin/docker volume inspect {{ vol }} >/dev/null
{% endfor %}
        exec ${pkgs.docker-compose}/bin/docker-compose up -d --remove-orphans
      '';
    };
{% endfor %}
{% endif %}
{% if host.staged_secrets %}

    # Host-side secret decryption (the T-080 seam, ported for T-087): decrypt
    # THIS host's secrets to tmpfs with the host's own ssh host key
    # (ssh-to-age). The controller never sees plaintext; tmpfs is wiped on
    # reboot and the unit re-runs. Destinations are identical to Debian, so
    # the generated compose files reference the same paths on both platforms.
    medusa-secrets = {
      description = "Decrypt Medusa secrets to tmpfs";
      wantedBy = [ "multi-user.target" ];
      restartTriggers = [{% for staged in host.staged_secrets %} ../secrets-enc/{{ staged.staged }}{% endfor %} ];
      path = [ pkgs.sops pkgs.ssh-to-age ];
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
      };
      script = ''
        set -eu
        umask 077
        SOPS_AGE_KEY="$(ssh-to-age -private-key -i /etc/ssh/ssh_host_ed25519_key)"
        export SOPS_AGE_KEY
        rm -rf /run/medusa-secrets
        install -d -o root -g root -m 0755 /run/medusa-secrets
{% for env_file in host.secret_env_files %}
        (umask 022 && mkdir -p "$(dirname '/run/medusa-secrets/{{ env_file.destination }}')")
        {
{% for setting in env_file.settings %}
          printf '%s=%s\n' '{{ setting.setting }}' "$(sops --decrypt --extract '["value"]' '/etc/medusa-secrets-enc/{{ setting.staged }}')"
{% endfor %}
        } > '/run/medusa-secrets/{{ env_file.destination }}'
        chown {{ env_file.owner_user }} '/run/medusa-secrets/{{ env_file.destination }}'
{% endfor %}
{% for file in host.secret_files %}
        (umask 022 && mkdir -p "$(dirname '/run/medusa-secrets/{{ file.destination }}')")
        sops --decrypt --extract '["value"]' '/etc/medusa-secrets-enc/{{ file.staged }}' > '/run/medusa-secrets/{{ file.destination }}'
        chown {{ file.owner_user }} '/run/medusa-secrets/{{ file.destination }}'
{% endfor %}
      '';
    };
{% endif %}
  };
{% endif %}
{% if host.sftp_users %}

  users.groups.sftp = { };
{% if host.sftp_shares %}
  # Shared-space groups (T-084): pinned gids because NFS sec=sys checks numeric
  # ids -- the gid must match the server-side chgrp of the export dir (2775,
  # setgid, so files created in the share inherit the group).
{% for share in host.sftp_shares %}
  users.groups."{{ share.name }}".gid = {{ share.gid }};
{% endfor %}
{% endif %}
{% if host.sftp_shares %}
  # -u 0002: uploads land group-writable so shared-space members can edit each
  # other's files. Private silos are unaffected (their dirs are 0700). Emitted
  # only when a share exists so share-free hosts render byte-identical (T-084).
{% endif %}
  services.openssh.extraConfig = ''
    Match Group sftp
      ChrootDirectory {{ host.sftp_chroot_root }}/%u
      ForceCommand internal-sftp{% if host.sftp_shares %} -u 0002{% endif %}

      AllowTcpForwarding no
      X11Forwarding no
  '';
{% for user in host.sftp_users %}
  users.users."{{ user.name }}" = {
    isNormalUser = true;
    group = "sftp";
    extraGroups = [ "sftp"{% for share in host.sftp_shares %}{% if user.name in share.members %} "{{ share.name }}"{% endif %}{% endfor %} ];
{% if user.uid is not none %}
    uid = {{ user.uid }};
{% endif %}
    home = "{{ user.home }}";
    openssh.authorizedKeys.keys = [{% for key in user.authorized_keys %} "{{ key }}"{% endfor %} ];
  };
{% endfor %}
{% endif %}

  # Install-time release; pinned for life -- never bump on upgrade (T-078).
  system.stateVersion = "{{ host.state_version }}";
}
