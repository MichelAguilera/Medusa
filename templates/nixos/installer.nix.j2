{# Human-authored template. The rendered output is generated. #}
{ modulesPath, ... }:
{
  # Generated by Medusa. Do not edit manually.
  #
  # Medusa installer ISO (T-089): a minimal NixOS live image with the
  # controller key(s) on root, so a freshly booted target is immediately
  # reachable for `medusactl install-nixos-target` -- no console password, no
  # key paste. Generic: one image serves every host (it carries only these
  # keys); rebuild only when a key rotates. The embedded nixpkgs snapshot only
  # affects the live environment -- nixos-anywhere installs a freshly built
  # closure regardless of how old the boot medium is.
  imports = [ (modulesPath + "/installer/cd-dvd/installation-cd-minimal.nix") ];

  # nixos_installer_keys from dns.yaml -- plain public-key inventory data.
  users.users.root.openssh.authorizedKeys.keys = [
{% for key in nixos.installer_keys %}
    "{{ key }}"
{% endfor %}
  ];

  # Let Proxmox/KVM report the live system's DHCP address in the UI, so the
  # operator never hunts the router's client list for --ip.
  services.qemuGuest.enable = true;
}
