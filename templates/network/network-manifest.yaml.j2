# Generated by Medusa. Do not edit manually.
# Consumed by the network_cutover Ansible role: host -> resolved static
# networking. Empty mapping when no host opted into managed networking.
hosts:
{% for host in network.hosts %}
  {{ host.name }}:
    ip: {{ host.ip }}
    address: {{ host.address }}
    interface: {{ host.interface }}
    gateway: {{ host.gateway }}
    nameservers:
{% for server in host.nameservers %}
      - {{ server }}
{% endfor %}
{% else %}
  {}
{% endfor %}
