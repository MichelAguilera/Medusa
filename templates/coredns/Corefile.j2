{% for zone in coredns.dns.zones %}
{{ zone.name }} {
    log
    errors

    hosts /etc/coredns/lan.hosts
}

{% endfor %}
{% for zone in coredns.rewrite_zones %}
{{ zone }} {
    log
    errors

    rewrite stop {
        name regex (.+)\.{{ zone | replace(".", "\\.") }}\.? {{ zone }}.
        answer auto
    }

    hosts /etc/coredns/lan.hosts
}

{% endfor %}
{% for domain in coredns.plaintext_domains %}
{{ domain }} {
    errors
    forward . {{ coredns.upstreams | join(" ") }}
    cache 300
}

{% endfor %}
. {
    reload
{% if coredns.upstreams %}
{% if coredns.forwarder_mode == "dot" %}
    forward . {% for u in coredns.upstreams %}tls://{{ u }}{% if not loop.last %} {% endif %}{% endfor %} {
        tls_servername {{ coredns.forwarder_tls_servername }}
        health_check 5s
    }
{% else %}
    forward . {{ coredns.upstreams | join(" ") }}
{% endif %}
{% endif %}
    cache 300
}
