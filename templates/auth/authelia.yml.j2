{# Human-authored template. The rendered output is generated. #}
{# Secret reads are Authelia config-template expressions, rendered verbatim
   for X_AUTHELIA_CONFIG_FILTERS=template to resolve on the host. #}
{% macro secret(path) %}{{ "{{ secret \"%s\" }}" | format(path) }}{% endmacro %}
# Generated by Medusa. Do not edit manually.
theme: auto

server:
  address: 'tcp://:9091/'
  endpoints:
    authz:
      forward-auth:
        implementation: 'ForwardAuth'

log:
  level: info

identity_validation:
  reset_password:
    jwt_secret: '{{ secret(auth.secret_files["jwt"]) }}'

totp:
  issuer: {{ auth.display_name | tojson }}

webauthn:
  disable: false
  display_name: {{ auth.display_name | tojson }}
  attestation_conveyance_preference: indirect
  user_verification: preferred

authentication_backend:
  password_reset:
    disable: true
  file:
    path: {{ auth.secret_files["users"] | tojson }}
    watch: false
    password:
      algorithm: argon2

access_control:
  default_policy: deny
  rules:
{% for rule in auth.rules %}
    - domain: {{ rule.domain | tojson }}
      policy: {{ rule.policy | tojson }}
{% endfor %}

session:
  secret: '{{ secret(auth.secret_files["session"]) }}'
  name: authelia_session
  same_site: lax
  inactivity: {{ auth.session_inactivity | tojson }}
  expiration: {{ auth.session_expiration | tojson }}
  remember_me: {{ auth.session_remember_me | tojson }}
  cookies:
    - domain: {{ auth.cookie_domain | tojson }}
      authelia_url: {{ auth.url | tojson }}

regulation:
  max_retries: 3
  find_time: 2m
  ban_time: 5m

storage:
  encryption_key: '{{ secret(auth.secret_files["storage"]) }}'
  local:
    path: /config/db.sqlite3

notifier:
  disable_startup_check: true
  filesystem:
    filename: /config/notification.txt

{% if auth.clients %}
identity_providers:
  oidc:
    hmac_secret: '{{ secret(auth.secret_files["oidc_hmac"]) }}'
    jwks:
      - algorithm: RS256
        key: |
          {{ "{{- fileContent \"%s\" | nindent 10 }}" | format(auth.secret_files["oidc_key"]) }}
    clients:
{% for client in auth.clients %}
      - client_id: {{ client.client_id | tojson }}
        client_name: {{ client.name | tojson }}
        client_secret: '$plaintext${{ secret(client.secret_file) }}'
        public: false
        authorization_policy: {{ client.policy | tojson }}
        consent_mode: implicit
        redirect_uris:
{% for uri in client.redirect_uris %}
          - {{ uri | tojson }}
{% endfor %}
        scopes:
{% for scope in client.scopes %}
          - {{ scope | tojson }}
{% endfor %}
        response_types: ['code']
        grant_types: ['authorization_code', 'refresh_token']
        token_endpoint_auth_method: client_secret_basic
        userinfo_signed_response_alg: none
{% endfor %}
{% endif %}
