{# Human-authored template. The rendered output is generated. #}
{# The top-level scrape_configs key is load-bearing: prometheus's
   scrape_config_files loads each file as a partial config (a mapping),
   not as a bare scrape-config sequence. #}
# Generated by Medusa. Do not edit manually.
scrape_configs:
{% if monitoring.targets %}
{% for entry in monitoring.targets %}
- job_name: "{{ entry.job }}"
  metrics_path: "{{ entry.metrics_path }}"
  static_configs:
  - targets: ["{{ entry.target }}"]
{% if entry.labels %}
    labels:
{% for key, value in entry.labels %}
      {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
{% endfor %}
{% else %}
- job_name: "medusa-services"
  static_configs:
    []
{% endif %}
