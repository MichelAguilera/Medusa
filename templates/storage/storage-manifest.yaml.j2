{# Human-authored template. The rendered output is generated. #}
# Generated by Medusa. Do not edit manually.
{% if storage.mounts_by_host %}
hosts:
{% for host, mounts in storage.mounts_by_host %}
  {{ host }}:
{% for mount in mounts %}
  - id: {{ mount.id }}
    mountpoint: {{ mount.mountpoint }}
    source: {{ mount.source }}
    fstype: {{ mount.type }}
    options: {{ mount.options | join(",") }}
    server_ip: {{ mount.server_ip }}
    client_ip: {{ mount.client_ip }}
{% endfor %}
{% endfor %}
{% else %}
hosts: {}
{% endif %}
{% set ns = namespace(any=false) %}
{% for server, exports in storage.exports_by_server %}
{% for export in exports %}
{% if export.clients %}{% set ns.any = true %}{% endif %}
{% endfor %}
{% endfor %}
{% if ns.any %}
servers:
{% for server, exports in storage.exports_by_server %}
{% if exports | selectattr("clients") | list %}
  {{ server }}:
{% for export in exports %}
{% if export.clients %}
  - path: {{ export.path }}
    dataset: {{ export.dataset if export.dataset else "" }}
{% if export.directories %}
    directories:
{% for dir in export.directories %}
    - path: {{ dir.path }}
      owner: "{{ dir.owner }}"
      group: "{{ dir.group }}"
      mode: "{{ dir.mode }}"
{% endfor %}
{% else %}
    directories: []
{% endif %}
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
{% else %}
servers: {}
{% endif %}
{% if storage.zfs_roots %}
zfs_roots:
{% for server, root in storage.zfs_roots %}
  {{ server }}: {{ root }}
{% endfor %}
{% else %}
zfs_roots: {}
{% endif %}
