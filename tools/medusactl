# Managed-host audit: reachability + sudo probe per host — hardening is the
# operator's, intentionally outside medusa's audit scope. Warns on findings;
# never fails the overall check.
cmd_audit_targets() {
    local target log
    target=$(ssh_target)
    log=$(log_path "audit-targets")

    local remote
    remote=$(cat <<REMOTE
set -uo pipefail
export PATH="\$HOME/.local/bin:\$PATH"
export MEDUSA_INVENTORY_ROOT=$(printf %q "$MEDUSA_CONTROLLER_INVENTORY_PATH")
export MEDUSA_INVENTORY_DIR=$(printf %q "$MEDUSA_CONTROLLER_INVENTORY_PATH/inventory")
export MEDUSA_SECRETS_DIR=$(printf %q "$MEDUSA_CONTROLLER_INVENTORY_PATH/secrets")
export MEDUSA_GENERATED_DIR=$(printf %q "$MEDUSA_CONTROLLER_GENERATED_PATH")
cd "$MEDUSA_CONTROLLER_PATH"
hosts=\$(uv run --quiet medusa list-hosts --managed-only) || {
    echo "audit: medusa list-hosts --managed-only failed on controller" >&2
    exit 0
}
REMOTE
)
    remote+=$'\n'
    remote+=$(cat <<'REMOTE'
findings=0
checked=0
while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    # Skip rows that don't start with the managed-mode prefix letter.
    [[ "$line" =~ ^[FL][[:space:]] ]] || continue

    name=$(awk '{print $2}' <<< "$line")
    ip=$(awk '{print $3}' <<< "$line")
    user=$(awk '{for(i=1;i<=NF;i++) if($i~/^user=/){sub(/^user=/,"",$i); print $i}}' <<< "$line")
    [[ -z "$user" ]] && user="ansible"
    [[ -z "$ip" || -z "$name" ]] && continue

    checked=$((checked + 1))

    # -n: don't read from stdin, otherwise ssh swallows the outer
    # 'read -r line' loop's heredoc and the loop exits after the
    # first iteration.
    # Use hostname (not ip) so the controller's /etc/hosts
    # bootstrap block (bootstrap_ip override) routes the
    # connection during the cutover phase. /etc/hosts -> DNS
    # fallback keeps this correct when bootstrap_ip is unset.
    if ssh -n -o BatchMode=yes -o ConnectTimeout=5 \
            -o StrictHostKeyChecking=accept-new "${user}@${name}" \
            'sudo -n true' >/dev/null 2>&1; then
        printf "  ✓ %s (%s@%s): reachable + sudo ok (limited; hardening checks skipped)\n" \
            "$name" "$user" "$ip"
    else
        printf "  ! %s (%s@%s): unreachable or sudo -n unavailable (limited)\n" \
            "$name" "$user" "$ip"
        findings=$((findings + 1))
    fi
done <<< "$hosts"

echo ""
if [[ "$checked" -eq 0 ]]; then
    echo "audit: no managed hosts found"
elif [[ "$findings" -gt 0 ]]; then
    echo "audit: $findings host(s) flagged as unsafe; see warnings above"
else
    echo "audit: all $checked managed host(s) clean"
fi
REMOTE
)

    local ssh_opts
    mapfile -t ssh_opts < <(ssh_base_opts)

    printf "%s==>%s audit-targets\n" "$color_blue" "$color_reset"
    printf "remote:  %s:%s\n" "$target" "$MEDUSA_CONTROLLER_PORT"
    printf "log:    %s\n" "$log"

    if ssh "${ssh_opts[@]}" "$target" "bash -s" <<< "$remote" 2>&1 | tee "$log"; then
        printf "%s✓%s audit-targets\n" "$color_green" "$color_reset"
        return 0
    else
        printf "%s!%s audit-targets reported issues (log: %s)\n" \
            "$color_yellow" "$color_reset" "$log" >&2
        return 0
    fi
}

inventory_pull_cmd() {
    # T-037 stage D: every controller-side workflow fast-forwards the
    # controller's inventory clone first, so it acts on what the
    # workstation just pushed (the deploy guards verify the push happened).
    printf 'git -C %q pull --ff-only && ' "$MEDUSA_CONTROLLER_INVENTORY_PATH"
}

require_clean_for_deploy() {
    # T-037 stage D: the git remote is the authoritative source of truth;
    # refuse to deploy while the local clone is dirty, unpushed, or behind.
    require_local_inventory_dir
    local porcelain ahead behind
    porcelain=$(git -C "$MEDUSACTL_INVENTORY_DIR" status --porcelain 2>/dev/null)
    [[ -z "$porcelain" ]] \
        || fail "deploy: workstation inventory has uncommitted changes; commit/push or discard before deploying"
    git -C "$MEDUSACTL_INVENTORY_DIR" fetch --quiet origin 2>/dev/null || true
    if git -C "$MEDUSACTL_INVENTORY_DIR" rev-parse --verify --quiet origin/main >/dev/null; then
        ahead=$(git -C "$MEDUSACTL_INVENTORY_DIR" rev-list --count origin/main..HEAD 2>/dev/null || echo 0)
        behind=$(git -C "$MEDUSACTL_INVENTORY_DIR" rev-list --count HEAD..origin/main 2>/dev/null || echo 0)
        [[ "$ahead" -eq 0 ]] \
            || fail "deploy: workstation is $ahead commit(s) ahead of origin/main; run 'medusactl push' first"
        [[ "$behind" -eq 0 ]] \
            || fail "deploy: workstation is $behind commit(s) behind origin/main; run 'git -C \"$MEDUSACTL_INVENTORY_DIR\" pull --ff-only' first"
    else
        warn "no origin/main upstream; deploy guard cannot verify push status"
    fi
}

cmd_render() {
    load_config
    run_logged render "$(inventory_pull_cmd)uv run medusa render"
}

cmd_deploy() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        cat <<EOF
medusactl deploy [--check] [--limit <pattern>] — render and apply the fleet.

Runs controller-apply.yml on the controller (the /etc/hosts + ssh-config
refresh), then reconciles the fleet with nixos-rebuild. The Debian ansible
deploy path was retired with T-096 phase 3.

  --check            Dry run (controller-apply --check --diff; NixOS dry-activate).
  --limit <pattern>  Reconcile only NixOS hosts whose NAME matches <pattern>
                     (host, comma list, or glob). controller-apply always runs
                     unrestricted so a targeted host stays resolvable.

Examples:
  medusactl deploy --limit host01
  medusactl deploy --check --limit host01,host02
EOF
        return 0
    fi
    load_config
    local check=0 limit=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --check) check=1; shift ;;
            --limit)
                shift
                [[ -n "${1:-}" ]] || fail "deploy: --limit requires a host pattern (e.g. --limit host01 or --limit host01,host02)"
                limit=$1; shift ;;
            --limit=*)
                limit=${1#--limit=}
                [[ -n "$limit" ]] || fail "deploy: --limit requires a host pattern (e.g. --limit host01)"
                shift ;;
            *) fail "deploy: unexpected argument '$1' (usage: medusactl deploy [--check] [--limit <pattern>])" ;;
        esac
    done
    require_clean_for_deploy
    # controller-apply stays UNRESTRICTED under --limit: limiting it would
    # no-op the /etc/hosts + ssh-config refresh a targeted host needs to
    # stay resolvable.
    [[ -z "$limit" ]] || info "limiting the NixOS reconcile to: $limit (controller-apply always runs)"
    if [[ "$check" -eq 1 ]]; then
        run_logged deploy-check \
            "$(inventory_pull_cmd)uv run medusa render && cd ansible && uv run ansible-playbook playbooks/controller-apply.yml --check --diff" \
            || fail "deploy --check failed"
        # T-075: refresh=0 — the render above already refreshed the flake.
        _nixos_apply_run dry-activate 0 "$limit"
    else
        require_controller_apply_prereqs deploy \
            || fail "deploy prerequisites failed"
        # controller-apply BEFORE the reconcile: it rewrites the controller's
        # /etc/hosts + ~/.ssh/config aliases that nixos-rebuild's
        # hostname-based SSH depends on.
        run_logged deploy \
            "$(inventory_pull_cmd)uv run medusa render && cd ansible && uv run ansible-playbook playbooks/controller-apply.yml" \
            || fail "deploy failed"
        # T-075: refresh=0 — the deploy step just rendered.
        _nixos_apply_run switch 0 "$limit"
    fi
}

# Fetch the rendered stack table from the controller: one tab-separated row
# per stack, 'stack host services platform state'. The platform/state columns
# are what the runtime-verb routing decides on (T-092); rows without
# platform=nixos are a hard error since the ansible path retired (T-096).
fetch_stacks() {
    local target
    local -a ssh_opts
    target=$(ssh_target)
    mapfile -t ssh_opts < <(ssh_base_opts)
    [[ -t 0 ]] || ssh_opts+=(-o BatchMode=yes)
    local remote
    remote=$(cat <<'REMOTE'
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
cd "$MEDUSA_CONTROLLER_PATH"
uv run --quiet medusa list-stacks
REMOTE
)
    ssh "${ssh_opts[@]}" "$target" \
        "MEDUSA_CONTROLLER_PATH=$(printf %q "$MEDUSA_CONTROLLER_PATH") \
         MEDUSA_INVENTORY_DIR=$(printf %q "$MEDUSA_CONTROLLER_INVENTORY_PATH/inventory") \
         MEDUSA_SECRETS_DIR=$(printf %q "$MEDUSA_CONTROLLER_INVENTORY_PATH/secrets") \
         bash -s" <<< "$remote"
}

# Non-interactive runtime verb on a NixOS-hosted stack (T-092); no TTY, so
# run_logged captures the run. Path mirrors _compose_interactive. 'up' is a
# runtime start, NOT delivery: the compose file only changes via nixos-apply.
_compose_runtime_direct() {
    local action=$1 target_host=$2 stack=$3 service=${4:-}
    local -a dcargs
    case "$action" in
        up)      dcargs=(up -d) ;;
        down)    dcargs=(stop) ;;
        restart) dcargs=(restart) ;;
        pull)    dcargs=(up -d --pull always) ;;
        *) fail "compose: verb '$action' has no direct NixOS path" ;;
    esac
    [[ -n "$service" ]] && dcargs+=("$service")
    local dc_quoted="" tok
    for tok in "${dcargs[@]}"; do dc_quoted+=" $(printf %q "$tok")"; done
    # $HOME stays LITERAL so it expands on the stack host, under the medusa
    # runtime user, where medusa-stacks/<stack> lives (see _compose_interactive
    # for the sudo -H rationale).
    local inner="cd \"\$HOME/medusa-stacks/$(printf %q "$stack")\" && exec docker compose${dc_quoted}"
    local hostcmd="sudo -Hu medusa bash -c $(printf %q "$inner")"
    run_logged "compose-$action-${stack//\//-}" \
        "ssh -o BatchMode=yes $(printf %q "$target_host") $(printf %q "$hostcmd")"
}

# Interactive compose passthrough (T-083). Runs `docker compose <verb>` on the
# host a stack lives on, with the terminal attached end-to-end so streaming
# (`logs -f`), Ctrl-C, and `exec -it` work. Path: workstation -tt-> controller
# -t-> stack host -> `sudo -Hu medusa docker compose`. The controller resolves
# stack->host from `medusa list-stacks` and reaches the host via its ~/.ssh/config
# aliases. Deliberately NOT a generic exec fabric: the verb set is closed.
_compose_interactive() {
    local verb=$1; shift
    local stack="" service="" host=""
    local -a rest=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --) shift; rest=("$@"); break ;;
            --service) shift; [[ -n "${1:-}" ]] || fail "compose $verb: --service requires a name"; service=$1; shift ;;
            --service=*) service=${1#--service=}; [[ -n "$service" ]] || fail "compose $verb: --service requires a name"; shift ;;
            --host) shift; [[ -n "${1:-}" ]] || fail "compose $verb: --host requires a host name"; host=$1; shift ;;
            --host=*) host=${1#--host=}; [[ -n "$host" ]] || fail "compose $verb: --host requires a host name"; shift ;;
            -*) fail "compose $verb: unknown flag '$1' (forward docker flags after --, e.g. -- -f)" ;;
            *) [[ -z "$stack" ]] || fail "compose $verb: unexpected argument '$1' (stack already '$stack'; forward docker args after --)"; stack=$1; shift ;;
        esac
    done
    [[ -n "$stack" ]] || fail "compose $verb: a <stack> is required (run 'medusactl compose list')"
    [[ "$verb" != "exec" || -n "$service" ]] || fail "compose exec: --service <name> is required"
    [[ "$verb" != "exec" || ${#rest[@]} -gt 0 ]] || fail "compose exec: a command is required after -- (e.g. -- bash)"

    # Host-side argv: logs/ps take [forwarded flags...] [service];
    # exec takes service [command...].
    local -a dcargs=("$verb")
    case "$verb" in
        logs|ps)
            dcargs+=("${rest[@]}")
            [[ -n "$service" ]] && dcargs+=("$service")
            ;;
        exec)
            dcargs+=("$service" "${rest[@]}")
            ;;
    esac

    # Inner script runs as the medusa runtime user. -H (not -i): the Debian
    # medusa user is a nologin system account, so a login shell (-i) dies with
    # "This account is currently not available"; -H still sets HOME to
    # medusa's home and `bash -c` runs regardless of the account shell.
    # $HOME is kept LITERAL so it expands there, to medusa's home, where
    # medusa-stacks/<stack> lives (T-047/T-048 deploy root).
    local dc_quoted="" tok
    for tok in "${dcargs[@]}"; do dc_quoted+=" $(printf %q "$tok")"; done
    local inner="cd \"\$HOME/medusa-stacks/$(printf %q "$stack")\" && exec docker compose${dc_quoted}"
    local hostcmd="sudo -Hu medusa bash -c $(printf %q "$inner")"

    # Controller-side: resolve stack->host (unless --host) then hop with a TTY.
    # Passed as the ssh COMMAND (no stdin heredoc) so the terminal stays attached.
    local remote
    remote=$(cat <<'REMOTE'
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
cd "$MEDUSA_CONTROLLER_PATH"
host="$HOST"
if [ -z "$host" ]; then
    matches=$(uv run --quiet medusa list-stacks | awk -F'\t' -v s="$STACK" '$1==s{print $2}')
    n=$(printf '%s' "$matches" | grep -c . || true)
    if [ "$n" -eq 0 ]; then
        echo "compose: stack '$STACK' not found on any host (run 'medusactl compose list')" >&2
        exit 3
    fi
    if [ "$n" -gt 1 ]; then
        echo "compose: stack '$STACK' is on multiple hosts; pass --host <name>:" >&2
        printf '  %s\n' $matches >&2
        exit 4
    fi
    host="$matches"
fi
exec ssh -t "$host" "$HOSTCMD"
REMOTE
)

    local target
    local -a ssh_opts
    target=$(ssh_target)
    mapfile -t ssh_opts < <(ssh_base_opts)
    printf "%s==>%s compose %s %s%s\n" "$color_blue" "$color_reset" \
        "$verb" "$stack" "${service:+ /$service}" >&2
    ssh -tt "${ssh_opts[@]}" "$target" \
        "MEDUSA_CONTROLLER_PATH=$(printf %q "$MEDUSA_CONTROLLER_PATH") \
         MEDUSA_INVENTORY_DIR=$(printf %q "$MEDUSA_CONTROLLER_INVENTORY_PATH/inventory") \
         MEDUSA_SECRETS_DIR=$(printf %q "$MEDUSA_CONTROLLER_INVENTORY_PATH/secrets") \
         MEDUSA_GENERATED_DIR=$(printf %q "$MEDUSA_CONTROLLER_GENERATED_PATH") \
         STACK=$(printf %q "$stack") \
         HOST=$(printf %q "$host") \
         HOSTCMD=$(printf %q "$hostcmd") \
         bash -c $(printf %q "$remote")"
}

cmd_compose() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || -z "${1:-}" ]]; then
        cat <<EOF
medusactl compose <verb> [stack] [--service <name>] [--host <pattern>] [--pull]
                  Drive the Compose runtime lifecycle. Config changes deliver
                  via 'medusactl deploy' / 'nixos-apply'; these verbs change
                  runtime state on the host.

Lifecycle verbs:
  up        RUNTIME start of the flake-materialized generation -- the inverse
            of 'down', e.g. to revive a parked stack; it does NOT deliver
            config edits (that stays 'medusactl deploy' / 'nixos-apply').
  down      Stop a stack's containers.
  restart   Restart stacks.
  pull      Pull newer images and recreate changed containers.
            'compose up <stack> --pull' is the same for one stack.
  list      Print the rendered stacks (stack / host / services / platform /
            state) and exit.

Runtime routing (T-092): up/down/restart/pull resolve the stack on the
controller first, then run 'docker compose' on its host directly over SSH
(up->up -d, down->stop, restart->restart, pull->up -d --pull always) -- no
clean-tree requirement, works mid-edit. The Debian ansible path was retired
with T-096 phase 3; dormant hosts' stacks are skipped with a notice.

Interactive verbs (run 'docker compose' on the target host over SSH; T-083):
  logs      Stream a stack's logs (pass -f to follow, via -- ).
  ps        Show a stack's container status.
  exec      Run a command in a service's container (interactive TTY).

Targeting:
  [stack]            Lifecycle: act on one stack (its path under
                     generated/compose/, e.g. 'media/immich'); omit for all.
                     Interactive verbs REQUIRE a <stack>. 'compose list' lists names.
  --service <name>   Act on one service within the stack (REQUIRED for exec).
  --host <pattern>   Lifecycle: limit to docker hosts matching an Ansible pattern
                     (direct NixOS path: exact host name).
                     Interactive: the host a stack lives on, when it is on >1 host.
  --pull             (up only) force an image re-pull on apply.
  -- <args...>       (interactive only) forward args verbatim to 'docker compose'.

Examples:
  medusactl compose up
  medusactl compose up media/immich --pull
  medusactl compose restart gitea --host host01
  medusactl compose list
  medusactl compose logs media/immich -- -f --tail=100
  medusactl compose logs gitea --service gitea
  medusactl compose ps arr
  medusactl compose exec gitea --service gitea -- bash

Exit codes: 0 success, non-zero on failure.
EOF
        return 0
    fi
    load_config
    local action=$1
    shift

    # 'list' runs on the controller, NOT the workstation: that is where the
    # other verbs act, so the listing matches them. No render, no pull — a
    # fast plain read.
    if [[ "$action" == "list" ]]; then
        [[ "${1:-}" != "--help" && "${1:-}" != "-h" ]] || { echo "medusactl compose list — print rendered stacks (stack / host / services / platform / state)."; return 0; }
        [[ $# -eq 0 ]] || fail "compose list: unexpected argument '$1'"
        local out
        out=$(fetch_stacks) \
            || fail "compose list: 'medusa list-stacks' failed on the controller (is the controller updated? run 'medusactl update')"
        { printf 'STACK\tHOST\tSERVICES\tPLATFORM\tSTATE\n'; printf '%s\n' "$out"; } \
            | { column -t -s "$(printf '\t')" 2>/dev/null || cat; }
        return 0
    fi

    # T-083: logs/ps/exec need a live TTY (stream follow, Ctrl-C, exec -it),
    # which run_logged's log-only capture can't give; see _compose_interactive.
    if [[ "$action" == "logs" || "$action" == "ps" || "$action" == "exec" ]]; then
        _compose_interactive "$action" "$@"
        return $?
    fi

    case "$action" in
        up|down|restart|pull) ;;
        *) fail "compose: unknown verb '$action' (expected up|down|restart|pull|logs|ps|exec|list)" ;;
    esac

    local stack="" service="" host="" pull=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --service) shift; [[ -n "${1:-}" ]] || fail "compose: --service requires a name"; service=$1; shift ;;
            --service=*) service=${1#--service=}; [[ -n "$service" ]] || fail "compose: --service requires a name"; shift ;;
            --host) shift; [[ -n "${1:-}" ]] || fail "compose: --host requires a host pattern"; host=$1; shift ;;
            --host=*) host=${1#--host=}; [[ -n "$host" ]] || fail "compose: --host requires a host pattern"; shift ;;
            --pull) pull=1; shift ;;
            -*) fail "compose: unknown flag '$1'" ;;
            *) [[ -z "$stack" ]] || fail "compose: unexpected argument '$1' (stack already set to '$stack')"; stack=$1; shift ;;
        esac
    done
    [[ -z "$service" || -n "$stack" ]] || fail "compose: --service requires a [stack] target"
    [[ "$pull" -eq 0 || "$action" == "up" ]] || fail "compose: --pull is only valid with 'up' (use the 'pull' verb otherwise)"

    # On the direct NixOS path 'up --pull' and the 'pull' verb are the same
    # docker command (up -d --pull always); fold them so _compose_runtime_direct
    # keeps a closed verb set.
    local direct_action=$action
    [[ "$action" == "up" && "$pull" -eq 1 ]] && direct_action=pull

    # T-092: resolve the target against the controller's stack table BEFORE
    # dispatch. Only the direct NixOS path remains (the ansible plays retired
    # with T-096 phase 3); a non-nixos row is a hard error, never a silent skip.
    local stacks_tsv direct_failures=0
    stacks_tsv=$(fetch_stacks) \
        || fail "compose $action: 'medusa list-stacks' failed on the controller (is the controller updated? run 'medusactl update')"
    if [[ -n "$stack" ]]; then
        local matches
        matches=$(awk -F'\t' -v s="$stack" '$1==s' <<<"$stacks_tsv")
        [[ -n "$matches" ]] || fail "compose $action: stack '$stack' not found on any host (run 'medusactl compose list')"
        if [[ -n "$host" ]]; then
            matches=$(awk -F'\t' -v h="$host" '$2==h' <<<"$matches")
            [[ -n "$matches" ]] || fail "compose $action: stack '$stack' is not on host '$host' (run 'medusactl compose list')"
        fi
        if [[ $(wc -l <<<"$matches") -gt 1 ]]; then
            fail "compose $action: stack '$stack' is on multiple hosts; pass --host <name>:
$(awk -F'\t' '{print "  " $2}' <<<"$matches")"
        fi
        local row_host row_platform row_state
        IFS=$'\t' read -r _ row_host _ row_platform row_state <<<"$matches"
        [[ "$row_platform" == "nixos" ]] \
            || fail "compose $action: '$stack' is on '$row_host' (platform '${row_platform:-?}'); the ansible compose path was retired with T-096 phase 3 — migrate the host to nixos or run docker compose there by hand"
        [[ "$row_state" != "dormant" ]] || fail "compose $action: '$stack' is on '$row_host', which is declared dormant (T-091); wake it in dns.yaml first"
        [[ "$action" != "up" ]] || info "nixos: starting '$stack' from the materialized generation (runtime only; config changes deliver via 'medusactl deploy')"
        _compose_runtime_direct "$direct_action" "$row_host" "$stack" "$service"
        return $?
    else
        # Fleet-wide. Dormant hosts' stacks are declared downtime (T-091):
        # skipped with a notice, never an error. A surviving non-nixos row is
        # a hard error — nothing can deliver to it anymore.
        local nixos_rows legacy_rows dormant_rows
        nixos_rows=$(awk -F'\t' '$4=="nixos" && $5!="dormant"' <<<"$stacks_tsv")
        legacy_rows=$(awk -F'\t' '$4!="nixos" && $5!="dormant"' <<<"$stacks_tsv")
        dormant_rows=$(awk -F'\t' '$5=="dormant"' <<<"$stacks_tsv")
        if [[ -n "$legacy_rows" ]]; then
            fail "compose $action: non-nixos stack(s) in the render; the ansible compose path was retired with T-096 phase 3:
$(awk -F'\t' '{print "  " $1 " (" $2 ")"}' <<<"$legacy_rows")"
        fi
        if [[ -n "$dormant_rows" ]]; then
            local d_stack d_host d_rest
            while IFS=$'\t' read -r d_stack d_host d_rest; do
                info "skipping $d_stack ($d_host is dormant)"
            done <<<"$dormant_rows"
        fi
        if [[ -n "$nixos_rows" ]]; then
            local n_stack n_host n_rest
            while IFS=$'\t' read -r n_stack n_host n_rest; do
                # </dev/null: the inner ssh must not eat the rows this loop
                # is still reading from its own stdin.
                _compose_runtime_direct "$direct_action" "$n_host" "$n_stack" "" </dev/null \
                    || direct_failures=$((direct_failures + 1))
            done <<<"$nixos_rows"
        fi
        [[ "$direct_failures" -eq 0 ]] \
            || fail "compose $action: $direct_failures NixOS-hosted stack(s) failed (see logs above)"
        return 0
    fi
}

