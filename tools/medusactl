                '--managed-only[show only managed hosts]' \
                '--full[show only full managed mode]' \
                '--limited[show only limited managed mode]'
            ;;
        remove-target)
            _arguments \
                '--dry-run[validate and diff without writing]' \
                '--remove-mounts[drop host from storage mount lists]' \
                '--remove-exports[remove storage exports served by host]' \
                '--remove-services[remove services hosted on host]' \
                '--cascade[imply all --remove-* flags]'
            ;;
        completion)
            _arguments '1:shell:(bash zsh fish install)'
            ;;
    esac
}

_medusactl "$@"
EOF
}

