cmd_finalize_dns() {
    load_config
    local resolver="" check=0 force=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --resolver)
                shift
                [[ $# -gt 0 ]] || fail "--resolver requires an IP argument"
                resolver=$1
                ;;
            --resolver=*)
                resolver=${1#--resolver=}
                ;;
            --check)
                check=1
                ;;
            --force)
                force=1
                ;;
            *)
                fail "unknown argument to finalize-dns: $1"
                ;;
        esac
        shift
    done

    require_controller_apply_prereqs finalize-dns \
        || fail "finalize-dns prerequisites failed"

    # The block is validated against the resolver first (unless --force) and
    # removed through the same privileged controller_bootstrap path as apply.
    local remote
    remote=$(cat <<'REMOTE'
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
# T-037 stage D: fast-forward the inventory clone first so renders +
# applies use whatever the workstation has just pushed.
git -C "$MEDUSA_INVENTORY_ROOT" pull --ff-only
cd "$MEDUSA_CONTROLLER_PATH"
RESOLVER=${RESOLVER:-}
CHECK=${CHECK:-0}
FORCE=${FORCE:-0}
BEGIN='# BEGIN MEDUSA BOOTSTRAP (managed by medusa; remove with '"'"'medusactl finalize-dns'"'"')'
END='# END MEDUSA BOOTSTRAP'

if grep -qxF "$BEGIN" /etc/hosts; then
    block=$(sed -n "/^${BEGIN//\//\\/}\$/,/^${END//\//\\/}\$/p" /etc/hosts \
        | sed -e "1d" -e "\$d")
else
    echo "no medusa bootstrap block in /etc/hosts; applying absent state anyway"
    block=""
fi

if [[ -z "$block" ]]; then
    echo "bootstrap block is empty; removing markers only"
fi

if [[ "$FORCE" -ne 1 && -n "$block" ]]; then
    if [[ -z "$RESOLVER" ]]; then
        if command -v resolvectl >/dev/null 2>&1; then
            RESOLVER=$(resolvectl status 2>/dev/null \
                | awk "/Current DNS Server/ {print \$NF; exit}")
        fi
        if [[ -z "$RESOLVER" ]]; then
            RESOLVER=$(awk "/^nameserver/ {print \$2; exit}" /etc/resolv.conf)
        fi
        if [[ -z "$RESOLVER" ]]; then
            echo "could not auto-detect resolver; pass --resolver" >&2
            exit 2
        fi
    fi
    if ! command -v dig >/dev/null 2>&1; then
        echo "dig is required for finalize-dns validation; install dnsutils or use --force" >&2
        exit 3
    fi

    echo "validating against resolver: $RESOLVER"
    fail_count=0
    while read -r ip host name; do
        [[ -z "$ip" ]] && continue
        got=$(dig @"$RESOLVER" +short +time=2 +tries=1 "$host" A | head -n1)
        if [[ -z "$got" ]]; then
            echo "  ✗ $host -> NXDOMAIN (expected $ip)" >&2
            fail_count=$((fail_count + 1))
        elif [[ "$got" != "$ip" ]]; then
            echo "  ✗ $host -> $got (expected $ip)" >&2
            fail_count=$((fail_count + 1))
        else
            echo "  ✓ $host -> $got"
        fi
    done <<< "$block"

    if [[ "$fail_count" -ne 0 ]]; then
        echo "validation failed for $fail_count entries; leaving /etc/hosts unchanged" >&2
        echo "fix the resolver or pass --force to remove the block anyway" >&2
        exit 4
    fi
fi

if [[ "$CHECK" -eq 1 ]]; then
    cd ansible
    uv run ansible-playbook playbooks/controller-apply.yml \
        --check --diff \
        --extra-vars controller_bootstrap_state=absent
else
    cd ansible
    uv run ansible-playbook playbooks/controller-apply.yml \
        --extra-vars controller_bootstrap_state=absent
fi
REMOTE
)

    local target ssh_opts log
    target=$(ssh_target)
    log=$(log_path "finalize-dns")
    mapfile -t ssh_opts < <(ssh_base_opts)

    printf "%s==>%s finalize-dns\n" "$color_blue" "$color_reset"
    printf "remote:  %s:%s\n" "$target" "$MEDUSA_CONTROLLER_PORT"
    printf "log:    %s\n" "$log"

    local env_prefix
    env_prefix=$(printf "MEDUSA_CONTROLLER_PATH=%q MEDUSA_INVENTORY_ROOT=%q MEDUSA_INVENTORY_DIR=%q MEDUSA_SECRETS_DIR=%q MEDUSA_GENERATED_DIR=%q RESOLVER=%q CHECK=%q FORCE=%q" \
        "$MEDUSA_CONTROLLER_PATH" \
        "$MEDUSA_CONTROLLER_INVENTORY_PATH" \
        "$MEDUSA_CONTROLLER_INVENTORY_PATH/inventory" \
        "$MEDUSA_CONTROLLER_INVENTORY_PATH/secrets" \
        "$MEDUSA_CONTROLLER_GENERATED_PATH" \
        "$resolver" "$check" "$force")

    local finalize_rc=0
    ssh -t "${ssh_opts[@]}" "$target" "$env_prefix bash -s" <<< "$remote" 2>&1 | tee "$log" \
        || finalize_rc=${PIPESTATUS[0]}
    sanitize_log "$log"
    if [[ "$finalize_rc" -eq 0 ]]; then
        printf "%s✓%s finalize-dns\n" "$color_green" "$color_reset"
    else
        printf "%s✗%s finalize-dns failed (log: %s)\n" "$color_red" "$color_reset" "$log" >&2
        return 1
    fi
}

# --- NixOS deploy dispatch (T-075) ------------------------------------------
#
# Beside (not replacing) the Ansible path. The fleet partition is the tested
# `medusa nixos-deploy-plan` (Platform Fork Boundary, seam 2): one
# `<host>\t<user@endpoint>` line per reconcilable NixOS host, empty for an
# all-Debian fleet. NixOS atomic activation rolls a bad switch back to the
# prior generation, so this path needs none of the Debian prove-then-consume
# guards.

_nixos_apply_run() {
    # Shared SSH runner for the nixos-rebuild apply. $1 = action
    # ("switch" | "dry-activate"); $2 = refresh ("1" pulls+renders first, "0"
    # trusts a render the caller already did, e.g. cmd_deploy); $3 = limit (an
    # optional host pattern from `deploy --limit` — restricts the reconcile to
    # NixOS hosts whose NAME matches; empty means all NixOS hosts).
    local action=$1 refresh=${2:-1} limit=${3:-}
    local remote
    remote=$(cat <<'REMOTE'
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
cd "$MEDUSA_CONTROLLER_PATH"
if [[ "${REFRESH:-1}" -eq 1 ]]; then
    # Same inventory-fresh discipline as deploy: fast-forward then re-render so
    # the flake we switch to matches what the workstation just pushed.
    git -C "$MEDUSA_INVENTORY_ROOT" pull --ff-only
    uv run medusa render
fi
plan=$(uv run medusa nixos-deploy-plan)
if [[ -z "${plan//[[:space:]]/}" ]]; then
    echo "no NixOS hosts in fleet; nixos-rebuild $ACTION skipped"
    exit 0
fi
if [[ -n "${LIMIT:-}" ]]; then
    # Restrict the reconcile to NixOS hosts named by the deploy --limit pattern.
    # Split on ',' and ':' into match tokens; keep a plan host if it matches a
    # token via shell glob. Group names and negations (!foo, &foo) don't name a
    # NixOS host so they simply won't match here — the Debian deploy still
    # honors the full ansible pattern; target NixOS hosts by name or glob.
    IFS=',:' read -r -a _toks <<< "$LIMIT"
    filtered=""
    while IFS=$'\t' read -r host target; do
        [[ -n "$host" ]] || continue
        for t in "${_toks[@]}"; do
            [[ -n "$t" && "$t" != '!'* && "$t" != '&'* ]] || continue
            # shellcheck disable=SC2053  # intentional glob match
            if [[ "$host" == $t ]]; then
                filtered+="${host}"$'\t'"${target}"$'\n'
                break
            fi
        done
    done <<< "$plan"
    plan=$filtered
    if [[ -z "${plan//[[:space:]]/}" ]]; then
        echo "no NixOS hosts matched --limit '$LIMIT'; nixos-rebuild $ACTION skipped"
        exit 0
    fi
fi
if ! command -v nixos-rebuild >/dev/null 2>&1; then
    echo "nixos-rebuild not found on controller; install Nix to reconcile NixOS hosts" >&2
    exit 70
fi
rc=0
while IFS=$'\t' read -r host target; do
    [[ -n "$host" ]] || continue
    echo "==> nixos-rebuild $ACTION: $host ($target)"
    # The machine at the target must BE the host the flake attribute names;
    # 'nixos' is allowed as the nixos-anywhere installer default on a first
    # deploy (T-098). -n: same stdin rule as the nixos-rebuild call below.
    actual=$(ssh -n -o BatchMode=yes -o ConnectTimeout=10 \
        -o StrictHostKeyChecking=accept-new "$target" \
        cat /proc/sys/kernel/hostname 2>/dev/null | tr -d '[:space:]') || true
    if [[ -z "$actual" ]]; then
        echo "  ✗ $host: hostname preflight could not read /proc/sys/kernel/hostname on $target" >&2
        echo "RESULT $host failed"
        rc=1
        continue
    fi
    if [[ "$actual" != "$host" && "$actual" != "nixos" ]]; then
        echo "  ✗ $host: refusing $ACTION — $target reports hostname '$actual' but the flake attribute names '$host' (cross-wired attr/target pair, T-098)" >&2
        echo "RESULT $host failed"
        rc=1
        continue
    fi
    if [[ "$actual" == "nixos" && "$host" != "nixos" ]]; then
        echo "  hostname preflight: $target reports the installer default 'nixos' (first deploy); proceeding"
    fi
    # Old remote-sudo spelling only: nixos-rebuild re-execs the flake-pinned
    # inner binary with the original argv, and old inner binaries reject
    # --elevate=sudo (T-095). Root targets need no elevation at all.
    flags=()
    [[ "$target" == root@* ]] || flags=(--use-remote-sudo)
    # </dev/null: nixos-rebuild's underlying ssh must not inherit the loop's
    # stdin or it swallows the remaining plan lines (second host never applies).
    if ! nixos-rebuild "$ACTION" \
        --flake "$MEDUSA_GENERATED_DIR/nixos#$host" \
        --target-host "$target" \
        "${flags[@]}" < /dev/null; then
        echo "  ✗ $host: nixos-rebuild $ACTION failed" >&2
        # RESULT lines are the machine-readable per-host recap the workstation
        # formats — sturdier than regexing nix output for outcomes (T-088).
        echo "RESULT $host failed"
        rc=1
    else
        echo "RESULT $host ok"
    fi
done <<< "$plan"
exit $rc
REMOTE
)
    local target ssh_opts log
    target=$(ssh_target)
    log=$(log_path "nixos-apply")
    mapfile -t ssh_opts < <(ssh_base_opts)

    printf "%s==>%s nixos-apply (%s)\n" "$color_blue" "$color_reset" "$action"
    printf "remote:  %s:%s\n" "$target" "$MEDUSA_CONTROLLER_PORT"
    printf "log:    %s\n" "$log"

    local env_prefix
    env_prefix=$(printf "MEDUSA_CONTROLLER_PATH=%q MEDUSA_INVENTORY_ROOT=%q MEDUSA_INVENTORY_DIR=%q MEDUSA_SECRETS_DIR=%q MEDUSA_GENERATED_DIR=%q ACTION=%q REFRESH=%q LIMIT=%q" \
        "$MEDUSA_CONTROLLER_PATH" \
        "$MEDUSA_CONTROLLER_INVENTORY_PATH" \
        "$MEDUSA_CONTROLLER_INVENTORY_PATH/inventory" \
        "$MEDUSA_CONTROLLER_INVENTORY_PATH/secrets" \
        "$MEDUSA_CONTROLLER_GENERATED_PATH" \
        "$action" "$refresh" "$limit")

    # switch runs log-only (spinner on a TTY, plain otherwise) like run_logged;
    # dry-activate still streams — its would-be unit changes ARE the payload
    # the operator asked for (T-088).
    local rc=0
    if [[ "$action" == "switch" && -t 2 ]]; then
        local rc_file="${log}.rc"
        rm -f "$rc_file"
        {
            if ssh "${ssh_opts[@]}" "$target" "$env_prefix bash -s" \
                <<< "$remote" >"$log" 2>&1; then
                echo 0
            else
                echo "$?"
            fi >"$rc_file"
        } &
        local bgpid=$!
        spin_progress "$rc_file" "$log" \
            '^(building|these [0-9]+ derivations|copying|stopping the following|activating the configuration|starting the following)' \
            's/\.\.\.$//' \
            '^==> nixos-rebuild' \
            's/^==> nixos-rebuild [a-z-]+: ([^ ]+).*/\1/'
        wait "$bgpid" 2>/dev/null || true
        rc=$(cat "$rc_file" 2>/dev/null || echo 1)
        rm -f "$rc_file"
    elif [[ "$action" == "switch" ]]; then
        ssh "${ssh_opts[@]}" "$target" "$env_prefix bash -s" \
            <<< "$remote" >"$log" 2>&1 || rc=$?
    else
        ssh -t "${ssh_opts[@]}" "$target" "$env_prefix bash -s" <<< "$remote" 2>&1 | tee "$log" \
            || rc=${PIPESTATUS[0]}
    fi
    sanitize_log "$log"
    if [[ "$rc" -eq 0 ]]; then
        if [[ "$action" == "switch" ]]; then
            local ok_count skip_line
            ok_count=$(awk '$1 == "RESULT" && $3 == "ok" { n++ } END { print n + 0 }' "$log")
            if [[ "$ok_count" -eq 0 ]]; then
                skip_line=$(grep -E 'skipped$' "$log" | head -1 || true)
                printf "%s✓%s nixos-apply%s\n" "$color_green" "$color_reset" \
                    "${skip_line:+ (${skip_line})}"
            else
                printf "%s✓%s nixos-apply (%s switched)\n" \
                    "$color_green" "$color_reset" "$ok_count"
            fi
        else
            printf "%s✓%s nixos-apply\n" "$color_green" "$color_reset"
        fi
        return 0
    fi
    printf "%s✗%s nixos-apply failed\n" "$color_red" "$color_reset" >&2
    summarize_nixos_failure_log "$log"
    return 1
}

cmd_nixos_apply() {
    load_config
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        cat <<EOF
medusactl nixos-apply [--check] [--limit <pattern>] — reconcile NixOS hosts.

Renders, then runs 'nixos-rebuild switch --flake generated/nixos#<host>
--target-host <user@endpoint>' on the controller for every NixOS host in
the fleet (the 'medusa nixos-deploy-plan' partition); non-root targets add
--use-remote-sudo (the re-exec-safe spelling, T-095). 'medusactl deploy'
runs this automatically after controller-apply; use this command to
reconcile NixOS hosts on their own.

Before each switch a hostname preflight asserts the machine at the target
IS the host the flake attribute names (T-098); the only tolerated mismatch
is the nixos-anywhere installer default 'nixos' on a first deploy.

  --check            dry-activate (build + show the activation diff), no switch.
  --limit <pattern>  Reconcile only NixOS hosts whose NAME matches <pattern>
                     (host, comma list, or glob).

Bootstrap a brand-new NixOS box first with 'medusactl install-nixos-target'.
EOF
        return 0
    fi
    local action="switch" limit=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --check) action="dry-activate"; shift ;;
            --limit)
                shift
                [[ -n "${1:-}" ]] || fail "nixos-apply: --limit requires a host pattern"
                limit=$1; shift ;;
            --limit=*)
                limit=${1#--limit=}
                [[ -n "$limit" ]] || fail "nixos-apply: --limit requires a host pattern"
                shift ;;
            *) fail "unknown argument to nixos-apply: $1" ;;
        esac
    done
    require_clean_for_deploy
    _nixos_apply_run "$action" 1 "$limit"
}

cmd_install_nixos_target() {
    load_config
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || -z "${1:-}" ]]; then
        cat <<EOF
medusactl install-nixos-target <host> --ip <addr> [--force] — first-time NixOS
                  stand-up via nixos-anywhere + disko.

Installs NixOS onto a FRESH box from the generated flake, partitioning its disks
declaratively via disko. This runs once per host; ongoing changes use
'medusactl nixos-apply'.

  <host>        flake attribute (generated/nixos#<host>); must already be in
                inventory as platform: nixos and rendered.
  --ip <addr>   address of the fresh box, reachable as root@<addr> (the NixOS
                installer ISO or a kexec'd rescue system).
  --force       skip the confirmation prompt.

WARNING: nixos-anywhere + disko WIPE the target disk. Point this only at a fresh
box with no data — never at a host with a live ZFS pool or other real storage.
EOF
        return 0
    fi

    local host="" ip="" force=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --ip) shift; [[ $# -gt 0 ]] || fail "--ip requires an address"; ip=$1 ;;
            --ip=*) ip=${1#--ip=} ;;
            --force) force=1 ;;
            -*) fail "unknown argument to install-nixos-target: $1" ;;
            *) [[ -z "$host" ]] || fail "unexpected argument: $1"; host=$1 ;;
        esac
        shift
    done
    [[ -n "$host" ]] || fail "install-nixos-target: <host> is required"
    [[ -n "$ip" ]] || fail "install-nixos-target: --ip <addr> is required"

    warn "nixos-anywhere will ERASE all disks on $ip and install NixOS host '$host'."
    if [[ "$force" -ne 1 ]]; then
        confirm "Wipe $ip and install '$host'?" || fail "aborted"
    fi
    require_clean_for_deploy

    local remote
    remote=$(cat <<'REMOTE'
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
git -C "$MEDUSA_INVENTORY_ROOT" pull --ff-only
cd "$MEDUSA_CONTROLLER_PATH"
uv run medusa render
if ! command -v nixos-anywhere >/dev/null 2>&1; then
    echo "nixos-anywhere not found on controller; install it to bootstrap NixOS hosts" >&2
    exit 70
fi
echo "==> nixos-anywhere: installing $HOST onto $TARGET_IP from $MEDUSA_GENERATED_DIR/nixos#$HOST"
nixos-anywhere --flake "$MEDUSA_GENERATED_DIR/nixos#$HOST" "root@$TARGET_IP"
REMOTE
)
    local target ssh_opts log
    target=$(ssh_target)
    log=$(log_path "install-nixos-$host")
    mapfile -t ssh_opts < <(ssh_base_opts)

    printf "%s==>%s install-nixos-target %s -> %s\n" "$color_blue" "$color_reset" "$host" "$ip"
    printf "remote:  %s:%s\n" "$target" "$MEDUSA_CONTROLLER_PORT"
    printf "log:    %s\n" "$log"

    local env_prefix
    env_prefix=$(printf "MEDUSA_CONTROLLER_PATH=%q MEDUSA_INVENTORY_ROOT=%q MEDUSA_INVENTORY_DIR=%q MEDUSA_SECRETS_DIR=%q MEDUSA_GENERATED_DIR=%q HOST=%q TARGET_IP=%q" \
        "$MEDUSA_CONTROLLER_PATH" \
        "$MEDUSA_CONTROLLER_INVENTORY_PATH" \
        "$MEDUSA_CONTROLLER_INVENTORY_PATH/inventory" \
        "$MEDUSA_CONTROLLER_INVENTORY_PATH/secrets" \
        "$MEDUSA_CONTROLLER_GENERATED_PATH" \
        "$host" "$ip")

    local rc=0
    ssh -t "${ssh_opts[@]}" "$target" "$env_prefix bash -s" <<< "$remote" 2>&1 | tee "$log" \
        || rc=${PIPESTATUS[0]}
    sanitize_log "$log"
    if [[ "$rc" -eq 0 ]]; then
        printf "%s✓%s install-nixos-target %s (now reconcile with 'medusactl nixos-apply')\n" \
            "$color_green" "$color_reset" "$host"
        return 0
    fi
    printf "%s✗%s install-nixos-target %s failed (log: %s)\n" "$color_red" "$color_reset" "$host" "$log" >&2
    return 1
}

