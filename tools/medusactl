    printf "%s==>%s build-installer\n" "$color_blue" "$color_reset"
    printf "remote:  %s:%s\n" "$target" "$MEDUSA_CONTROLLER_PORT"
    printf "log:    %s\n" "$log"

    local env_prefix
    env_prefix=$(printf "MEDUSA_CONTROLLER_PATH=%q MEDUSA_INVENTORY_ROOT=%q MEDUSA_INVENTORY_DIR=%q MEDUSA_SECRETS_DIR=%q MEDUSA_GENERATED_DIR=%q" \
        "$MEDUSA_CONTROLLER_PATH" \
        "$MEDUSA_CONTROLLER_INVENTORY_PATH" \
        "$MEDUSA_CONTROLLER_INVENTORY_PATH/inventory" \
        "$MEDUSA_CONTROLLER_INVENTORY_PATH/secrets" \
        "$MEDUSA_CONTROLLER_GENERATED_PATH")

    local rc=0
    ssh -t "${ssh_opts[@]}" "$target" "$env_prefix bash -s" <<< "$remote" 2>&1 | tee "$log" \
        || rc=${PIPESTATUS[0]}
    sanitize_log "$log"
    if [[ "$rc" -eq 0 ]]; then
        printf "%s✓%s build-installer\n" "$color_green" "$color_reset"
        return 0
    fi
    printf "%s✗%s build-installer failed (log: %s)\n" "$color_red" "$color_reset" "$log" >&2
