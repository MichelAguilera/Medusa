#!/usr/bin/env bash
# Optional workstation-side helper for common Medusa controller workflows.

set -euo pipefail

VERSION="0.13.0"
MEDUSA_INSTALL_REF="${MEDUSA_INSTALL_REF:-main}"
MEDUSA_GITHUB_REPO="${MEDUSA_GITHUB_REPO:-MichelAguilera/Medusa}"
MEDUSA_BOOTSTRAP_URL="${MEDUSA_BOOTSTRAP_URL:-https://raw.githubusercontent.com/MichelAguilera/Medusa/${MEDUSA_INSTALL_REF}/tools/bootstrap-controller.sh}"
MEDUSACTL_SOURCE_URL="${MEDUSACTL_SOURCE_URL:-https://raw.githubusercontent.com/MichelAguilera/Medusa/${MEDUSA_INSTALL_REF}/tools/medusactl}"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/medusa"
CONFIG_FILE="${MEDUSACTL_CONFIG:-$CONFIG_DIR/medusactl.env}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/medusa"
LOG_DIR="${MEDUSACTL_LOG_DIR:-$STATE_DIR/logs}"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/medusa"
SSH_MUX_DIR="${CACHE_DIR}/ssh"
SSH_MUX_PERSIST="${MEDUSACTL_SSH_PERSIST:-300}"
SSH_CONFIG="${MEDUSACTL_SSH_CONFIG:-}"
SSH_CONFIG_OPTS=()
if [[ -n "$SSH_CONFIG" ]]; then
    SSH_CONFIG_OPTS=(-F "$SSH_CONFIG")
fi

color_red=$'\033[31m'
color_green=$'\033[32m'
color_yellow=$'\033[33m'
color_blue=$'\033[34m'
color_reset=$'\033[0m'

info() { printf "  %s\n" "$1" >&2; }
warn() { printf "  %s%s%s\n" "$color_yellow" "$1" "$color_reset" >&2; }
fail() {
    printf "%s✗%s medusactl: %s\n" "$color_red" "$color_reset" "$1" >&2
    exit 1
}

usage() {
    cat <<EOF
medusactl v${VERSION}

Usage:

  Controller ops:
    medusactl install-controller
    medusactl authorize-controller
    medusactl controller-status
    medusactl shell
    medusactl config
    medusactl update
    medusactl self-update
    medusactl install-runtime
    medusactl ssh-disconnect
    medusactl clean
    medusactl uninstall

  Local inventory (fdisk-style):
    medusactl status
    medusactl diff
    medusactl commit "msg"
    medusactl push
    medusactl publish "msg"
    medusactl discard

  Render / deploy:
    medusactl check
    medusactl render
    medusactl deploy [--check]
    medusactl controller-apply [--check]

  Target ops:
    medusactl add-target <name> --ip <ip> [--bootstrap-ip <addr>]
                          [--zone <zone>] [--user <user>]
                          [--alias <alias> ...] [--group <group> ...]
                          [--prep] [--authorize] [--no-seed-hosts] [--force]
                          [--dry-run]
    medusactl remove-target <name> [--dry-run]
                            [--remove-mounts] [--remove-exports]
                            [--remove-services] [--cascade]
    medusactl promote-target <name> [--dry-run]
    medusactl list-targets [--managed-only | --full | --limited]
    medusactl add-targets-from-file <path>
    medusactl prep-target <name>
    medusactl authorize-target <name>
    medusactl finalize-dns [--resolver <ip>] [--check] [--force]
    medusactl undo [--dry-run]
    medusactl history [-n <N>]

  Misc:
    medusactl version | --version | -V
    medusactl completion <bash|zsh|fish> [install]
    medusactl completion install

Config:
  $CONFIG_FILE

This is a thin SSH wrapper around known Medusa controller workflows. Direct SSH
to the controller remains fully supported.

Per-subcommand help: medusactl <subcommand> --help
EOF
}

prompt() {
    local var=$1 question=$2 default=${3:-}
    local prompt_text response
    if [[ -n "$default" ]]; then
        prompt_text="$question [$default]: "
    else
        prompt_text="$question: "
    fi
    read -r -p "$prompt_text" response < /dev/tty
    if [[ -z "$response" && -n "$default" ]]; then
        response="$default"
    fi
    printf -v "$var" "%s" "$response"
}

confirm() {
    local question=$1 default=${2:-y}
    local yn_hint response
    [[ "$default" == "y" ]] && yn_hint="Y/n" || yn_hint="y/N"
    read -r -p "$question [$yn_hint]: " response < /dev/tty
    response=${response:-$default}
    [[ "${response,,}" == "y" || "${response,,}" == "yes" ]]
}

home_path() {
    local path=$1
    [[ "$path" == "$HOME" || "$path" == "$HOME/"* ]]
}

quote_env() {
    printf "%q" "$1"
}

write_config() {
    mkdir -p "$CONFIG_DIR"
    chmod 700 "$CONFIG_DIR"
    cat > "$CONFIG_FILE" <<EOF
MEDUSA_CONTROLLER_HOST=$(quote_env "$MEDUSA_CONTROLLER_HOST")
MEDUSA_CONTROLLER_USER=$(quote_env "$MEDUSA_CONTROLLER_USER")
MEDUSA_CONTROLLER_PORT=$(quote_env "$MEDUSA_CONTROLLER_PORT")
MEDUSA_CONTROLLER_PATH=$(quote_env "$MEDUSA_CONTROLLER_PATH")
MEDUSA_CONTROLLER_INVENTORY_PATH=$(quote_env "$MEDUSA_CONTROLLER_INVENTORY_PATH")
MEDUSA_CONTROLLER_GENERATED_PATH=$(quote_env "$MEDUSA_CONTROLLER_GENERATED_PATH")
MEDUSACTL_INVENTORY_DIR=$(quote_env "${MEDUSACTL_INVENTORY_DIR:-}")
EOF
    chmod 600 "$CONFIG_FILE"
}

load_config() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        fail "missing config at $CONFIG_FILE; run 'medusactl install-controller' first"
    fi
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
    : "${MEDUSA_CONTROLLER_HOST:?missing MEDUSA_CONTROLLER_HOST in $CONFIG_FILE}"
    : "${MEDUSA_CONTROLLER_USER:?missing MEDUSA_CONTROLLER_USER in $CONFIG_FILE}"
    : "${MEDUSA_CONTROLLER_PORT:?missing MEDUSA_CONTROLLER_PORT in $CONFIG_FILE}"
    : "${MEDUSA_CONTROLLER_PATH:?missing MEDUSA_CONTROLLER_PATH in $CONFIG_FILE}"
    : "${MEDUSA_CONTROLLER_INVENTORY_PATH:?missing MEDUSA_CONTROLLER_INVENTORY_PATH in $CONFIG_FILE; re-run install-controller}"
    : "${MEDUSA_CONTROLLER_GENERATED_PATH:?missing MEDUSA_CONTROLLER_GENERATED_PATH in $CONFIG_FILE; re-run install-controller}"
    # MEDUSACTL_INVENTORY_DIR is optional at the config layer (controller-side
    # commands work without it). Local mutation commands enforce it via
    # require_local_inventory_dir.
    MEDUSACTL_INVENTORY_DIR="${MEDUSACTL_INVENTORY_DIR:-}"
}

require_local_inventory_dir() {
    # Used by local mutation commands (add/remove/promote-target,
    # status, diff, commit, push, discard) that operate on the
    # workstation's inventory clone rather than SSHing the controller.
    [[ -n "${MEDUSACTL_INVENTORY_DIR:-}" ]] \
        || fail "MEDUSACTL_INVENTORY_DIR is not set in $CONFIG_FILE; re-run 'medusactl install-controller' or edit the config to point at your local inventory clone"
    [[ -d "$MEDUSACTL_INVENTORY_DIR" ]] \
        || fail "MEDUSACTL_INVENTORY_DIR ($MEDUSACTL_INVENTORY_DIR) does not exist; clone the inventory repo there first"
    [[ -d "$MEDUSACTL_INVENTORY_DIR/.git" ]] \
        || fail "MEDUSACTL_INVENTORY_DIR ($MEDUSACTL_INVENTORY_DIR) is not a git checkout; clone the inventory repo there first"
}

ssh_target() {
    printf "%s@%s" "$MEDUSA_CONTROLLER_USER" "$MEDUSA_CONTROLLER_HOST"
}

default_public_key() {
    if [[ -f "$HOME/.ssh/id_ed25519.pub" ]]; then
        printf "%s/.ssh/id_ed25519.pub" "$HOME"
        return 0
    fi
    if [[ -f "$HOME/.ssh/id_rsa.pub" ]]; then
        printf "%s/.ssh/id_rsa.pub" "$HOME"
        return 0
    fi
    return 1
}

ensure_public_key() {
    local public_key private_key
    if public_key=$(default_public_key); then
        printf "%s" "$public_key"
        return 0
    fi

    public_key="$HOME/.ssh/id_ed25519.pub"
    private_key="${public_key%.pub}"
    if ! confirm "No workstation SSH public key found. Generate ~/.ssh/id_ed25519 now" "y"; then
        fail "workstation SSH public key is required"
    fi
    command -v ssh-keygen >/dev/null 2>&1 || fail "ssh-keygen is required to generate an SSH key"
    mkdir -p "$HOME/.ssh"
    chmod 700 "$HOME/.ssh"
    ssh-keygen -t ed25519 -f "$private_key" -N "" -C "${USER:-medusa}@$(hostname)-medusactl" \
        || fail "failed to generate $private_key"
    printf "%s" "$public_key"
}

authorize_key_on_controller() {
    local target=$1 port=$2 public_key=$3
    [[ -f "$public_key" ]] || fail "SSH public key not found at $public_key"

    info "Authorizing workstation key on $target"
    if command -v ssh-copy-id >/dev/null 2>&1 && [[ -z "$SSH_CONFIG" ]]; then
        ssh-copy-id -p "$port" -i "$public_key" "$target" \
            || fail "ssh-copy-id failed for $target"
        return 0
    fi

    if ! command -v ssh-copy-id >/dev/null 2>&1; then
        warn "ssh-copy-id not found; falling back to direct authorized_keys append"
    else
        warn "MEDUSACTL_SSH_CONFIG is set; falling back to direct authorized_keys append"
    fi
    cat "$public_key" | ssh "${SSH_CONFIG_OPTS[@]}" -p "$port" -o StrictHostKeyChecking=accept-new \
        "$target" 'key=$(cat); umask 077; mkdir -p ~/.ssh; touch ~/.ssh/authorized_keys; grep -qxF "$key" ~/.ssh/authorized_keys || printf "%s\n" "$key" >> ~/.ssh/authorized_keys' \
        || fail "failed to authorize key on $target"
}

ssh_mux_opts() {
    # Persistent SSH connection multiplexing across medusactl invocations.
    # The first call to a given target opens a master and writes a Unix
    # socket under SSH_MUX_DIR; subsequent calls reuse it, eliminating
    # per-command handshake latency. ControlPersist resets each command,
    # so a 5-minute idle window covers bursty workflows without leaking
    # sockets after the operator walks away.
    #
    # When the operator has supplied their own SSH config via
    # MEDUSACTL_SSH_CONFIG, defer to it entirely instead of overriding
    # ControlPath/ControlMaster.
    [[ -z "$SSH_CONFIG" ]] || return 0
    mkdir -p "$SSH_MUX_DIR" 2>/dev/null || return 0
    chmod 700 "$SSH_MUX_DIR" 2>/dev/null || true
    printf "%s\n" \
        -o ControlMaster=auto \
        -o "ControlPersist=${SSH_MUX_PERSIST}" \
        -o "ControlPath=${SSH_MUX_DIR}/cp-%C"
}

ssh_base_opts() {
    printf "%s\n" "${SSH_CONFIG_OPTS[@]}" -p "$MEDUSA_CONTROLLER_PORT" -o StrictHostKeyChecking=accept-new
    ssh_mux_opts
}

remote_command() {
    local command=$1
    # Export both the inventory repo root (for ansible group_vars +
    # secrets lookup) and the inventory subdir (for the medusa CLI's
    # ProjectPaths override). MEDUSA_GENERATED_DIR is consumed by both
    # the medusa CLI and ansible's group_vars/all.yml.
    #
    # ANSIBLE_INVENTORY overrides ansible.cfg's hardcoded relative
    # path ('../generated/ansible/inventory/...') which became wrong
    # after T-038 moved generated/ out of the code repo and into the
    # XDG state dir. ansible.cfg can't expand env vars, so the only
    # robust knob is ANSIBLE_INVENTORY (which ansible reads first).
    printf 'export PATH="$HOME/.local/bin:$PATH"; export MEDUSA_INVENTORY_ROOT=%q; export MEDUSA_INVENTORY_DIR=%q; export MEDUSA_SECRETS_DIR=%q; export MEDUSA_GENERATED_DIR=%q; export ANSIBLE_INVENTORY=%q,%q; cd %q && %s' \
        "$MEDUSA_CONTROLLER_INVENTORY_PATH" \
        "$MEDUSA_CONTROLLER_INVENTORY_PATH/inventory" \
        "$MEDUSA_CONTROLLER_INVENTORY_PATH/secrets" \
        "$MEDUSA_CONTROLLER_GENERATED_PATH" \
        "$MEDUSA_CONTROLLER_GENERATED_PATH/ansible/inventory/hosts.ini" \
        "$MEDUSA_CONTROLLER_GENERATED_PATH/ansible/inventory/medusa-groups.yml" \
        "$MEDUSA_CONTROLLER_PATH" \
        "$command"
}

log_path() {
    local name=$1 stamp
    stamp=$(date +%Y%m%d-%H%M%S)
    mkdir -p "$LOG_DIR"
    printf "%s/%s-%s.log" "$LOG_DIR" "$stamp" "$name"
}

sanitize_log() {
    # Strip ANSI CSI escape sequences (\e[...m and friends) and OSC strings
    # (\e]...\a) that ssh -t round-trips from terminal queries. Best-effort:
    # leaves the log intact if perl is unavailable. Editing in place.
    local file=$1
    [[ -f "$file" ]] || return 0
    if command -v perl >/dev/null 2>&1; then
        perl -i -pe '
            s/\e\[[0-9;?]*[a-zA-Z]//g;
            s/\e\][^\a]*\a//g;
            s/\e[NOPM]//g;
            s/\r$//g;
        ' "$file" 2>/dev/null || true
    fi
}

run_logged() {
    local name=$1 command=$2 target log remote
    local -a ssh_opts
    target=$(ssh_target)
    log=$(log_path "$name")
    remote=$(remote_command "$command")
    mapfile -t ssh_opts < <(ssh_base_opts)

    printf "%s==>%s %s\n" "$color_blue" "$color_reset" "$name"
    printf "remote:  %s:%s\n" "$target" "$MEDUSA_CONTROLLER_PORT"
    printf "workdir: %s\n" "$MEDUSA_CONTROLLER_PATH"
    printf "command: %s\n" "$command"
    printf "log:    %s\n" "$log"

    if [[ ! -t 0 ]]; then
        ssh_opts+=(-o BatchMode=yes)
    fi

    info "Checking SSH access..."
    if ! ssh "${ssh_opts[@]}" -o ConnectTimeout=10 "$target" true >/dev/null 2>&1; then
        fail "unable to connect to $target over SSH"
    fi

    if ssh "${ssh_opts[@]}" "$target" "$remote" >"$log" 2>&1; then
        printf "%s✓%s %s\n" "$color_green" "$color_reset" "$name"
        return 0
    fi

    printf "%s✗%s %s failed\n" "$color_red" "$color_reset" "$name" >&2
    printf "log: %s\n" "$log" >&2
    printf "\nLast output:\n" >&2
    tail -40 "$log" >&2 || true
    return 1
}

require_controller_apply_prereqs() {
    local name=$1 target remote output
    local -a ssh_opts
    target=$(ssh_target)
    mapfile -t ssh_opts < <(ssh_base_opts)

    if [[ ! -t 0 ]]; then
        ssh_opts+=(-o BatchMode=yes)
    fi

    remote=$(cat <<'REMOTE'
set -euo pipefail
cd "$MEDUSA_CONTROLLER_PATH"

if [[ ! -f ansible/playbooks/controller-apply.yml ]]; then
    echo "controller checkout is missing ansible/playbooks/controller-apply.yml" >&2
    echo "run 'medusactl update' so the controller checkout includes the Ansible apply playbook" >&2
    exit 21
fi

if [[ ! -f ansible/roles/controller_bootstrap/tasks/main.yml ]]; then
    echo "controller checkout is missing ansible/roles/controller_bootstrap/tasks/main.yml" >&2
    echo "run 'medusactl update' so the controller checkout includes the controller_bootstrap role" >&2
    exit 22
fi

if ! sudo -n /bin/sh -c true >/dev/null 2>&1; then
    echo "controller apply needs passwordless sudo for $USER" >&2
    echo "re-run tools/bootstrap-controller.sh on the controller, or install" >&2
    echo "/etc/sudoers.d/medusa-controller-bootstrap containing:" >&2
    echo "  $USER ALL=(ALL) NOPASSWD: ALL" >&2
    exit 23
fi
REMOTE
)

    if output=$(ssh "${ssh_opts[@]}" "$target" "MEDUSA_CONTROLLER_PATH=$(printf %q "$MEDUSA_CONTROLLER_PATH") bash -s" <<< "$remote" 2>&1); then
        return 0
    fi

    printf "%s✗%s %s prerequisites failed\n" "$color_red" "$color_reset" "$name" >&2
    printf "%s\n" "$output" >&2
    return 1
}

fetch_file() {
    local label=$1 local_path=$2 url=$3 repo_path=$4 dest=$5

    if [[ -n "$local_path" && -f "$local_path" ]]; then
        cp "$local_path" "$dest" || fail "failed to copy $label from $local_path"
        return 0
    fi

    if command -v curl >/dev/null 2>&1; then
        info "Downloading $label from $url"
        if curl -fsSL "$url" -o "$dest"; then
            return 0
        fi
        warn "raw $label download failed; trying authenticated GitHub CLI fallback"
    fi

    if command -v gh >/dev/null 2>&1; then
        info "Downloading $label through gh api from $MEDUSA_GITHUB_REPO@$MEDUSA_INSTALL_REF"
        gh api "repos/${MEDUSA_GITHUB_REPO}/contents/${repo_path}?ref=${MEDUSA_INSTALL_REF}" \
            --jq .content | base64 -d > "$dest" \
            || fail "failed to download $label with gh api"
        return 0
    fi

    fail "failed to download $label; install curl for public repos or gh for private repos"
}

bootstrap_source() {
    # Fetch the controller bootstrap script (controller-only post Stage 3;
    # target ops live in this CLI, not in the bootstrap).
    local script_dir="" local_bootstrap=""
    if [[ -n "${BASH_SOURCE[0]:-}" && -f "${BASH_SOURCE[0]}" ]]; then
        script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
    fi

    if [[ -n "$script_dir" ]]; then
        if [[ -f "$script_dir/bootstrap-controller.sh" ]]; then
            local_bootstrap="$script_dir/bootstrap-controller.sh"
        elif [[ -f "$script_dir/tools/bootstrap-controller.sh" ]]; then
            local_bootstrap="$script_dir/tools/bootstrap-controller.sh"
        fi
    fi

    local tmp_bootstrap
    tmp_bootstrap=$(mktemp)
    TEMP_FILES+=("$tmp_bootstrap")

    fetch_file "controller bootstrap" "$local_bootstrap" "$MEDUSA_BOOTSTRAP_URL" \
        "tools/bootstrap-controller.sh" "$tmp_bootstrap"

    printf "%s" "$tmp_bootstrap"
}

medusactl_source() {
    local tmp_cli
    tmp_cli=$(mktemp)
    TEMP_FILES+=("$tmp_cli")

    if command -v curl >/dev/null 2>&1; then
        info "Downloading medusactl from $MEDUSACTL_SOURCE_URL"
        if curl -fsSL "$MEDUSACTL_SOURCE_URL" -o "$tmp_cli"; then
            printf "%s" "$tmp_cli"
            return 0
        fi
        warn "raw medusactl download failed; trying authenticated GitHub CLI fallback"
    fi

    if command -v gh >/dev/null 2>&1; then
        info "Downloading medusactl through gh api from $MEDUSA_GITHUB_REPO@$MEDUSA_INSTALL_REF"
        gh api "repos/${MEDUSA_GITHUB_REPO}/contents/tools/medusactl?ref=${MEDUSA_INSTALL_REF}" \
            --jq .content | base64 -d > "$tmp_cli" \
            || fail "failed to download medusactl with gh api"
        printf "%s" "$tmp_cli"
        return 0
    fi

    fail "failed to download medusactl; install curl for public repos or gh for private repos"
}

check_workstation_dependencies() {
    command -v ssh >/dev/null 2>&1 || fail "ssh is required on the workstation"
    command -v scp >/dev/null 2>&1 || fail "scp is required on the workstation"
}

controller_preflight() {
    local target=$1 port=$2
    info "Checking SSH connectivity..."
    ssh -n "${SSH_CONFIG_OPTS[@]}" -p "$port" -o StrictHostKeyChecking=accept-new \
        "$target" 'printf "controller-ssh-ok\n"' >/dev/null \
        || fail "unable to connect to $target over SSH"

    info "Checking controller prerequisites..."
    ssh "${SSH_CONFIG_OPTS[@]}" -p "$port" -o StrictHostKeyChecking=accept-new "$target" 'bash -s' <<'REMOTE_PREFLIGHT' \
        || fail "controller prerequisite check failed"
set -euo pipefail
command -v sh >/dev/null 2>&1 || { echo "missing sh" >&2; exit 10; }
command -v bash >/dev/null 2>&1 || { echo "missing bash" >&2; exit 11; }
command -v sudo >/dev/null 2>&1 || { echo "missing sudo" >&2; exit 12; }
timeout 5 bash -c "</dev/tcp/1.1.1.1/80" >/dev/null 2>&1 || {
    echo "no outbound IPv4 connectivity" >&2
    exit 13
}
getent hosts deb.debian.org >/dev/null 2>&1 || {
    echo "cannot resolve deb.debian.org" >&2
    exit 14
}
sudo -n true >/dev/null 2>&1 || {
    echo "sudo is present; controller bootstrap may prompt for the sudo password" >&2
}
REMOTE_PREFLIGHT
}

cmd_install_controller() {
    check_workstation_dependencies

    local controller_host controller_user controller_port remote_script target bootstrap
    local controller_path controller_inventory_path controller_generated_path local_inventory_dir log
    local -a ssh_opts scp_opts

    echo "Medusa controller install"
    echo ""
    prompt controller_host "Controller hostname or IP"
    prompt controller_user "Controller SSH user" "ansible"
    prompt controller_port "Controller SSH port" "22"
    prompt remote_script "Remote bootstrap script path" "~/medusa-bootstrap-controller.sh"
    prompt controller_path "Controller code repo path after bootstrap" "/home/${controller_user}/Medusa"
    prompt controller_inventory_path "Controller inventory repo path" "/home/${controller_user}/medusa-inventory"
    prompt controller_generated_path "Controller generated artifacts path" "/home/${controller_user}/.local/state/medusa/generated"
    prompt local_inventory_dir "Workstation inventory clone path (blank to skip; needed for local mutation commands)" ""

    [[ -n "$controller_host" ]] || fail "controller hostname or IP is required"
    [[ -n "$controller_user" ]] || fail "controller SSH user is required"
    [[ "$controller_port" =~ ^[0-9]+$ ]] || fail "controller SSH port must be a number"

    bootstrap=$(bootstrap_source)
    target="${controller_user}@${controller_host}"
    SSH_TARGET="$target"
    CONTROL_DIR=$(mktemp -d)
    CONTROL_PATH="${CONTROL_DIR}/ssh-control"
    ssh_opts=(
        -p "$controller_port"
        "${SSH_CONFIG_OPTS[@]}"
        -o StrictHostKeyChecking=accept-new
        -o ControlMaster=auto
        -o ControlPersist=10m
        -o ControlPath="$CONTROL_PATH"
    )
    scp_opts=(
        -P "$controller_port"
        "${SSH_CONFIG_OPTS[@]}"
        -o StrictHostKeyChecking=accept-new
        -o ControlMaster=auto
        -o ControlPersist=10m
        -o ControlPath="$CONTROL_PATH"
    )

    echo ""
    info "About to:"
    info "  Connect to: $target"
    info "  SSH port:   $controller_port"
    info "  Copy:       $bootstrap"
    info "  Remote:     $remote_script"
    info "  Run:        bash $remote_script"
    info "  Code path:     $controller_path"
    info "  Inventory:     $controller_inventory_path"
    info "  Generated:     $controller_generated_path"
    info "  Local inv dir: ${local_inventory_dir:-(unset; local mutation commands disabled)}"
    echo ""
    confirm "Proceed" "y" || fail "aborted by user"

    if confirm "Authorize this workstation's SSH key on the controller now" "y"; then
        authorize_key_on_controller "$target" "$controller_port" "$(ensure_public_key)"
    fi

    info "Checking SSH connectivity..."
    ssh -n "${ssh_opts[@]}" "$target" 'printf "controller-ssh-ok\n"' >/dev/null \
        || fail "unable to connect to $target over SSH"

    info "Checking controller prerequisites..."
    ssh "${ssh_opts[@]}" "$target" 'bash -s' <<'REMOTE_PREFLIGHT' \
        || fail "controller prerequisite check failed"
set -euo pipefail
command -v sh >/dev/null 2>&1 || { echo "missing sh" >&2; exit 10; }
command -v bash >/dev/null 2>&1 || { echo "missing bash" >&2; exit 11; }
command -v sudo >/dev/null 2>&1 || { echo "missing sudo" >&2; exit 12; }
timeout 5 bash -c "</dev/tcp/1.1.1.1/80" >/dev/null 2>&1 || {
    echo "no outbound IPv4 connectivity" >&2
    exit 13
}
getent hosts deb.debian.org >/dev/null 2>&1 || {
    echo "cannot resolve deb.debian.org" >&2
    exit 14
}
sudo -n true >/dev/null 2>&1 || {
    echo "sudo is present; controller bootstrap may prompt for the sudo password" >&2
}
REMOTE_PREFLIGHT

    info "Copying controller bootstrap..."
    scp "${scp_opts[@]}" "$bootstrap" "$target:$remote_script" \
        || fail "failed to copy bootstrap script to controller"

    log=$(log_path install-controller)
    info "Running controller bootstrap on $target"
    info "Log: $log"
    echo ""
    local install_rc=0
    ssh -t "${ssh_opts[@]}" "$target" "bash $remote_script" < /dev/tty 2>&1 | tee "$log" \
        || install_rc=${PIPESTATUS[0]}
    # ssh -t round-trips TTY control sequences (cursor position, color
    # queries, OSC title sets) into the log AND leaves stray OSC responses
    # in the input buffer that pollute the next shell prompt.
    sanitize_log "$log"
    stty sane 2>/dev/null || true
    (printf '\033[0m' >/dev/tty) 2>/dev/null || true
    if [[ "$install_rc" -ne 0 ]]; then
        printf "%s✗%s install-controller failed\n" "$color_red" "$color_reset" >&2
        printf "log: %s\n" "$log" >&2
        exit 1
    fi

    MEDUSA_CONTROLLER_HOST="$controller_host"
    MEDUSA_CONTROLLER_USER="$controller_user"
    MEDUSA_CONTROLLER_PORT="$controller_port"
    MEDUSA_CONTROLLER_PATH="$controller_path"
    MEDUSA_CONTROLLER_INVENTORY_PATH="$controller_inventory_path"
    MEDUSA_CONTROLLER_GENERATED_PATH="$controller_generated_path"
    MEDUSACTL_INVENTORY_DIR="$local_inventory_dir"
    write_config

    echo ""
    printf "%s✓%s install-controller complete\n" "$color_green" "$color_reset"
    printf "config: %s\n" "$CONFIG_FILE"
}

cmd_authorize_controller() {
    local controller_host controller_user controller_port target public_key

    if [[ -f "$CONFIG_FILE" ]]; then
        load_config
        controller_host="$MEDUSA_CONTROLLER_HOST"
        controller_user="$MEDUSA_CONTROLLER_USER"
        controller_port="$MEDUSA_CONTROLLER_PORT"
    else
        prompt controller_host "Controller hostname or IP"
        prompt controller_user "Controller SSH user" "ansible"
        prompt controller_port "Controller SSH port" "22"
    fi

    [[ -n "$controller_host" ]] || fail "controller hostname or IP is required"
    [[ -n "$controller_user" ]] || fail "controller SSH user is required"
    [[ "$controller_port" =~ ^[0-9]+$ ]] || fail "controller SSH port must be a number"

    public_key=$(ensure_public_key)
    target="${controller_user}@${controller_host}"
    authorize_key_on_controller "$target" "$controller_port" "$public_key"
    printf "%s✓%s authorized %s on %s\n" "$color_green" "$color_reset" "$public_key" "$target"
}

cmd_version() {
    printf "medusactl %s\n" "$VERSION"
}

cmd_status() {
    # T-037 stage C: fdisk-style local status. Shows the workstation
    # inventory clone's pending changes, validates them, and reports
    # ahead/behind vs origin/main. For the controller-side status
    # (git HEAD on controller + medusa check there), see
    # 'medusactl controller-status'.
    load_config
    require_local_inventory_dir
    printf "%s==>%s status (local: %s)\n" "$color_blue" "$color_reset" "$MEDUSACTL_INVENTORY_DIR"

    local branch ahead behind dirty
    branch=$(git -C "$MEDUSACTL_INVENTORY_DIR" branch --show-current 2>/dev/null || true)
    [[ -n "$branch" ]] || branch="(detached HEAD)"
    printf "branch:    %s\n" "$branch"

    # Fetch quietly so ahead/behind reflects the remote without
    # interactive prompts. Soft-fail on no network.
    git -C "$MEDUSACTL_INVENTORY_DIR" fetch --quiet origin 2>/dev/null || \
        warn "could not fetch origin; ahead/behind may be stale"

    if git -C "$MEDUSACTL_INVENTORY_DIR" rev-parse --verify --quiet origin/main >/dev/null; then
        ahead=$(git -C "$MEDUSACTL_INVENTORY_DIR" rev-list --count origin/main..HEAD 2>/dev/null || echo 0)
        behind=$(git -C "$MEDUSACTL_INVENTORY_DIR" rev-list --count HEAD..origin/main 2>/dev/null || echo 0)
        printf "vs origin/main: ahead=%s behind=%s\n" "$ahead" "$behind"
    else
        printf "vs origin/main: (no upstream tracking)\n"
    fi

    local porcelain
    porcelain=$(git -C "$MEDUSACTL_INVENTORY_DIR" status --porcelain 2>/dev/null)
    if [[ -z "$porcelain" ]]; then
        dirty=0
        printf "working tree: clean\n"
    else
        dirty=1
        printf "working tree:\n"
        printf "%s\n" "$porcelain" | sed 's/^/  /'
    fi

    printf "\n%s==>%s medusa validate (local)\n" "$color_blue" "$color_reset"
    ( cd "$MEDUSACTL_INVENTORY_DIR" \
        && MEDUSA_INVENTORY_DIR="$MEDUSACTL_INVENTORY_DIR/inventory" \
           MEDUSA_SECRETS_DIR="$MEDUSACTL_INVENTORY_DIR/secrets" \
           medusa validate ) || return 1
}

cmd_controller_status() {
    # The pre-T-037 'status' command: SSH to controller, print git HEAD
    # and branch, run 'medusa check' there.
    load_config
    local target remote
    local -a ssh_opts
    target=$(ssh_target)
    remote=$(remote_command 'printf "repo: "; pwd; printf "git: "; git rev-parse --short HEAD; printf "branch: "; git branch --show-current; uv run --quiet medusa check')
    mapfile -t ssh_opts < <(ssh_base_opts)
    if [[ ! -t 0 ]]; then
        ssh_opts+=(-o BatchMode=yes)
    fi
    printf "%s==>%s controller-status\n" "$color_blue" "$color_reset"
    printf "remote:  %s:%s\n" "$target" "$MEDUSA_CONTROLLER_PORT"
    printf "workdir: %s\n" "$MEDUSA_CONTROLLER_PATH"
    ssh "${ssh_opts[@]}" "$target" "$remote"
}

cmd_diff() {
    # T-037 stage C: colorized git diff of pending inventory changes.
    load_config
    require_local_inventory_dir
    git -C "$MEDUSACTL_INVENTORY_DIR" diff --color=auto "$@"
}

cmd_commit() {
    # T-037 stage C: show diff first, prompt Y/n, then commit. Refuses
    # on empty working tree.
    load_config
    require_local_inventory_dir
    local msg=${1:-}
    [[ -n "$msg" ]] || fail "commit: message argument is required: medusactl commit \"...\""

    local porcelain
    porcelain=$(git -C "$MEDUSACTL_INVENTORY_DIR" status --porcelain 2>/dev/null)
    [[ -n "$porcelain" ]] || fail "commit: working tree is clean; nothing to commit"

    printf "%s==>%s pending diff in %s\n" "$color_blue" "$color_reset" "$MEDUSACTL_INVENTORY_DIR"
    git -C "$MEDUSACTL_INVENTORY_DIR" diff --color=auto
    git -C "$MEDUSACTL_INVENTORY_DIR" status --short

    confirm "Commit with message \"$msg\"" "y" || fail "commit aborted by user"

    git -C "$MEDUSACTL_INVENTORY_DIR" add -A \
        || fail "commit: git add failed"
    git -C "$MEDUSACTL_INVENTORY_DIR" commit -m "$msg" \
        || fail "commit: git commit failed"
    printf "%s✓%s commit\n" "$color_green" "$color_reset"
}

cmd_push() {
    # T-037 stage C: push to origin/main. Refuses on dirty working tree.
    load_config
    require_local_inventory_dir
    local porcelain
    porcelain=$(git -C "$MEDUSACTL_INVENTORY_DIR" status --porcelain 2>/dev/null)
    [[ -z "$porcelain" ]] \
        || fail "push: working tree is dirty; commit or discard before pushing"
    printf "%s==>%s git push origin main\n" "$color_blue" "$color_reset"
    git -C "$MEDUSACTL_INVENTORY_DIR" push origin main \
        || fail "push: git push failed"
    printf "%s✓%s push\n" "$color_green" "$color_reset"
}

cmd_publish() {
    # T-037 stage C: sugar for commit + push in one shot.
    cmd_commit "$@" && cmd_push
}

cmd_discard() {
    # T-037 stage C: 'git checkout -- .' against the inventory clone.
    # Y/n confirmation. Aborts on empty working tree.
    load_config
    require_local_inventory_dir
    local porcelain
    porcelain=$(git -C "$MEDUSACTL_INVENTORY_DIR" status --porcelain 2>/dev/null)
    [[ -n "$porcelain" ]] || fail "discard: working tree is clean; nothing to discard"
    printf "%s==>%s pending changes in %s\n" "$color_blue" "$color_reset" "$MEDUSACTL_INVENTORY_DIR"
    printf "%s\n" "$porcelain" | sed 's/^/  /'
    confirm "Discard all pending changes" "n" || fail "discard aborted by user"
    git -C "$MEDUSACTL_INVENTORY_DIR" checkout -- . \
        || fail "discard: git checkout failed"
    git -C "$MEDUSACTL_INVENTORY_DIR" clean -fd \
        || fail "discard: git clean failed"
    printf "%s✓%s discard\n" "$color_green" "$color_reset"
}

cmd_shell() {
    load_config
    local target
    local -a ssh_opts
    [[ -t 0 ]] || fail "shell requires an interactive terminal"
    target=$(ssh_target)
    mapfile -t ssh_opts < <(ssh_base_opts)
    printf "Opening shell on %s at %s\n" "$target" "$MEDUSA_CONTROLLER_PATH"
    ssh -t "${ssh_opts[@]}" \
        "$target" "cd $(printf "%q" "$MEDUSA_CONTROLLER_PATH") && exec bash -l"
}

cmd_config() {
    load_config
    cat <<EOF
Config:        $CONFIG_FILE
Host:          $MEDUSA_CONTROLLER_HOST
User:          $MEDUSA_CONTROLLER_USER
Port:          $MEDUSA_CONTROLLER_PORT
Code:          $MEDUSA_CONTROLLER_PATH
Inventory:     $MEDUSA_CONTROLLER_INVENTORY_PATH
Generated:     $MEDUSA_CONTROLLER_GENERATED_PATH
Local inv dir: ${MEDUSACTL_INVENTORY_DIR:-(unset)}
EOF
}

cmd_check() {
    load_config
    run_logged check "$(inventory_pull_cmd)uv run medusa check"
    cmd_audit_targets || true
}

# Audit SSH hardening across the managed targets. Pulls the host list
# from 'medusa list-hosts --managed-only' so the mode prefix (F/L) is
# available per row. 'full' hosts get the sshd + root-account probe;
# 'limited' hosts get reachability + sudo only, since their hardening
# surface is the operator's responsibility and is intentionally out of
# medusa's audit scope. Warns on findings; does not fail the overall
# check.
cmd_audit_targets() {
    local target log
    target=$(ssh_target)
    log=$(log_path "audit-targets")

    local remote
    remote=$(cat <<REMOTE
set -uo pipefail
export PATH="\$HOME/.local/bin:\$PATH"
export MEDUSA_INVENTORY_ROOT=$(printf %q "$MEDUSA_CONTROLLER_INVENTORY_PATH")
export MEDUSA_INVENTORY_DIR=$(printf %q "$MEDUSA_CONTROLLER_INVENTORY_PATH/inventory")
export MEDUSA_SECRETS_DIR=$(printf %q "$MEDUSA_CONTROLLER_INVENTORY_PATH/secrets")
export MEDUSA_GENERATED_DIR=$(printf %q "$MEDUSA_CONTROLLER_GENERATED_PATH")
cd "$MEDUSA_CONTROLLER_PATH"
hosts=\$(uv run --quiet medusa list-hosts --managed-only) || {
    echo "audit: medusa list-hosts --managed-only failed on controller" >&2
    exit 0
}
REMOTE
)
    remote+=$'\n'
    remote+=$(cat <<'REMOTE'
findings=0
checked=0
while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    # Skip rows that don't start with the managed-mode prefix letter.
    [[ "$line" =~ ^[FL][[:space:]] ]] || continue

    mode=$(awk '{print $1}' <<< "$line")
    name=$(awk '{print $2}' <<< "$line")
    ip=$(awk '{print $3}' <<< "$line")
    user=$(awk '{for(i=1;i<=NF;i++) if($i~/^user=/){sub(/^user=/,"",$i); print $i}}' <<< "$line")
    [[ -z "$user" ]] && user="ansible"
    [[ -z "$ip" || -z "$name" ]] && continue

    checked=$((checked + 1))

    if [[ "$mode" == "L" ]]; then
        # Limited mode: reachability + sudo only. Hardening checks belong
        # to the operator, not medusa.
        # -n: don't read from stdin, otherwise ssh swallows the outer
        # 'read -r line' loop's heredoc and the loop exits after the
        # first iteration.
        # Use hostname (not ip) so the controller's /etc/hosts
        # bootstrap block (bootstrap_ip override) routes the
        # connection during the cutover phase. /etc/hosts -> DNS
        # fallback keeps this correct when bootstrap_ip is unset.
        if ssh -n -o BatchMode=yes -o ConnectTimeout=5 \
                -o StrictHostKeyChecking=accept-new "${user}@${name}" \
                'sudo -n true' >/dev/null 2>&1; then
            printf "  ✓ %s (%s@%s): reachable + sudo ok (limited; hardening checks skipped)\n" \
                "$name" "$user" "$ip"
        else
            printf "  ! %s (%s@%s): unreachable or sudo -n unavailable (limited)\n" \
                "$name" "$user" "$ip"
            findings=$((findings + 1))
        fi
        continue
    fi

    # Full mode: existing sshd + root-account probe.
    # -n: see L-mode comment above. Hostname target: same reason.
    sshd_out=$(ssh -n -o BatchMode=yes -o ConnectTimeout=5 \
        -o StrictHostKeyChecking=accept-new "${user}@${name}" \
        'sudo -n sshd -T 2>/dev/null; echo "---"; sudo -n passwd -S root 2>/dev/null' \
        2>/dev/null) || {
        printf "  ! %s (%s@%s): unreachable or sudo -n unavailable\n" \
            "$name" "$user" "$ip"
        findings=$((findings + 1))
        continue
    }

    permit=$(awk -F= '
        BEGIN { val = "?" }
        /^---$/ { exit }
        tolower($1) ~ /^permitrootlogin[[:space:]]*$/ { val = $2; next }
        /^[[:space:]]*permitrootlogin[[:space:]]/ {
            sub(/^[[:space:]]*permitrootlogin[[:space:]]+/, "", $0)
            val = $0
        }
        END { print val }
    ' <<< "$sshd_out")
    [[ "$permit" == "?" ]] && permit=$(grep -i '^permitrootlogin ' <<< "$sshd_out" | awk '{print $2}' | head -n1)
    [[ -z "$permit" ]] && permit="?"

    root_status=$(awk '/^---$/{flag=1; next} flag' <<< "$sshd_out" | awk '{print $2}' | head -n1)
    [[ -z "$root_status" ]] && root_status="?"

    bad=()
    case "$permit" in
        yes|without-password) bad+=("PermitRootLogin=$permit") ;;
    esac
    if [[ "$root_status" == "P" ]]; then
        bad+=("root account has password (status=$root_status)")
    fi

    if [[ ${#bad[@]} -gt 0 ]]; then
        findings=$((findings + 1))
        printf "  ! %s (%s@%s): %s\n" "$name" "$user" "$ip" "$(IFS='; '; echo "${bad[*]}")"
    else
        printf "  ✓ %s (%s@%s): PermitRootLogin=%s root-status=%s\n" \
            "$name" "$user" "$ip" "$permit" "$root_status"
    fi
done <<< "$hosts"

echo ""
if [[ "$checked" -eq 0 ]]; then
    echo "audit: no managed hosts found"
elif [[ "$findings" -gt 0 ]]; then
    echo "audit: $findings host(s) flagged as unsafe; see warnings above"
else
    echo "audit: all $checked managed host(s) clean"
fi
REMOTE
)

    local ssh_opts
    mapfile -t ssh_opts < <(ssh_base_opts)

    printf "%s==>%s audit-targets\n" "$color_blue" "$color_reset"
    printf "remote:  %s:%s\n" "$target" "$MEDUSA_CONTROLLER_PORT"
    printf "log:    %s\n" "$log"

    if ssh "${ssh_opts[@]}" "$target" "bash -s" <<< "$remote" 2>&1 | tee "$log"; then
        printf "%s✓%s audit-targets\n" "$color_green" "$color_reset"
        return 0
    else
        printf "%s!%s audit-targets reported issues (log: %s)\n" \
            "$color_yellow" "$color_reset" "$log" >&2
        return 0
    fi
}

inventory_pull_cmd() {
    # T-037 stage D: prepended to every controller-side workflow so the
    # controller's inventory clone fast-forwards to whatever the
    # workstation has just pushed. Operator runs 'medusactl push' before
    # 'medusactl deploy'; the deploy guards verify the push happened.
    printf 'git -C %q pull --ff-only && ' "$MEDUSA_CONTROLLER_INVENTORY_PATH"
}

require_clean_for_deploy() {
    # T-037 stage D: deploy refuses if the workstation inventory clone
    # is dirty, ahead of origin/main (forgot to push), or behind
    # origin/main (forgot to pull a co-worker's commit). The git remote
    # is the authoritative source of truth; this guard makes the local
    # clone tell us when it isn't synchronized.
    require_local_inventory_dir
    local porcelain ahead behind
    porcelain=$(git -C "$MEDUSACTL_INVENTORY_DIR" status --porcelain 2>/dev/null)
    [[ -z "$porcelain" ]] \
        || fail "deploy: workstation inventory has uncommitted changes; commit/push or discard before deploying"
    git -C "$MEDUSACTL_INVENTORY_DIR" fetch --quiet origin 2>/dev/null || true
    if git -C "$MEDUSACTL_INVENTORY_DIR" rev-parse --verify --quiet origin/main >/dev/null; then
        ahead=$(git -C "$MEDUSACTL_INVENTORY_DIR" rev-list --count origin/main..HEAD 2>/dev/null || echo 0)
        behind=$(git -C "$MEDUSACTL_INVENTORY_DIR" rev-list --count HEAD..origin/main 2>/dev/null || echo 0)
        [[ "$ahead" -eq 0 ]] \
            || fail "deploy: workstation is $ahead commit(s) ahead of origin/main; run 'medusactl push' first"
        [[ "$behind" -eq 0 ]] \
            || fail "deploy: workstation is $behind commit(s) behind origin/main; run 'git -C \"$MEDUSACTL_INVENTORY_DIR\" pull --ff-only' first"
    else
        warn "no origin/main upstream; deploy guard cannot verify push status"
    fi
}

cmd_render() {
    load_config
    run_logged render "$(inventory_pull_cmd)uv run medusa render"
}

cmd_deploy() {
    load_config
    require_clean_for_deploy
    if [[ "${1:-}" == "--check" ]]; then
        run_logged deploy-check \
            "$(inventory_pull_cmd)uv run medusa render && cd ansible && uv run ansible-playbook playbooks/controller-apply.yml --check --diff && uv run ansible-playbook playbooks/deploy.yml --check --diff"
    else
        require_controller_apply_prereqs deploy \
            || fail "deploy prerequisites failed"
        # controller-apply BEFORE deploy: controller-apply rewrites
        # /etc/hosts (bootstrap_ip block) and ~/.ssh/config aliases on
        # the controller. Both feed hostname-based SSH that deploy.yml
        # uses to reach targets. If a host's bootstrap_ip changed and
        # we ran deploy first, ansible would resolve through stale
        # /etc/hosts and fail with 'No route to host', short-circuiting
        # controller-apply via '&&'.
        run_logged deploy \
            "$(inventory_pull_cmd)uv run medusa render && cd ansible && uv run ansible-playbook playbooks/controller-apply.yml && uv run ansible-playbook playbooks/deploy.yml"
    fi
}

cmd_controller_apply() {
    load_config
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        cat <<EOF
medusactl controller-apply — apply controller-side bootstrap blocks.

Usage:
  medusactl controller-apply [--check]

Runs ansible/playbooks/controller-apply.yml on the controller. This applies the
generated /etc/hosts bootstrap block and controller ~/.ssh/config aliases.
EOF
        return 0
    fi

    if [[ "${1:-}" == "--check" ]]; then
        shift
        [[ $# -eq 0 ]] || fail "unknown argument to controller-apply: $1"
        require_controller_apply_prereqs controller-apply-check \
            || fail "controller-apply check prerequisites failed"
        run_logged controller-apply-check "$(inventory_pull_cmd)cd ansible && uv run ansible-playbook playbooks/controller-apply.yml --check --diff"
    else
        [[ $# -eq 0 ]] || fail "unknown argument to controller-apply: $1"
        require_controller_apply_prereqs controller-apply \
            || fail "controller-apply prerequisites failed"
        run_logged controller-apply "$(inventory_pull_cmd)cd ansible && uv run ansible-playbook playbooks/controller-apply.yml"
    fi
}

cmd_finalize_dns() {
    load_config
    local resolver="" check=0 force=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --resolver)
                shift
                [[ $# -gt 0 ]] || fail "--resolver requires an IP argument"
                resolver=$1
                ;;
            --resolver=*)
                resolver=${1#--resolver=}
                ;;
            --check)
                check=1
                ;;
            --force)
                force=1
                ;;
            *)
                fail "unknown argument to finalize-dns: $1"
                ;;
        esac
        shift
    done

    require_controller_apply_prereqs finalize-dns \
        || fail "finalize-dns prerequisites failed"

    # Build the remote script. It reads /etc/hosts on the controller, finds
    # the bootstrap marker block, validates each entry against the resolver
    # (unless --force), then lets the controller_bootstrap role remove the
    # block through the same privileged path used for apply.
    local remote
    remote=$(cat <<'REMOTE'
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
# T-037 stage D: fast-forward the inventory clone first so renders +
# applies use whatever the workstation has just pushed.
git -C "$MEDUSA_INVENTORY_ROOT" pull --ff-only
cd "$MEDUSA_CONTROLLER_PATH"
RESOLVER=${RESOLVER:-}
CHECK=${CHECK:-0}
FORCE=${FORCE:-0}
BEGIN='# BEGIN MEDUSA BOOTSTRAP (managed by medusa; remove with '"'"'medusactl finalize-dns'"'"')'
END='# END MEDUSA BOOTSTRAP'

if grep -qxF "$BEGIN" /etc/hosts; then
    block=$(sed -n "/^${BEGIN//\//\\/}\$/,/^${END//\//\\/}\$/p" /etc/hosts \
        | sed -e "1d" -e "\$d")
else
    echo "no medusa bootstrap block in /etc/hosts; applying absent state anyway"
    block=""
fi

if [[ -z "$block" ]]; then
    echo "bootstrap block is empty; removing markers only"
fi

if [[ "$FORCE" -ne 1 && -n "$block" ]]; then
    if [[ -z "$RESOLVER" ]]; then
        if command -v resolvectl >/dev/null 2>&1; then
            RESOLVER=$(resolvectl status 2>/dev/null \
                | awk "/Current DNS Server/ {print \$NF; exit}")
        fi
        if [[ -z "$RESOLVER" ]]; then
            RESOLVER=$(awk "/^nameserver/ {print \$2; exit}" /etc/resolv.conf)
        fi
        if [[ -z "$RESOLVER" ]]; then
            echo "could not auto-detect resolver; pass --resolver" >&2
            exit 2
        fi
    fi
    if ! command -v dig >/dev/null 2>&1; then
        echo "dig is required for finalize-dns validation; install dnsutils or use --force" >&2
        exit 3
    fi

    echo "validating against resolver: $RESOLVER"
    fail_count=0
    while read -r ip host name; do
        [[ -z "$ip" ]] && continue
        got=$(dig @"$RESOLVER" +short +time=2 +tries=1 "$host" A | head -n1)
        if [[ -z "$got" ]]; then
            echo "  ✗ $host -> NXDOMAIN (expected $ip)" >&2
            fail_count=$((fail_count + 1))
        elif [[ "$got" != "$ip" ]]; then
            echo "  ✗ $host -> $got (expected $ip)" >&2
            fail_count=$((fail_count + 1))
        else
            echo "  ✓ $host -> $got"
        fi
    done <<< "$block"

    if [[ "$fail_count" -ne 0 ]]; then
        echo "validation failed for $fail_count entries; leaving /etc/hosts unchanged" >&2
        echo "fix the resolver or pass --force to remove the block anyway" >&2
        exit 4
    fi
fi

if [[ "$CHECK" -eq 1 ]]; then
    cd ansible
    uv run ansible-playbook playbooks/controller-apply.yml \
        --check --diff \
        --extra-vars controller_bootstrap_state=absent
else
    cd ansible
    uv run ansible-playbook playbooks/controller-apply.yml \
        --extra-vars controller_bootstrap_state=absent
fi
REMOTE
)

    local target ssh_opts log
    target=$(ssh_target)
    log=$(log_path "finalize-dns")
    mapfile -t ssh_opts < <(ssh_base_opts)

    printf "%s==>%s finalize-dns\n" "$color_blue" "$color_reset"
    printf "remote:  %s:%s\n" "$target" "$MEDUSA_CONTROLLER_PORT"
    printf "log:    %s\n" "$log"

    local env_prefix
    env_prefix=$(printf "MEDUSA_CONTROLLER_PATH=%q MEDUSA_INVENTORY_ROOT=%q MEDUSA_INVENTORY_DIR=%q MEDUSA_SECRETS_DIR=%q MEDUSA_GENERATED_DIR=%q RESOLVER=%q CHECK=%q FORCE=%q" \
        "$MEDUSA_CONTROLLER_PATH" \
        "$MEDUSA_CONTROLLER_INVENTORY_PATH" \
        "$MEDUSA_CONTROLLER_INVENTORY_PATH/inventory" \
        "$MEDUSA_CONTROLLER_INVENTORY_PATH/secrets" \
        "$MEDUSA_CONTROLLER_GENERATED_PATH" \
        "$resolver" "$check" "$force")

    local finalize_rc=0
    ssh -t "${ssh_opts[@]}" "$target" "$env_prefix bash -s" <<< "$remote" 2>&1 | tee "$log" \
        || finalize_rc=${PIPESTATUS[0]}
    sanitize_log "$log"
    if [[ "$finalize_rc" -eq 0 ]]; then
        printf "%s✓%s finalize-dns\n" "$color_green" "$color_reset"
    else
        printf "%s✗%s finalize-dns failed (log: %s)\n" "$color_red" "$color_reset" "$log" >&2
        return 1
    fi
}

# --- Target ops -------------------------------------------------------------
#
# All target subcommands run the relevant 'medusa' Python CLI commands on the
# controller (single source of truth for inventory edits) and, when the edit
# changed state, apply the regenerated bootstrap blocks through the
# controller_bootstrap Ansible role.

_run_local_mutation() {
    # T-037 stage B: run a medusa inventory mutation (add-host,
    # remove-host, promote-host) on the workstation against
    # MEDUSACTL_INVENTORY_DIR. No SSH, no auto-render, no auto-apply —
    # the operator reviews via status/diff and commits/pushes/deploys
    # explicitly afterward.
    local pre_script=$1 name=$2 mode=${3:-apply} log rc=0
    require_local_inventory_dir
    log=$(log_path "$name")

    printf "%s==>%s %s (local)\n" "$color_blue" "$color_reset" "$name"
    printf "inventory: %s\n" "$MEDUSACTL_INVENTORY_DIR"
    printf "log:       %s\n" "$log"

    (
        cd "$MEDUSACTL_INVENTORY_DIR"
        export MEDUSA_INVENTORY_DIR="$MEDUSACTL_INVENTORY_DIR/inventory"
        export MEDUSA_SECRETS_DIR="$MEDUSACTL_INVENTORY_DIR/secrets"
        eval "$pre_script"
    ) 2>&1 | tee "$log" || rc=${PIPESTATUS[0]}
    sanitize_log "$log"

    if [[ "$rc" -ne 0 ]]; then
        printf "%s✗%s %s (log: %s)\n" "$color_red" "$color_reset" "$name" "$log" >&2
        return 1
    fi
    printf "%s✓%s %s\n" "$color_green" "$color_reset" "$name"
    if [[ "$mode" != "dry-run" ]]; then
        cat <<EOF >&2

next steps:
  medusactl status        # review pending changes
  medusactl diff          # see exact YAML diff
  medusactl commit "msg"  # commit the change locally
  medusactl push          # publish to origin/main
  medusactl deploy        # apply on the controller
EOF
    fi
    return 0
}

_run_remote_with_render_and_apply() {
    # Compose: <pre-block bash> + medusa render + apply blocks.
    # $1 is the bash snippet to run BEFORE render (typically a medusa
    # add-host or remove-host call). Echoes the full output and returns
    # the SSH exit code via PIPESTATUS handling.
    #
    # When the third argument is "dry-run", the render + apply tail is
    # omitted: the pre-script is expected to validate without writing,
    # and there is nothing to deploy.
    local pre_script=$1 name=$2 mode=${3:-apply} log target install_rc=0
    target=$(ssh_target)
    log=$(log_path "$name")

    if [[ "$mode" != "dry-run" ]]; then
        require_controller_apply_prereqs "$name" \
            || return 1
    fi

    local tail=""
    if [[ "$mode" != "dry-run" ]]; then
        tail="uv run medusa render
cd ansible
uv run ansible-playbook playbooks/controller-apply.yml"
    fi

    local full_script
    full_script=$(cat <<REMOTE
set -euo pipefail
export PATH="\$HOME/.local/bin:\$PATH"
export MEDUSA_CONTROLLER_PATH=$(printf %q "$MEDUSA_CONTROLLER_PATH")
export MEDUSA_INVENTORY_ROOT=$(printf %q "$MEDUSA_CONTROLLER_INVENTORY_PATH")
export MEDUSA_INVENTORY_DIR=$(printf %q "$MEDUSA_CONTROLLER_INVENTORY_PATH/inventory")
export MEDUSA_SECRETS_DIR=$(printf %q "$MEDUSA_CONTROLLER_INVENTORY_PATH/secrets")
export MEDUSA_GENERATED_DIR=$(printf %q "$MEDUSA_CONTROLLER_GENERATED_PATH")
cd "\$MEDUSA_CONTROLLER_PATH"
${pre_script}
${tail}
REMOTE
)

    local ssh_opts
    mapfile -t ssh_opts < <(ssh_base_opts)

    printf "%s==>%s %s\n" "$color_blue" "$color_reset" "$name"
    printf "remote:  %s:%s\n" "$target" "$MEDUSA_CONTROLLER_PORT"
    printf "log:    %s\n" "$log"

    ssh -t "${ssh_opts[@]}" "$target" "bash -s" <<< "$full_script" 2>&1 | tee "$log" \
        || install_rc=${PIPESTATUS[0]}
    sanitize_log "$log"
    stty sane 2>/dev/null || true
    (printf '\033[0m' >/dev/tty) 2>/dev/null || true
    if [[ "$install_rc" -eq 0 ]]; then
        printf "%s✓%s %s\n" "$color_green" "$color_reset" "$name"
        return 0
    fi
    printf "%s✗%s %s (log: %s)\n" "$color_red" "$color_reset" "$name" "$log" >&2
    return 1
}

cmd_add_target() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        cat <<EOF
medusactl add-target — append a host to inventory/dns.yaml and apply blocks.

Usage:
  medusactl add-target <name> --ip <ip> [--bootstrap-ip <addr>]
                       [--zone <zone>] [--user <user>]
                       [--alias <alias> ...] [--group <group> ...]
                       [--prep] [--seed] [--authorize] [--no-seed-hosts]
                       [--force] [--dry-run] [--interactive]

Interactive mode:
  Invoking 'medusactl add-target <name>' with no other flags on a TTY,
  or passing '--interactive' explicitly, drops into a prompt session
  that collects --ip, --bootstrap-ip, --user, --zone, mode, the
  post-add side-effect flags (--prep if full, --seed if limited,
  --authorize), and --no-seed-hosts. Each prompt shows a default in
  [brackets] and accepts the default on bare Enter. A summary block
  with Y/n confirmation is printed before any write. Non-TTY callers
  still fail fast on missing --ip — scripted contracts are preserved.
  --alias and --group are flag-only; pass them on the command line
  alongside the host name to seed interactive mode.

Flags:
  --ip <ip>              Required. IPv4 (or IPv6) address.
  --zone <zone>          DNS zone. Defaults to 'lan'. Repeat for multiple.
  --user <user>          ansible user. Defaults to 'ansible'. Marks host
                         as managed.
  --alias <alias>        DNS alias. Repeat for multiple.
  --group <group>        Ansible inventory group. Repeat for multiple.
  --limited              Mark host as 'limited' managed mode (baremetal /
                         pre-existing). Disables prep-target and root-SSH
                         hardening audit for this host. Without this flag
                         the host defaults to 'limited' anyway; passing
                         --full is required to opt into the destructive
                         template-prep flow.
  --full                 Mark host as 'full' managed mode. Required to
                         allow prep-target + hardening audit. Mutually
                         exclusive with --limited.
  --prep                 After add, run prep-debian.sh against the target
                         via root SSH (prompts for shared root password).
                         Mode-aware: on --full hosts runs general prep
                         + hardening (sshd clamp + root lock); on
                         --limited hosts runs general prep only (no
                         destructive sshd or root edits). Defaults to
                         --full when --limited is not also passed.
  --seed                 After add, run seed-target against the target
                         (limited mode only): minimal ssh-copy-id +
                         /etc/sudoers.d/<user> NOPASSWD fragment, no
                         apt install. Use when the ansible user
                         already exists on the target. For hosts where
                         the ansible user does not exist yet, use
                         --prep --limited instead. Mutually exclusive
                         with --prep / --full.
  --authorize            After add (and prep/seed, if requested), run
                         ssh-copy-id from controller to target (prompts
                         for target user's SSH password). Redundant
                         with --seed, which already authorizes the key.
  --no-seed-hosts        Skip applying the /etc/hosts bootstrap block.
                         Use when local DNS already serves the name.
  --force                Replace an existing host of the same name.
  --bootstrap-ip <addr>  Temporary cutover address for the controller's
                         /etc/hosts bootstrap block; clear with
                         'medusactl promote-target' once DNS is live.
                         Must differ from --ip.
  --dry-run              Run medusa add-host --dry-run on the controller:
                         validate the proposed edit and print a unified
                         diff of inventory/dns.yaml; do not write, do not
                         render, do not apply. Incompatible with --prep
                         and --authorize.

Examples:
  medusactl add-target host01 --ip 10.0.0.10
  medusactl add-target host01 --ip 10.0.0.10 --dry-run
  medusactl add-target host02 --ip 10.0.0.11 --prep --authorize
  medusactl add-target dns --ip 10.0.0.250 --alias coredns --group coredns_hosts

Exit codes: 0 success, non-zero on any failure.
EOF
        return 0
    fi

    load_config
    local name=${1:-}
    if [[ -z "$name" ]]; then
        fail "add-target: name argument is required"
    fi
    if [[ "$name" == --* ]]; then
        fail "add-target: name argument is required (got flag '$name')"
    fi
    shift

    local original_flag_count=$#
    local ip="" bootstrap_ip="" user="ansible" force=0 prep=0 authorize=0 dry_run=0
    local interactive=0 no_seed_hosts=0 seed=0
    local mode=""  # "", "full", or "limited"
    local -a zones=() aliases=() groups=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --ip) shift; ip=$1 ;;
            --bootstrap-ip) shift; bootstrap_ip=$1 ;;
            --zone) shift; zones+=("$1") ;;
            --user) shift; user=$1 ;;
            --alias) shift; aliases+=("$1") ;;
            --group) shift; groups+=("$1") ;;
            --limited) mode="limited" ;;
            --full) mode="full" ;;
            --force) force=1 ;;
            --prep) prep=1 ;;
            --authorize) authorize=1 ;;
            --seed) seed=1 ;;
            --dry-run) dry_run=1 ;;
            --interactive) interactive=1 ;;
            --no-seed-hosts) no_seed_hosts=1 ;; # accepted for future toggling; render always emits
            *) fail "add-target: unknown flag '$1'" ;;
        esac
        shift
    done

    if [[ "$seed" -eq 1 && "$prep" -eq 1 ]]; then
        fail "add-target: --seed and --prep are mutually exclusive (seed is limited-mode, prep is full-mode)"
    fi
    if [[ "$seed" -eq 1 && "$mode" == "full" ]]; then
        fail "add-target: --seed cannot be combined with --full (seed is for limited-mode hosts only)"
    fi

    # Interactive mode: explicit --interactive, or bare 'add-target <name>'
    # on a TTY. Non-TTY callers fall through to the existing fail-fast on
    # missing --ip so scripted contracts stay intact.
    if [[ "$interactive" -eq 1 || "$original_flag_count" -eq 0 ]] && [[ -t 0 ]]; then
        info ""
        info "Interactive add-target for '$name'. Enter accepts the [default]."
        info ""
        [[ -z "$ip" ]] && prompt ip "IPv4 address"
        [[ -z "$ip" ]] && fail "add-target: --ip is required"
        [[ -z "$bootstrap_ip" ]] && prompt bootstrap_ip "Bootstrap IP (controller /etc/hosts cutover, blank to skip)" ""
        prompt user "ansible user" "$user"
        if [[ ${#zones[@]} -eq 0 ]]; then
            local zone_input
            prompt zone_input "DNS zone" "lan"
            zones=("$zone_input")
        fi
        if [[ -z "$mode" ]]; then
            local mode_input
            prompt mode_input "Managed mode (limited/full)" "limited"
            case "$mode_input" in
                limited|full) mode=$mode_input ;;
                *) fail "add-target: invalid mode '$mode_input' (expected 'limited' or 'full')" ;;
            esac
        fi
        if [[ "$prep" -eq 0 && "$seed" -eq 0 ]]; then
            local prep_q
            if [[ "$mode" == "full" ]]; then
                prep_q="Run prep-target after add (general prep + hardening: sshd clamp + root lock)"
            else
                prep_q="Run prep-target after add (general prep only on limited mode; no sshd or root touch)"
            fi
            confirm "$prep_q" "n" && prep=1
        fi
        if [[ "$mode" == "limited" && "$prep" -eq 0 && "$seed" -eq 0 ]]; then
            confirm "Or run seed-target instead (minimal: key + sudoers only, no apt; requires user to already exist)" "n" && seed=1
        fi
        if [[ "$authorize" -eq 0 && "$prep" -eq 0 && "$seed" -eq 0 ]]; then
            confirm "Run authorize-target after add (ssh-copy-id only)" "n" && authorize=1
        fi
        if [[ "$no_seed_hosts" -eq 0 ]]; then
            confirm "Skip /etc/hosts bootstrap block (--no-seed-hosts)" "n" && no_seed_hosts=1
        fi

        info ""
        info "About to add target:"
        info "  name:         $name"
        info "  ip:           $ip"
        info "  bootstrap-ip: ${bootstrap_ip:-<none>}"
        info "  user:         $user"
        info "  zones:        ${zones[*]}"
        [[ ${#aliases[@]} -gt 0 ]] && info "  aliases:      ${aliases[*]}"
        [[ ${#groups[@]}  -gt 0 ]] && info "  groups:       ${groups[*]}"
        info "  mode:         $mode"
        info "  prep:         $([[ $prep -eq 1 ]] && echo yes || echo no)"
        info "  seed:         $([[ $seed -eq 1 ]] && echo yes || echo no)"
        info "  authorize:    $([[ $authorize -eq 1 ]] && echo yes || echo no)"
        info "  no-seed-hosts:$([[ $no_seed_hosts -eq 1 ]] && echo " yes" || echo " no")"
        info "  force:        $([[ $force -eq 1 ]] && echo yes || echo no)"
        info "  dry-run:      $([[ $dry_run -eq 1 ]] && echo yes || echo no)"
        info ""
        confirm "Proceed" "y" || fail "add-target: aborted by user"
    fi

    if [[ "$dry_run" -eq 1 ]]; then
        if [[ "$prep" -eq 1 || "$authorize" -eq 1 ]]; then
            fail "add-target: --dry-run cannot be combined with --prep or --authorize"
        fi
    fi

    [[ -n "$ip" ]] || fail "add-target: --ip is required"
    if [[ ${#zones[@]} -eq 0 ]]; then
        zones=(lan)
    fi

    # T-043: --prep now works on both modes. On 'full' hosts (default
    # when --prep is passed without --limited) prep-debian runs with
    # MEDUSA_PREP_HARDEN=1 (sshd clamp + root-password lock). On
    # 'limited' hosts prep-debian runs with MEDUSA_PREP_HARDEN=0 —
    # general prep only, no destructive sshd or root edits. Picking
    # the mode is the operator's call; --prep no longer flips it.
    if [[ "$prep" -eq 1 && -z "$mode" ]]; then
        mode="full"
    fi

    # Build the medusa add-host argument list.
    local args
    args=$(printf "%q " add-host "$name" --ip "$ip" --ansible-user "$user")
    local z; for z in "${zones[@]}"; do args+=$(printf "%q " --zone "$z"); done
    local a; for a in "${aliases[@]}"; do args+=$(printf "%q " --alias "$a"); done
    local g; for g in "${groups[@]}"; do args+=$(printf "%q " --ansible-group "$g"); done
    [[ -n "$mode" ]] && args+=$(printf "%q " --managed-mode "$mode")
    [[ -n "$bootstrap_ip" ]] && args+=$(printf "%q " --bootstrap-ip "$bootstrap_ip")
    [[ "$force" -eq 1 ]] && args+="--force "
    [[ "$dry_run" -eq 1 ]] && args+="--dry-run "

    local pre="medusa ${args}"
    local run_mode="apply"
    [[ "$dry_run" -eq 1 ]] && run_mode="dry-run"
    _run_local_mutation "$pre" "add-target-$name" "$run_mode" \
        || fail "add-target failed"

    if [[ "$dry_run" -eq 1 ]]; then
        return 0
    fi

    if [[ "$prep" -eq 1 ]]; then
        cmd_prep_target "$name" || fail "add-target: prep-target failed"
    fi
    if [[ "$seed" -eq 1 ]]; then
        cmd_seed_target "$name" || fail "add-target: seed-target failed"
    fi
    if [[ "$authorize" -eq 1 ]]; then
        cmd_authorize_target "$name" || fail "add-target: authorize-target failed"
    fi
}

cmd_remove_target() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        cat <<EOF
medusactl remove-target — strip a host from inventory/dns.yaml, re-render,
                          and clean controller-side /etc/hosts / ~/.ssh/config.

Usage:
  medusactl remove-target <name> [--dry-run]
                          [--remove-mounts] [--remove-exports]
                          [--remove-services] [--cascade]

Flags:
  --dry-run              Run medusa remove-host --dry-run on the
                         controller: validate the proposed edit and
                         print a unified diff; do not write, do not
                         render, do not apply.
  --remove-mounts        Also drop the host from every storage mount
                         host list. Mounts whose host list empties are
                         removed.
  --remove-exports       Also remove every storage export served by
                         this host.
  --remove-services      Also remove every service entry whose host is
                         this host.
  --cascade              Imply --remove-mounts, --remove-exports, and
                         --remove-services.

Exit codes: 0 success (even if host was not present), non-zero on failure.
EOF
        return 0
    fi
    load_config
    local name=${1:-}
    [[ -n "$name" ]] || fail "remove-target: name argument is required"
    if [[ "$name" == --* ]]; then
        fail "remove-target: name argument is required (got flag '$name')"
    fi
    shift
    local dry_run=0
    local -a forwarded=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run) dry_run=1 ;;
            --remove-mounts|--remove-exports|--remove-services|--cascade)
                forwarded+=("$1")
                ;;
            *) fail "remove-target: unknown flag '$1'" ;;
        esac
        shift
    done
    local pre run_mode="apply"
    local extra=""
    local flag
    for flag in "${forwarded[@]:-}"; do
        [[ -n "$flag" ]] || continue
        extra+=$(printf " %q" "$flag")
    done
    if [[ "$dry_run" -eq 1 ]]; then
        pre=$(printf "medusa remove-host %q --dry-run" "$name")${extra}
        run_mode="dry-run"
    else
        pre=$(printf "medusa remove-host %q" "$name")${extra}
    fi
    _run_local_mutation "$pre" "remove-target-$name" "$run_mode" \
        || fail "remove-target failed"
}

