cmd_repin_target() {
    load_config
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" || -z "${1:-}" ]]; then
        cat <<EOF
medusactl repin-target — refresh the controller's pinned SSH host key after a
target is reinstalled.

Usage:
  medusactl repin-target <name> [--ip <addr>]

A reinstalled target (nixos-anywhere, a re-imaged VM) presents a new SSH host
key, and every controller-side flow then aborts with 'REMOTE HOST
IDENTIFICATION HAS CHANGED'. This scrubs the stale known_hosts entries on the
controller (<name>, <name>.lan, and the IP), re-pins the target's current
ed25519 key via ssh-keyscan, and prints the key + fingerprint. Verify the
fingerprint out-of-band (the target's console) when the reinstall was not
your own doing. --ip skips the DNS lookup -- required when repinning the DNS
host itself.
EOF
        return 0
    fi
    local host=$1; shift
    local ip=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --ip) shift; [[ -n "${1:-}" ]] || fail "repin-target: --ip requires an address"; ip=$1; shift ;;
            --ip=*) ip=${1#--ip=}; [[ -n "$ip" ]] || fail "repin-target: --ip requires an address"; shift ;;
            *) fail "unknown argument to repin-target: $1" ;;
        esac
    done

    local remote
    remote=$(cat <<'REMOTE'
set -euo pipefail
name="$REPIN_NAME"
ip="$REPIN_IP"
if [ -z "$ip" ]; then
    ip=$(getent hosts "${name}.lan" | awk '{print $1; exit}') || true
fi
for h in "$name" "${name}.lan" $ip; do
    ssh-keygen -f "$HOME/.ssh/known_hosts" -R "$h" >/dev/null 2>&1 || true
done
scan_host="${ip:-${name}.lan}"
key=$(ssh-keyscan -T 5 -t ed25519 "$scan_host" 2>/dev/null | awk '{print $2" "$3; exit}')
if [ -z "$key" ]; then
    echo "repin-target: no ed25519 key from $scan_host (host down? wrong --ip?)" >&2
    exit 1
fi
{
    printf '%s %s\n' "${name}.lan" "$key"
    printf '%s %s\n' "$name" "$key"
    if [ -n "$ip" ]; then
        printf '%s %s\n' "$ip" "$key"
    fi
} >> "$HOME/.ssh/known_hosts"
echo "pinned: ${name}, ${name}.lan${ip:+, $ip}"
echo "key:    $key"
printf '%s %s\n' "$scan_host" "$key" | ssh-keygen -lf - | sed 's/^/sha256: /'
REMOTE
)
    local target
    local -a ssh_opts
    target=$(ssh_target)
    mapfile -t ssh_opts < <(ssh_base_opts)
    printf "%s==>%s repin-target %s\n" "$color_blue" "$color_reset" "$host"
    ssh "${ssh_opts[@]}" "$target" \
        "REPIN_NAME=$(printf %q "$host") REPIN_IP=$(printf %q "$ip") bash -s" <<< "$remote"
}

cmd_authorize_target() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        cat <<EOF
medusactl authorize-target — ssh-copy-id from controller to an existing target.

Usage:
  medusactl authorize-target <name>

Prompts for the target user's SSH password. Adds the controller's public
key to the target user's ~/.ssh/authorized_keys via ssh-copy-id. Useful
for pre-baked targets that already have the user but lack the key, and
for key rotation.
EOF
        return 0
    fi
    load_config
    local name=${1:-}
    [[ -n "$name" ]] || fail "authorize-target: name argument is required"

    local password
    read -r -s -p "SSH password for ${name} target user: " password </dev/tty
    printf "\n" >&2

    local target ssh_opts
    target=$(ssh_target)
    mapfile -t ssh_opts < <(ssh_base_opts)

    local remote
    remote=$(cat <<REMOTE
set -euo pipefail
cd "$MEDUSA_CONTROLLER_PATH"
host=\$(getent hosts ${name} | awk '{print \$1}' | head -n1) || true
if [[ -z "\$host" ]]; then
    echo "  could not resolve ${name}; trying name as-is" >&2
    host="${name}"
fi
# Look up user from medusa list-hosts.
line=\$(uv run medusa list-hosts --managed-only | grep -E "^[FL][[:space:]]+${name}[[:space:]]" | head -n1) || true
user=\$(awk '{for(i=1;i<=NF;i++) if(\$i~/^user=/){sub(/^user=/,"",\$i); print \$i}}' <<< "\$line")
[[ -z "\$user" ]] && user=ansible
echo "  authorizing key on \${user}@${name} (\${host})"
if ! command -v sshpass >/dev/null 2>&1; then
    sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq sshpass
fi
SSHPASS=$(printf %q "$password") sshpass -e ssh-copy-id \\
    -o StrictHostKeyChecking=accept-new \\
    -o ConnectTimeout=10 \\
    -o PreferredAuthentications=password \\
    -o PubkeyAuthentication=no \\
    -i ~/.ssh/id_ed25519.pub "\${user}@${name}"
REMOTE
)

    local log install_rc=0
    log=$(log_path "authorize-target-$name")
    printf "%s==>%s authorize-target %s\n" "$color_blue" "$color_reset" "$name"
    printf "log:    %s\n" "$log"
    ssh -t "${ssh_opts[@]}" "$target" "bash -s" <<< "$remote" 2>&1 | tee "$log" \
        || install_rc=${PIPESTATUS[0]}
    sanitize_log "$log"
    stty sane 2>/dev/null || true
    (printf '\033[0m' >/dev/tty) 2>/dev/null || true
    if [[ "$install_rc" -eq 0 ]]; then
        printf "%s✓%s authorize-target %s\n" "$color_green" "$color_reset" "$name"
        return 0
    fi
    printf "%s✗%s authorize-target %s failed (log: %s)\n" "$color_red" "$color_reset" "$name" "$log" >&2
    return 1
}

cmd_seed_target() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        cat <<EOF
medusactl seed-target — non-destructive limited-mode onboarding.

Usage:
  medusactl seed-target <name>

Pushes the controller's SSH key to the target user and drops a
/etc/sudoers.d/<user> NOPASSWD fragment, so ansible plays can run
against a pre-existing host without manual sudoers/sshd tinkering.

Pre-condition (operator-owned):
  The target user (the host's 'ansible_user') already exists on the
  target and is in a sudo-capable group. seed-target does NOT create
  users.

What it does:
  - ssh-copy-id controller pubkey → <user>@<target> (sshpass-driven
    one-shot password auth, then key auth from this point on).
  - Install /etc/sudoers.d/<user> with '<user> ALL=(ALL) NOPASSWD: ALL',
    mode 0440, validated via 'visudo -cf'.
  - Verify 'sudo -n true' succeeds afterwards.

What it does NOT do:
  - No apt installs. No sshd edits. No PermitRootLogin clamp. No
    'passwd -l root'. No user creation. Those are owned by the
    operator.

Modes:
  - LIMITED hosts only. Refuses FULL and refuses DNS-only hosts
    (no ansible_user).

Prompts once for the target user's SSH password. The same password
is used for the initial 'sudo -S' to install the sudoers fragment;
in standard Debian/Ubuntu setups these are identical. Re-running
seed-target on an already-seeded host is a safe no-op.
EOF
        return 0
    fi
    load_config
    local name=${1:-}
    [[ -n "$name" ]] || fail "seed-target: name argument is required"

    local password
    read -r -s -p "SSH password for ${name} target user (also used for first sudo): " password </dev/tty
    printf "\n" >&2

    local target ssh_opts
    target=$(ssh_target)
    mapfile -t ssh_opts < <(ssh_base_opts)

    # Resolve mode + ip + user from LOCAL inventory (T-037 pattern):
    # a freshly-added limited host visible only on the workstation can
    # still be seeded before the operator pushes + deploys.
    require_local_inventory_dir
    local lookup
    lookup=$( cd "$MEDUSACTL_INVENTORY_DIR" \
        && MEDUSA_INVENTORY_DIR="$MEDUSACTL_INVENTORY_DIR/inventory" \
           MEDUSA_SECRETS_DIR="$MEDUSACTL_INVENTORY_DIR/secrets" \
           medusa list-hosts --managed-only 2>&1 ) \
        || fail "seed-target: could not list managed hosts locally"

    local line mode ip user
    line=$(grep -E "^[FL][[:space:]]+${name}[[:space:]]" <<< "$lookup" | head -n1) || true
    if [[ -z "$line" ]]; then
        fail "seed-target: $name is not in the managed host list. DNS-only hosts have no ansible_user — set one with 'medusactl add-target' first."
    fi
    mode=$(awk '{print $1}' <<< "$line")
    if [[ "$mode" == "F" ]]; then
        fail "seed-target: $name is in 'full' managed mode; seed-target is for pre-existing (limited) hosts only."
    fi
    ip=$(awk '{print $3}' <<< "$line")
    user=$(awk '{for(i=1;i<=NF;i++) if($i~/^user=/){sub(/^user=/,"",$i); print $i}}' <<< "$line")
    [[ -z "$user" ]] && user="ansible"
    [[ -n "$ip" ]] || fail "seed-target: could not determine IP for $name"

    # Validate username early — it's interpolated into the sudoers
    # filename and the fragment content. Refuse anything sudoers
    # would choke on.
    if ! [[ "$user" =~ ^[a-z_][a-z0-9_-]*$ ]]; then
        fail "seed-target: refusing unsafe username '$user' (must match ^[a-z_][a-z0-9_-]*\$)"
    fi

    # seed-target is a fresh-host path by contract; a changed host key is
    # expected, so strip stale controller known_hosts entries.
    local kh_clean_script
    kh_clean_script=$(printf 'for h in %q %q %q; do ssh-keygen -f ~/.ssh/known_hosts -R "$h" >/dev/null 2>&1 || true; done' \
        "$name" "${name}.lan" "$ip")
    ssh "${ssh_opts[@]}" "$target" "bash -c $(printf %q "$kh_clean_script")" >/dev/null 2>&1 || true

    local remote
    remote=$(cat <<REMOTE
set -euo pipefail
cd "\$HOME"
if ! command -v sshpass >/dev/null 2>&1; then
    sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq sshpass
fi

USER_NAME=$(printf %q "$user")
# Hostname target (not ip) so controller /etc/hosts bootstrap_ip
# override routes the connection when in cutover phase. Falls
# through to DNS when bootstrap_ip is unset.
TARGET_HOST=$(printf %q "$name")
PASSWORD=$(printf %q "$password")

echo "  authorizing controller key on \${USER_NAME}@\${TARGET_HOST}"
SSHPASS="\$PASSWORD" sshpass -e ssh-copy-id \\
    -o StrictHostKeyChecking=accept-new \\
    -o ConnectTimeout=10 \\
    -o PreferredAuthentications=password \\
    -o PubkeyAuthentication=no \\
    -i ~/.ssh/id_ed25519.pub "\${USER_NAME}@\${TARGET_HOST}"

echo "  staging sudoers fragment (key auth)"
printf '%s ALL=(ALL) NOPASSWD: ALL\n' "\$USER_NAME" \\
    | ssh -o StrictHostKeyChecking=accept-new \\
          -o ConnectTimeout=10 \\
          "\${USER_NAME}@\${TARGET_HOST}" \\
          'cat > /tmp/medusa-sudoers.frag'

echo "  installing /etc/sudoers.d/\${USER_NAME} via sudo -S"
printf '%s\n' "\$PASSWORD" \\
    | ssh -o StrictHostKeyChecking=accept-new \\
          -o ConnectTimeout=10 \\
          "\${USER_NAME}@\${TARGET_HOST}" \\
          "sudo -S -p '' install -m 0440 -o root -g root /tmp/medusa-sudoers.frag /etc/sudoers.d/\${USER_NAME} && sudo -n visudo -cf /etc/sudoers.d/\${USER_NAME} && rm -f /tmp/medusa-sudoers.frag"

echo "  verifying passwordless sudo"
ssh -o BatchMode=yes -o ConnectTimeout=5 "\${USER_NAME}@\${TARGET_HOST}" 'sudo -n true' \\
    && echo "  ok: 'sudo -n true' succeeded on \${USER_NAME}@\${TARGET_HOST}"
REMOTE
)

    local log install_rc=0
    log=$(log_path "seed-target-$name")
    printf "%s==>%s seed-target %s (%s)\n" "$color_blue" "$color_reset" "$name" "$ip"
    printf "log:    %s\n" "$log"
    ssh -t "${ssh_opts[@]}" "$target" "bash -s" <<< "$remote" 2>&1 | tee "$log" \
        || install_rc=${PIPESTATUS[0]}
    sanitize_log "$log"
    stty sane 2>/dev/null || true
    (printf '\033[0m' >/dev/tty) 2>/dev/null || true
    if [[ "$install_rc" -eq 0 ]]; then
        printf "%s✓%s seed-target %s\n" "$color_green" "$color_reset" "$name"
        return 0
    fi
    printf "%s✗%s seed-target %s failed (log: %s)\n" "$color_red" "$color_reset" "$name" "$log" >&2
    return 1
}

cmd_add_targets_from_file() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        cat <<EOF
medusactl add-targets-from-file — bulk-add targets from a file.

Usage:
  medusactl add-targets-from-file <path>

File format: one target per line.
  <name> <ip> [zone] [user] [group1,group2,...]

Blank lines and lines starting with '#' are ignored. Defaults: zone=lan,
user=ansible. Equivalent to running 'medusactl add-target <name>
--ip <ip>' for each line.

Does not run --seed or --authorize automatically; run those per-target
afterwards if needed.
EOF
        return 0
    fi
    load_config
    local file=${1:-}
    [[ -n "$file" ]] || fail "add-targets-from-file: path required"
    [[ -f "$file" ]] || fail "add-targets-from-file: file not found: $file"

    local lineno=0 line name ip zone user groups
    while IFS= read -r line || [[ -n "$line" ]]; do
        lineno=$((lineno + 1))
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" ]] && continue
        read -r name ip zone user groups <<< "$line"
        [[ -z "$name" || -z "$ip" ]] && fail "line $lineno: name and ip required"
        [[ -z "$zone" ]] && zone="lan"
        [[ -z "$user" ]] && user="ansible"

        local -a flags=(--ip "$ip" --zone "$zone" --user "$user")
        if [[ -n "$groups" ]]; then
            local g
            IFS=',' read -ra grp_array <<< "$groups"
            for g in "${grp_array[@]}"; do
                flags+=(--group "$g")
            done
        fi
        info "line $lineno: add-target $name (${flags[*]})"
        cmd_add_target "$name" "${flags[@]}" \
            || fail "add-targets-from-file: failed at line $lineno ($name)"
    done < "$file"
}

cmd_update() {
    load_config
    # Pull both repos. Code first (because uv sync runs there); inventory
    # second so any new schema additions land before the next render.
    # uv.lock is restored before the pull: uv sync rewrites it whenever a
    # release ships a lock that drifted from pyproject.toml, and the dirty
    # file then blocks --ff-only forever. The controller checkout is a pure
    # consumer — local changes there are never legitimate.
    run_logged update "$(cat <<EOF
set -e
echo '==> code: restore uv.lock'
git -C $(printf %q "$MEDUSA_CONTROLLER_PATH") checkout -- uv.lock
echo '==> code: git pull'
git -C $(printf %q "$MEDUSA_CONTROLLER_PATH") pull --ff-only
echo '==> inventory: git pull'
git -C $(printf %q "$MEDUSA_CONTROLLER_INVENTORY_PATH") pull --ff-only
echo '==> uv sync'
uv sync --quiet
echo '==> ansible-galaxy'
uv run --quiet ansible-galaxy collection install -r ansible/requirements.yml
EOF
)"
}

cmd_install_runtime() {
    # T-037 stage A: the local medusa runtime backs the local mutation
    # commands (add-target, status, diff, etc).
    command -v uv >/dev/null 2>&1 \
        || fail "uv is not installed; see https://docs.astral.sh/uv/ first"
    local source_url="git+https://github.com/${MEDUSA_GITHUB_REPO}.git@${MEDUSA_INSTALL_REF}"
    info "Installing medusa runtime from $source_url"
    uv tool install --force "$source_url" \
        || fail "uv tool install failed"
    printf "%s✓%s medusa runtime installed; check: medusa --help\n" \
        "$color_green" "$color_reset"
}

cmd_self_update() {
    local skip_python=0
    for arg in "$@"; do
        case "$arg" in
            --no-python) skip_python=1 ;;
            -h|--help)
                cat <<EOF
medusactl self-update — refresh the workstation install.

Usage:
  medusactl self-update [--no-python]

Updates two things by default:
  1. The medusactl bash helper (this script) from the public Medusa
     main branch.
  2. The 'medusa' Python package, when installed via 'uv tool'.
     Required for workstation-side inventory mutations like
     'medusactl add-target' (which call 'medusa add-host' locally
     against MEDUSACTL_INVENTORY_DIR).

Flags:
  --no-python  Skip the 'uv tool upgrade medusa' step. Use when the
               medusa package is managed some other way (system pip,
               local editable install, etc).

Note: 'medusactl update' is the separate command that pulls the
controller's checkout (medusa + ansible + inventory) on the
controller host. self-update is workstation-side only.
EOF
                return 0
                ;;
            *) fail "self-update: unknown flag '$arg'" ;;
        esac
    done

    local source destination destination_dir installed tmp_destination

    installed=$(command -v medusactl || true)
    if [[ -n "$installed" && -f "$installed" ]]; then
        destination="$installed"
    else
        destination="$HOME/.local/bin/medusactl"
    fi
    destination_dir=$(dirname "$destination")

    source=$(medusactl_source)
    bash -n "$source" || fail "downloaded medusactl failed shell syntax validation"

    mkdir -p "$destination_dir" || fail "failed to create $destination_dir"
    if [[ -e "$destination" && ! -w "$destination" ]]; then
        fail "$destination is not writable; update it manually or choose a user-writable install path"
    fi

    tmp_destination=$(mktemp "${destination_dir}/.medusactl.XXXXXX") \
        || fail "failed to create temporary file in $destination_dir"
    TEMP_FILES+=("$tmp_destination")
    cp "$source" "$tmp_destination" || fail "failed to stage update at $tmp_destination"
    chmod 0755 "$tmp_destination" || fail "failed to mark $tmp_destination executable"
    mv -f "$tmp_destination" "$destination" || fail "failed to update $destination"
    printf "%s✓%s medusactl updated at %s\n" "$color_green" "$color_reset" "$destination"
    refresh_installed_completions

    # T-037: inventory mutations run on the workstation, so a stale local
    # 'medusa' silently misses controller-shipped fixes — upgrade it when
    # managed via uv tool.
    if [[ "$skip_python" -eq 1 ]]; then
        info "skipping 'medusa' Python upgrade (--no-python)"
        return 0
    fi
    if ! command -v uv >/dev/null 2>&1; then
        info "uv not found in PATH; skipping 'medusa' Python upgrade (install uv or use --no-python to silence)"
        return 0
    fi
    if ! uv tool list 2>/dev/null | grep -q '^medusa\b'; then
        info "'medusa' not installed via uv tool; skipping Python upgrade"
        info "  (install once with: uv tool install --from git+https://github.com/MichelAguilera/Medusa.git medusa)"
        return 0
    fi
    info "upgrading 'medusa' Python package via uv tool..."
    if uv tool upgrade medusa >/dev/null 2>&1; then
        printf "%s✓%s medusa Python package upgraded\n" "$color_green" "$color_reset"
    else
        # 'uv tool upgrade' is a no-op if the source has no newer ref.
        # Reinstall from main to force-pick up commits that aren't
        # version-tagged. Idempotent: same SHA -> same install.
        info "  uv tool upgrade reported no change; reinstalling from main to pick up untagged commits"
        if uv tool install --reinstall --from \
                git+https://github.com/MichelAguilera/Medusa.git medusa >/dev/null 2>&1; then
            printf "%s✓%s medusa Python package reinstalled from main\n" "$color_green" "$color_reset"
        else
            warn "  could not refresh medusa Python package via uv tool; run 'uv tool install --reinstall --from git+https://github.com/MichelAguilera/Medusa.git medusa' manually"
        fi
    fi
}

