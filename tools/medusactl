cmd_completion() {
    local shell=${1:-} action=${2:-}
    case "$shell" in
        bash)
            if [[ "$action" == "install" ]]; then
                cmd_completion_install bash
                return
            fi
            completion_bash
            ;;
        zsh)
            if [[ "$action" == "install" ]]; then
                cmd_completion_install zsh
                return
            fi
            completion_zsh
            ;;
        fish)
            if [[ "$action" == "install" ]]; then
                cmd_completion_install fish
                return
            fi
            completion_fish
            ;;
        install)
            cmd_completion_install
            ;;
        *)
            fail "usage: medusactl completion <bash|zsh|fish> [install]"
            ;;
    esac
    [[ -z "$action" ]] || fail "usage: medusactl completion <bash|zsh|fish> [install]"
}

cmd_completion_install() {
    local shell_name destination
    shell_name=${1:-$(basename "${SHELL:-}")}
    case "$shell_name" in
        bash)
            destination="${XDG_DATA_HOME:-$HOME/.local/share}/bash-completion/completions/medusactl"
            mkdir -p "$(dirname "$destination")"
            completion_bash > "$destination"
            ;;
        zsh)
            destination="${ZDOTDIR:-$HOME}/.zfunc/_medusactl"
            mkdir -p "$(dirname "$destination")"
            completion_zsh > "$destination"
            warn "ensure '${ZDOTDIR:-$HOME}/.zfunc' is in fpath before compinit"
            ;;
        fish)
            destination="${XDG_CONFIG_HOME:-$HOME/.config}/fish/completions/medusactl.fish"
            mkdir -p "$(dirname "$destination")"
            completion_fish > "$destination"
            ;;
        *)
            fail "cannot infer shell from SHELL=${SHELL:-}; use 'medusactl completion bash|zsh|fish'"
            ;;
    esac
    printf "%s✓%s installed completion at %s\n" "$color_green" "$color_reset" "$destination"
    if [[ "$shell_name" == "bash" ]]; then
        info "Reload in this shell with: complete -r medusactl 2>/dev/null; source $destination"
    elif [[ "$shell_name" == "zsh" ]]; then
        info "Reload zsh completions by starting a new shell or running compinit again."
    elif [[ "$shell_name" == "fish" ]]; then
        info "Fish should pick this up automatically in new completions."
    fi
}

refresh_installed_completions() {
    local refreshed=0
    local bash_path="${XDG_DATA_HOME:-$HOME/.local/share}/bash-completion/completions/medusactl"
    local zsh_path="${ZDOTDIR:-$HOME}/.zfunc/_medusactl"
    local fish_path="${XDG_CONFIG_HOME:-$HOME/.config}/fish/completions/medusactl.fish"

    if [[ -f "$bash_path" && -w "$bash_path" ]]; then
        completion_bash > "$bash_path"
        info "Refreshed bash completion at $bash_path"
        refreshed=1
    fi
    if [[ -f "$zsh_path" && -w "$zsh_path" ]]; then
        completion_zsh > "$zsh_path"
        info "Refreshed zsh completion at $zsh_path"
        refreshed=1
    fi
    if [[ -f "$fish_path" && -w "$fish_path" ]]; then
        completion_fish > "$fish_path"
        info "Refreshed fish completion at $fish_path"
        refreshed=1
    fi

    if [[ "$refreshed" -eq 1 ]]; then
        info "Restart your shell or reload its completion function to use new completions."
    fi
}

known_state_paths() {
    printf "%s\n" \
        "$CONFIG_FILE" \
        "$CONFIG_DIR/controller.env" \
        "$LOG_DIR" \
        "$SSH_MUX_DIR" \
        "${XDG_DATA_HOME:-$HOME/.local/share}/bash-completion/completions/medusactl" \
        "${XDG_DATA_HOME:-$HOME/.local/share}/bash-completion/completions/medusa-controller" \
        "${ZDOTDIR:-$HOME}/.zfunc/_medusactl" \
        "${ZDOTDIR:-$HOME}/.zfunc/_medusa-controller" \
        "${XDG_CONFIG_HOME:-$HOME/.config}/fish/completions/medusactl.fish" \
        "${XDG_CONFIG_HOME:-$HOME/.config}/fish/completions/medusa-controller.fish"
}

known_binary_paths() {
    local installed
    printf "%s\n" \
        "$HOME/.local/bin/medusactl" \
        "$HOME/.local/bin/medusa-controller"
    installed=$(command -v medusactl || true)
    if [[ -n "$installed" && -f "$installed" && "$installed" != "./"* && "$installed" != "../"* ]]; then
        printf "%s\n" "$installed"
    fi
}

remove_paths() {
    local path removed=0 worktree
    worktree=$(pwd -P)
    while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        [[ -e "$path" || -L "$path" ]] || continue
        if [[ "$path" == "$worktree" || "$path" == "$worktree/"* ]]; then
            warn "skipping working tree path: $path"
            continue
        fi
        if ! home_path "$path"; then
            warn "skipping non-home path: $path"
            continue
        fi
        rm -rf "$path"
        printf "removed %s\n" "$path"
        removed=1
    done
    [[ "$removed" -eq 1 ]] || info "Nothing to remove."
}

cmd_clean() {
    if ! confirm "Remove medusactl local config, logs, completions, and legacy controller CLI traces" "n"; then
        fail "aborted by user"
    fi
    cmd_ssh_disconnect --quiet || true
    known_state_paths | sort -u | remove_paths
}

cmd_undo() {
    # T-037 stage E: 'undo' is reimplemented as 'git revert HEAD' against
    # the workstation inventory clone. The pre-T-037 XDG snapshot store
    # is on the way out (T-038); git history is now the source of
    # undo-able state.
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        cat <<EOF
medusactl undo — revert the most recent inventory commit (git revert HEAD).

Usage:
  medusactl undo [--dry-run]

Operates on MEDUSACTL_INVENTORY_DIR. With --dry-run, shows the would-be
revert commit (git show HEAD) without writing. Without --dry-run, creates
a new revert commit; review with 'medusactl diff' / 'status', then
'push' + 'deploy' to propagate.
EOF
        return 0
    fi
    load_config
    require_local_inventory_dir
    local dry_run=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run) dry_run=1 ;;
            *) fail "undo: unknown flag '$1'" ;;
        esac
        shift
    done

    local porcelain
    porcelain=$(git -C "$MEDUSACTL_INVENTORY_DIR" status --porcelain 2>/dev/null)
    [[ -z "$porcelain" ]] \
        || fail "undo: working tree is dirty; commit or discard before reverting"

    if [[ "$dry_run" -eq 1 ]]; then
        printf "%s==>%s undo --dry-run: HEAD commit that would be reverted\n" \
            "$color_blue" "$color_reset"
        git -C "$MEDUSACTL_INVENTORY_DIR" show --stat HEAD
        return 0
    fi
    printf "%s==>%s git revert HEAD in %s\n" \
        "$color_blue" "$color_reset" "$MEDUSACTL_INVENTORY_DIR"
    git -C "$MEDUSACTL_INVENTORY_DIR" revert --no-edit HEAD \
        || fail "undo: git revert failed"
    printf "%s✓%s undo (revert committed locally; push + deploy to propagate)\n" \
        "$color_green" "$color_reset"
}

cmd_history() {
    # T-038: replaces the pre-T-038 'list-backups' command. The XDG
    # snapshot store is gone; git is the inventory audit trail.
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        cat <<EOF
medusactl history — show recent inventory commits.

Usage:
  medusactl history [-n <N>] [-- <extra git-log args>]
EOF
        return 0
    fi
    load_config
    require_local_inventory_dir
    local limit=20
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -n|--limit)
                shift
                [[ $# -gt 0 ]] || fail "history: -n requires a number"
                limit=$1
                ;;
            --) shift; break ;;
            *) break ;;
        esac
        shift
    done
    git -C "$MEDUSACTL_INVENTORY_DIR" log --oneline -n "$limit" "$@"
}

cmd_ssh_disconnect() {
    local target quiet=0
    if [[ "${1:-}" == "--quiet" ]]; then
        quiet=1
    fi
    load_config
    target=$(ssh_target)
    if [[ -n "$SSH_CONFIG" ]]; then
        [[ "$quiet" -eq 1 ]] || info "MEDUSACTL_SSH_CONFIG is set; ssh-disconnect is a no-op"
        return 0
    fi
    if [[ ! -d "$SSH_MUX_DIR" ]]; then
        [[ "$quiet" -eq 1 ]] || info "no persistent SSH master to close"
        return 0
    fi
    local -a ssh_opts
    mapfile -t ssh_opts < <(ssh_base_opts)
    if ssh "${ssh_opts[@]}" -O check "$target" >/dev/null 2>&1; then
        ssh "${ssh_opts[@]}" -O exit "$target" >/dev/null 2>&1 || true
        [[ "$quiet" -eq 1 ]] || printf "%s✓%s closed SSH master to %s\n" "$color_green" "$color_reset" "$target"
    else
        [[ "$quiet" -eq 1 ]] || info "no live SSH master to $target"
    fi
    find "$SSH_MUX_DIR" -maxdepth 1 -type s -name 'cp-*' -delete 2>/dev/null || true
}

cmd_uninstall() {
    if ! confirm "Remove medusactl local state, completions, legacy traces, and installed binaries" "n"; then
        fail "aborted by user"
    fi
    {
        known_state_paths
        known_binary_paths
    } | sort -u | remove_paths
}

TEMP_FILES=()
cleanup() {
    local file
    for file in "${TEMP_FILES[@]:-}"; do
        rm -f "$file"
    done
    if [[ -n "${SSH_TARGET:-}" && -n "${CONTROL_PATH:-}" && -S "$CONTROL_PATH" ]]; then
        ssh -O exit -o ControlPath="$CONTROL_PATH" "$SSH_TARGET" >/dev/null 2>&1 || true
    fi
    if [[ -n "${CONTROL_DIR:-}" ]]; then
        rm -rf "$CONTROL_DIR"
    fi
}
trap cleanup EXIT

