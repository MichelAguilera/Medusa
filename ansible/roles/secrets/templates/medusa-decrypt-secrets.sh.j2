#!/usr/bin/env bash
# Generated by Medusa (T-080) -- do not edit on the host.
#
# Decrypts THIS host's secrets to tmpfs using the host's own ssh host key
# (ssh-to-age). Invoked by {{ medusa_secrets_unit_name }}.service before the
# consumers start, and re-run on every boot because tmpfs is wiped. The
# controller never sees plaintext; the age identity is derived in memory and
# never written out. Each secret is written to its declared owner: service
# secrets to the medusa runtime user, system secrets (e.g. the WireGuard config)
# to root.
set -euo pipefail

runtime_root="{{ medusa_secret_runtime_root }}"
enc_dir="{{ medusa_secrets_enc_dir }}"
host_key="{{ medusa_ssh_host_key }}"
ssh_to_age="{{ medusa_secrets_bin_dir }}/ssh-to-age"
sops="{{ medusa_secrets_bin_dir }}/sops"

umask 077

# Derive the age identity from the ssh host key; kept in memory only.
SOPS_AGE_KEY="$("$ssh_to_age" -private-key -i "$host_key")"
export SOPS_AGE_KEY

# Start from a clean tree: tmpfs is empty after a reboot, but a re-run on a live
# host must not leave a removed secret behind. Root-owned + traversable so each
# owner can reach its own 0600 leaf below.
rm -rf "$runtime_root"
install -d -o root -g root -m 0755 "$runtime_root"

# Decrypt the `value` field of an encrypted source to stdout.
decrypt_value() { # source path (relative to enc_dir)
  "$sops" --decrypt --extract '["value"]' "$enc_dir/$1"
}
{% set seen = namespace(dests=[]) %}
{% for entry in medusa_host_secret_entries | selectattr('mode', 'equalto', 'env') | list %}
{% if entry.destination not in seen.dests %}
{% set _ = seen.dests.append(entry.destination) %}
{% set owner = medusa_deploy_owner if entry.owner == 'service' else 'root' %}
{% set group = medusa_deploy_group if entry.owner == 'service' else 'root' %}

# env file (truncate; entries appended below)
install -d -o "{{ owner }}" -g "{{ group }}" -m 0700 "$runtime_root/{{ entry.destination | dirname }}"
install -o "{{ owner }}" -g "{{ group }}" -m 0600 /dev/null "$runtime_root/{{ entry.destination }}"
{% endif %}
{% endfor %}
{% for entry in medusa_host_secret_entries | selectattr('mode', 'equalto', 'env') | list %}
printf '%s=%s\n' '{{ entry.setting }}' "$(decrypt_value '{{ entry.source }}')" >> "$runtime_root/{{ entry.destination }}"
{% endfor %}
{% for entry in medusa_host_secret_entries | selectattr('mode', 'equalto', 'file') | list %}
{% set owner = medusa_deploy_owner if entry.owner == 'service' else 'root' %}
{% set group = medusa_deploy_group if entry.owner == 'service' else 'root' %}

# file-backed secret (owner: {{ entry.owner }})
install -d -o "{{ owner }}" -g "{{ group }}" -m 0700 "$runtime_root/{{ entry.destination | dirname }}"
install -o "{{ owner }}" -g "{{ group }}" -m 0600 /dev/null "$runtime_root/{{ entry.destination }}"
printf '%s\n' "$(decrypt_value '{{ entry.source }}')" > "$runtime_root/{{ entry.destination }}"
{% endfor %}
