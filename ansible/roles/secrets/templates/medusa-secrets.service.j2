# Generated by Medusa (T-080) -- do not edit on the host.
[Unit]
Description=Decrypt Medusa-managed secrets to tmpfs (host-side, ssh host key)
# The decrypt needs sshd's host key present and the network up (sops reads only
# local files, but ordering after sshd-keygen guarantees the key exists).
After=systemd-sysusers.service ssh.service
Wants=ssh.service
# Compose stacks read the decrypted secrets, so finish before Docker starts.
Before=docker.service
RequiresMountsFor={{ medusa_secret_runtime_root }}

[Service]
Type=oneshot
RemainAfterExit=yes
# Runs as root: it reads the root-only ssh host key and writes the decrypted
# output owned by {{ medusa_deploy_owner }} (the script does the chown via install).
ExecStart={{ medusa_secrets_script_path }}

[Install]
WantedBy=multi-user.target
